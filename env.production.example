# Переменные окружения для продакшена
# Скопируйте этот файл в .env на сервере и заполните значения

# Django настройки
SECRET_KEY=your-very-secret-key-here-change-this
DEBUG=False
DJANGO_SETTINGS_MODULE=tg_bot_admin.settings_production

# База данных PostgreSQL
DB_NAME=vpn_bot
DB_USER=vpn_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Telegram Bot
BOT_TOKEN=your-telegram-bot-token
ADMIN_IDS=123456789,987654321
SUPPORT_GROUP_ID=-1001234567890

# ЮKassa
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_WEBHOOK_URL=https://your-domain.com/bot_management/webhook/yookassa/

# Redis (для кэширования)
REDIS_URL=redis://127.0.0.1:6379/1

# Email настройки
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password

# HTTPS настройки
USE_HTTPS=True

# Веб-хуки
WEBHOOK_URL=https://your-domain.com/webhook/
WEBHOOK_SECRET=your-webhook-secret

# Видео настройки
VIDEO_FILE_ID=your-video-file-id
VIDEO_URL=https://your-domain.com/video/
VIDEO_POST_URL=https://t.me/your-channel/123

# Операторы
OPERATORS=МТС, Билайн, Tele2, Yota

