"""

    keyboard = []
    if not trial_used:
        keyboard.append([InlineKeyboardButton(text="рџЋЃ FREE РїСЂРѕР±РЅС‹Р№ РїРµСЂРёРѕРґ рџ”Ґ", callback_data="trial_key_info")])

    keyboard.extend([
        [InlineKeyboardButton(text="рџ’і РљСѓРїРёС‚СЊ РїРѕРґРїРёСЃРєСѓ", callback_data="catalog")],
        [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
    ])

    kb = InlineKeyboardMarkup(inline_keyboard=keyboard)
    await send_or_edit_message_with_photo(callback, menu_text, reply_markup=kb, edit_message=True, image_name="catalog.png")


