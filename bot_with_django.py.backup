@router.callback_query(F.data.startswith("key_detail:"))
async def show_key_detail(callback: CallbackQuery):
    """РџРѕРєР°Р·Р°С‚СЊ РґРµС‚Р°Р»СЊРЅСѓСЋ РёРЅС„РѕСЂРјР°С†РёСЋ Рѕ РєР»СЋС‡Рµ"""
    user_id = callback.from_user.id
    payment_id = int(callback.data.split(":")[1])
    
    if DJANGO_INTEGRATION:
        try:
            import aiohttp
            
            # Р—Р°РїСЂРѕСЃ Рє API РґР»СЏ РїРѕР»СѓС‡РµРЅРёСЏ РєР»СЋС‡РµР№ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ
            api_url = f'http://127.0.0.1:8123/bot_management/api/users/{user_id}/keys/'
            
            async with aiohttp.ClientSession() as session:
                async with session.get(api_url) as response:
                    if response.status == 200:
                        data = await response.json()
                        
                        if data.get('success') and data.get('keys'):
                            # РС‰РµРј РєР»СЋС‡ РїРѕ payment_id
                            key_data = None
                            for key in data['keys']:
                                if key.get('payment_id') == payment_id:
                                    key_data = key
                                    break
                            
                            if key_data:
                                key_value = key_data['key_value']
                                if key_data['subscription_type'] == 'trial':
                                    sub_type = "РџСЂРѕР±РЅР°СЏ (1 РґРµРЅСЊ)"
                                elif key_data['subscription_type'] == 'month':
                                    sub_type = "РњРµСЃСЏС‡РЅР°СЏ"
                                elif key_data['subscription_type'] == '3months':
                                    sub_type = "3 РјРµСЃСЏС†Р°"
                                elif key_data['subscription_type'] == '6months':
                                    sub_type = "6 РјРµСЃСЏС†РµРІ"
                                elif key_data['subscription_type'] == 'year':
                                    sub_type = "Р“РѕРґРѕРІР°СЏ"
                                else:
                                    sub_type = key_data['subscription_type']
                                used = key_data['used_activations']
                                total = key_data['total_activations']
                                is_active = key_data['is_active']
                                issued_by_manager = key_data.get('issued_by_manager', False)
                                pending_manager = key_data.get('pending_manager', False)
                                
                                # Р¤РѕСЂРјР°С‚РёСЂСѓРµРј РґР°С‚Сѓ РїРѕРєСѓРїРєРё
                                from datetime import datetime
                                try:
                                    purchase_date = datetime.fromisoformat(key_data['created_at'].replace('Z', '+00:00'))
                                    formatted_date = purchase_date.strftime('%d.%m.%Y %H:%M')
                                except:
                                    formatted_date = "РќРµРёР·РІРµСЃС‚РЅРѕ"
                                
                                # Р¤РѕСЂРјРёСЂСѓРµРј С‚РµРєСЃС‚ СЃ РёРЅС„РѕСЂРјР°С†РёРµР№ Рѕ РєР»СЋС‡Рµ
                                key_detail_text = "рџ”‘ <b>РРЅС„РѕСЂРјР°С†РёСЏ Рѕ РєР»СЋС‡Рµ</b>\n\n"
                                
                                if pending_manager:
                                    key_detail_text += "вЏі <b>РћР¶РёРґР°РµС‚ РІС‹РґР°С‡Рё РјРµРЅРµРґР¶РµСЂРѕРј</b>\n\n"
                                    key_detail_text += f"рџ“… <b>РўРёРї РїРѕРґРїРёСЃРєРё:</b> {sub_type}\n"
                                    key_detail_text += f"рџ“† <b>Р”Р°С‚Р° РїРѕРєСѓРїРєРё:</b> {formatted_date}\n"
                                    key_detail_text += f"рџ’¬ <b>РћР±СЂР°С‚РёС‚РµСЃСЊ Рє РјРµРЅРµРґР¶РµСЂСѓ:</b> @yamalube61\n"
                                elif issued_by_manager and key_value.startswith("Р’С‹РґР°РЅ РјРµРЅРµРґР¶РµСЂРѕРј"):
                                    key_detail_text += "рџ‘¤ <b>Р”Р»СЏ РїРѕР»СѓС‡РµРЅРёСЏ РєР»СЋС‡Р° РѕР±СЂР°С‚РёС‚РµСЃСЊ Рє РјРµРЅРµРґР¶РµСЂСѓрџ§‘вЂЌрџ’ј@yamalube61</b>"
                                    key_detail_text += f"рџ’¬ <b>РР·РІРёРЅРёС‚Рµ Р·Р° РЅРµСѓРґРѕР±СЃС‚РІР° рџћ</b>\n"
                                    key_detail_text += f"рџ“… <b>РўРёРї РїРѕРґРїРёСЃРєРё:</b> {sub_type}\n"
                                    key_detail_text += f"рџ“† <b>Р”Р°С‚Р° РїРѕРєСѓРїРєРё:</b> {formatted_date}\n"
                                elif issued_by_manager:
                                    key_detail_text += f"рџ”‘ <b>РљР»СЋС‡:</b> {key_value}\n\n"
                                    key_detail_text += f"рџ“… <b>РўРёРї РїРѕРґРїРёСЃРєРё:</b> {sub_type}\n"
                                    key_detail_text += f"рџ“† <b>Р”Р°С‚Р° РїРѕРєСѓРїРєРё:</b> {formatted_date}\n"
                                    key_detail_text += f"рџ‘¤ <b>Р’С‹РґР°РЅ РјРµРЅРµРґР¶РµСЂРѕРј</b>\n"
                                else:
                                    key_detail_text += f"рџ”‘ <b>РљР»СЋС‡:</b> {key_value}\n\n"
                                    key_detail_text += f"рџ“… <b>РўРёРї РїРѕРґРїРёСЃРєРё:</b> {sub_type}\n"
                                    key_detail_text += f"рџ“† <b>Р”Р°С‚Р° РїРѕРєСѓРїРєРё:</b> {formatted_date}\n"
                                
                                key_detail_text += "\nрџ’Ў <b>РљР°Рє РёСЃРїРѕР»СЊР·РѕРІР°С‚СЊ:</b>\n"
                                key_detail_text += "вЂў РЎРєРѕРїРёСЂСѓР№С‚Рµ РєР»СЋС‡ Рё РІРІРµРґРёС‚Рµ РІ РїСЂРёР»РѕР¶РµРЅРёРё\n"
                                key_detail_text += "вЂў РљР»СЋС‡ РјРѕР¶РЅРѕ РёСЃРїРѕР»СЊР·РѕРІР°С‚СЊ РЅРµСЃРєРѕР»СЊРєРѕ СЂР°Р·\n"
                                key_detail_text += "вЂў РџСЂРё РїСЂРѕР±Р»РµРјР°С… РѕР±СЂР°С‰Р°Р№С‚РµСЃСЊ РІ РїРѕРґРґРµСЂР¶РєСѓ"
                                
                                kb = InlineKeyboardMarkup(inline_keyboard=[
