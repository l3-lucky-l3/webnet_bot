                        result = await response.json()
                        if result.get('success'):
                            logging.info(f"Р’РѕР·РІСЂР°С‚ {amount} в‚Ѕ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ {user_id}: {reason}")
                            return True
