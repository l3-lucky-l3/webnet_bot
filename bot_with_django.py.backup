@router.callback_query(F.data.startswith("retry_payment:"))
async def retry_payment_handler(callback: CallbackQuery):
    """РћР±СЂР°Р±РѕС‚С‡РёРє РєРЅРѕРїРєРё 'РЎРѕР·РґР°С‚СЊ РЅРѕРІС‹Р№ РїР»Р°С‚РµР¶' РёР· РЅР°РїРѕРјРёРЅР°РЅРёСЏ Рѕ РЅРµР·Р°РІРµСЂС€РµРЅРЅРѕРј РїР»Р°С‚РµР¶Рµ"""
    user_id = callback.from_user.id

    try:
        # РџРѕР»СѓС‡Р°РµРј С‚РёРї РїРѕРґРїРёСЃРєРё РёР· callback_data
        subscription_type = callback.data.replace("retry_payment:", "")

        # РџСЂРѕРІРµСЂСЏРµРј РєРѕСЂСЂРµРєС‚РЅРѕСЃС‚СЊ С‚РёРїР° РїРѕРґРїРёСЃРєРё
        if subscription_type not in ['trial', 'month', '3months', '6months', 'year']:
            await callback.answer("вќЊ РќРµРІРµСЂРЅС‹Р№ С‚РёРї РїРѕРґРїРёСЃРєРё", show_alert=True)
            return

        # РћРїСЂРµРґРµР»СЏРµРј РЅР°Р·РІР°РЅРёРµ РїРѕРґРїРёСЃРєРё
        sub_names = {
            'month': 'РњРµСЃСЏС‡РЅР°СЏ РїРѕРґРїРёСЃРєР°',
            '3months': 'РџРѕРґРїРёСЃРєР° РЅР° 3 РјРµСЃСЏС†Р°',
            '6months': 'РџРѕРґРїРёСЃРєР° РЅР° 6 РјРµСЃСЏС†РµРІ',
            'year': 'Р“РѕРґРѕРІР°СЏ РїРѕРґРїРёСЃРєР°'
        }
        sub_name = sub_names.get(subscription_type, 'РџРѕРґРїРёСЃРєР°')

        # РЎРѕР·РґР°РµРј РЅРѕРІС‹Р№ РїР»Р°С‚РµР¶
        text = f"""
рџ”„ <b>РЎРѕР·РґР°РЅРёРµ РЅРѕРІРѕРіРѕ РїР»Р°С‚РµР¶Р°</b>

рџ“… <b>РўРёРї РїРѕРґРїРёСЃРєРё:</b> {sub_name}

рџ’Ў <b>Р’С‹Р±РµСЂРёС‚Рµ СЃРїРѕСЃРѕР± РѕРїР»Р°С‚С‹:</b>

<i>Р’С‹Р±РµСЂРёС‚Рµ СѓРґРѕР±РЅС‹Р№ РґР»СЏ РІР°СЃ СЃРїРѕСЃРѕР± РѕРїР»Р°С‚С‹ РЅРёР¶Рµ в¬‡пёЏ</i>
"""

        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="рџ’і РћРїР»Р°С‚РёС‚СЊ РїРѕ РЎР‘Рџ", callback_data=f"pay_card_{subscription_type}")],
            [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
        ])

        try:
            await callback.message.edit_text(text, parse_mode="HTML", reply_markup=kb)
        except:
            await callback.message.answer(text, parse_mode="HTML", reply_markup=kb)

        await callback.answer("РЎРѕР·РґР°РµРј РЅРѕРІС‹Р№ РїР»Р°С‚РµР¶...")

    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РІ retry_payment_handler: {e}")
        await callback.answer("вќЊ РћС€РёР±РєР° СЃРѕР·РґР°РЅРёСЏ РїР»Р°С‚РµР¶Р°", show_alert=True)


async def main():
    # Р”РѕР±Р°РІРёРј Р°РґРјРёРЅРѕРІ РІ Р‘Р”
    with get_db() as conn:
        for aid in ADMIN_IDS:
            conn.execute("INSERT OR IGNORE INTO admin_users (admin_id) VALUES (?)", (aid,))

    # Р—Р°РїСѓСЃРєР°РµРј РїР»Р°РЅРёСЂРѕРІС‰РёРє СѓРІРµРґРѕРјР»РµРЅРёР№
    await start_notification_scheduler()

    # Р—Р°РїСѓСЃРєР°РµРј HTTP СЃРµСЂРІРµСЂ РґР»СЏ РїРѕР»СѓС‡РµРЅРёСЏ СѓРІРµРґРѕРјР»РµРЅРёР№ РѕС‚ Django
    await init_http_server()

    # РР·РѕР±СЂР°Р¶РµРЅРёСЏ Р±СѓРґСѓС‚ Р·Р°РіСЂСѓР¶Р°С‚СЊСЃСЏ РїРѕ С‚СЂРµР±РѕРІР°РЅРёСЋ
    logging.info("рџљЂ Р‘РѕС‚ РіРѕС‚РѕРІ Рє СЂР°Р±РѕС‚Рµ")
    logging.info("рџ”” РџР»Р°РЅРёСЂРѕРІС‰РёРє СѓРІРµРґРѕРјР»РµРЅРёР№ Р·Р°РїСѓС‰РµРЅ")

    try:
        # Р—Р°РїСѓСЃРє polling СЃ СѓР»СѓС‡С€РµРЅРЅС‹РјРё РЅР°СЃС‚СЂРѕР№РєР°РјРё РґР»СЏ СѓСЃС‚РѕР№С‡РёРІРѕСЃС‚Рё Рє DDoS
        await dp.start_polling(
            bot,
            allowed_updates=["message", "callback_query", "inline_query"],
            drop_pending_updates=True,  # РРіРЅРѕСЂРёСЂСѓРµРј СЃС‚Р°СЂС‹Рµ РѕР±РЅРѕРІР»РµРЅРёСЏ РїСЂРё Р·Р°РїСѓСЃРєРµ
            timeout=30,  # РўР°Р№РјР°СѓС‚ РґР»СЏ long polling (СЃРµРєСѓРЅРґС‹)
            relax=1.0,  # Р—Р°РґРµСЂР¶РєР° РјРµР¶РґСѓ Р·Р°РїСЂРѕСЃР°РјРё (СЃРµРєСѓРЅРґС‹)
            fast=True,  # РћРїС‚РёРјРёР·РёСЂРѕРІР°РЅРЅС‹Р№ СЂРµР¶РёРј
        )
    except KeyboardInterrupt:
        logging.info("РџРѕР»СѓС‡РµРЅ СЃРёРіРЅР°Р» РїСЂРµСЂС‹РІР°РЅРёСЏ...")
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° СЂР°Р±РѕС‚С‹ Р±РѕС‚Р°: {e}")
    finally:
        # РљРѕСЂСЂРµРєС‚РЅР°СЏ РѕСЃС‚Р°РЅРѕРІРєР° РїР»Р°РЅРёСЂРѕРІС‰РёРєР°
        await stop_notification_scheduler()
        logging.info("рџ”” РџР»Р°РЅРёСЂРѕРІС‰РёРє СѓРІРµРґРѕРјР»РµРЅРёР№ РѕСЃС‚Р°РЅРѕРІР»РµРЅ")

if __name__ == "__main__":
    asyncio.run(main())

