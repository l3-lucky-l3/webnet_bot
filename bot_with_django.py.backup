    support_text = """
рџ›  <b>РўРµС…РЅРёС‡РµСЃРєР°СЏ РїРѕРґРґРµСЂР¶РєР°</b>

рџ’¬ <b>РЎРІСЏР¶РёС‚РµСЃСЊ СЃ РЅР°С€РёРј РјРµРЅРµРґР¶РµСЂРѕРј:</b>

рџ“± РќР°РїРёС€РёС‚Рµ РЅР°Рј РІ Р»РёС‡РЅС‹Рµ СЃРѕРѕР±С‰РµРЅРёСЏ РґР»СЏ СЂРµС€РµРЅРёСЏ Р»СЋР±С‹С… РІРѕРїСЂРѕСЃРѕРІ:
