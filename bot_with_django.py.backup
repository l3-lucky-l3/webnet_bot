@router.callback_query(F.data == "get_trial_key")
async def get_trial_key(callback: CallbackQuery):
    """Р’С‹РґР°С‚СЊ РїСЂРѕР±РЅС‹Р№ РєР»СЋС‡ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ"""
    user_id = callback.from_user.id

    if DJANGO_INTEGRATION:
        try:
            import aiohttp
            api_url = f'http://127.0.0.1:8123/bot_management/api/user/{user_id}/issue_trial_key/'
            async with aiohttp.ClientSession() as session:
                async with session.post(api_url) as response:
                    if response.status == 200:
                        data = await response.json()
                        if data.get('success'):
                            issued_key = data.get('issued_key')

                            success_text = f"""вљ пёЏ <b>РџРѕР¶Р°Р»СѓР№СЃС‚Р°, СЃСЂР°Р·Сѓ РїРѕСЃР»Рµ РїРѕР»СѓС‡РµРЅРёСЏ:</b>

1. <b>РђРєС‚РёРІРёСЂСѓР№С‚Рµ</b> РµРіРѕ.
2. <b>РћР±СЏР·Р°С‚РµР»СЊРЅРѕ РїСЂРѕС‚РµСЃС‚РёСЂСѓР№С‚Рµ</b> РІСЃРµ РЅРµРѕР±С…РѕРґРёРјС‹Рµ С„СѓРЅРєС†РёРё.
3. <b>РЈР±РµРґРёС‚РµСЃСЊ</b>, С‡С‚Рѕ РІСЃС‘ СЂР°Р±РѕС‚Р°РµС‚ РєР°Рє РЅСѓР¶РЅРѕ!

рџ”‘ <b>Р’Р°С€ РїСЂРѕР±РЅС‹Р№ РєР»СЋС‡:</b> {issued_key}

рџ“… <b>Р”РµР№СЃС‚РІРёС‚РµР»РµРЅ РґРѕ:</b> {data.get('expires_at', 'РЅРµРёР·РІРµСЃС‚РЅРѕ')}

рџЋЇ <b>РРЅСЃС‚СЂСѓРєС†РёСЏ РїРѕ Р°РєС‚РёРІР°С†РёРё:</b>

1. РЎРєР°С‡Р°Р№С‚Рµ РїСЂРёР»РѕР¶РµРЅРёРµ <b>"v2RayTun"</b>
2. РћС‚РєСЂРѕР№С‚Рµ РїСЂРёР»РѕР¶РµРЅРёРµ
3. Р’ РїСЂР°РІРѕРј РІРµСЂС…РЅРµРј СѓРіР»Сѓ РЅР°Р¶РјРёС‚Рµ <b>"+"</b>
4. Р’С‹Р±РµСЂРёС‚Рµ <b>"Р”РѕР±Р°РІРёС‚СЊ РёР· Р±СѓС„РµСЂР°"</b>
