рџ“Ё <b>Р’Р°С€ РІРѕРїСЂРѕСЃ РїРµСЂРµРґР°РЅ Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂСѓ</b>

вЏ° <b>РћР¶РёРґР°Р№С‚Рµ РѕС‚РІРµС‚Р° РІ С‚РµС‡РµРЅРёРµ 15-30 РјРёРЅСѓС‚</b>

рџ’Ў <b>РџРѕРєР° Р¶РґРµС‚Рµ:</b>
вЂў РџСЂРѕРІРµСЂСЊС‚Рµ СЂР°Р·РґРµР» "Р§Р°СЃС‚Рѕ Р·Р°РґР°РІР°РµРјС‹Рµ РІРѕРїСЂРѕСЃС‹"
вЂў РЈР±РµРґРёС‚РµСЃСЊ, С‡С‚Рѕ РїСЂРѕР±Р»РµРјР° РЅРµ СЂРµС€Р°РµС‚СЃСЏ СЃР°РјРѕСЃС‚РѕСЏС‚РµР»СЊРЅРѕ

<i>РЎРїР°СЃРёР±Рѕ Р·Р° РѕР±СЂР°С‰РµРЅРёРµ! рџ™Џ</i>
    """, parse_mode="HTML")
    
    # РЈРІРµРґРѕРјР»РµРЅРёСЏ РІ РіСЂСѓРїРїСѓ СѓР¶Рµ РѕС‚РїСЂР°РІР»РµРЅС‹ РІС‹С€Рµ - РґСѓР±Р»РёСЂРѕРІР°РЅРёРµ СѓР±СЂР°РЅРѕ
    print(f"DEBUG: РЎРѕРѕР±С‰РµРЅРёРµ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ РѕР±СЂР°Р±РѕС‚Р°РЅРѕ, СЃР±СЂР°СЃС‹РІР°РµРј СЃРѕСЃС‚РѕСЏРЅРёРµ")
    await state.clear()

# РћР±СЂР°Р±РѕС‚С‡РёРєРё С‚РµРєСЃС‚РѕРІС‹С… СЃРѕРѕР±С‰РµРЅРёР№
@router.message(F.text == "РњРµРЅСЋ")
async def handle_menu_button(message: Message):
    """РћР±СЂР°Р±РѕС‚С‡РёРє РєРЅРѕРїРєРё РјРµРЅСЋ - РґРµР»Р°РµС‚ С‚Рѕ Р¶Рµ СЃР°РјРѕРµ, С‡С‚Рѕ Рё /start"""
    user = message.from_user
    
    # РџСЂРѕРІРµСЂСЏРµРј РїРѕРґРїРёСЃРєСѓ РЅР° РѕР±СЏР·Р°С‚РµР»СЊРЅС‹Р№ РєР°РЅР°Р»
    try:
        # РСЃРїРѕР»СЊР·СѓРµРј ID РєР°РЅР°Р»Р° (Р±РѕР»РµРµ РЅР°РґРµР¶РЅРѕ)
        channel_member = await bot.get_chat_member(REQUIRED_CHANNEL_ID, user.id)
        
        if channel_member:
            # РџСЂРѕРІРµСЂСЏРµРј, С‡С‚Рѕ РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ РїРѕРґРїРёСЃР°РЅ (member, administrator, creator)
            if channel_member.status not in ['member', 'administrator', 'creator']:
                # РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ РЅРµ РїРѕРґРїРёСЃР°РЅ
                channel_username = REQUIRED_CHANNEL.replace('@', '')
                kb = InlineKeyboardMarkup(inline_keyboard=[
                    [InlineKeyboardButton(text="рџ“ў РџРѕРґРїРёСЃР°С‚СЊСЃСЏ РЅР° РєР°РЅР°Р»", url=f"https://t.me/{channel_username}")],
                    [InlineKeyboardButton(text="рџ”„ РџСЂРѕРІРµСЂРёС‚СЊ РїРѕРґРїРёСЃРєСѓ", callback_data="check_subscription")]
                ])
                await message.answer(f"""
рџ”’ <b>РўСЂРµР±СѓРµС‚СЃСЏ РїРѕРґРїРёСЃРєР° РЅР° РєР°РЅР°Р»</b>

рџ“ў <b>Р”Р»СЏ РёСЃРїРѕР»СЊР·РѕРІР°РЅРёСЏ Р±РѕС‚Р° РЅРµРѕР±С…РѕРґРёРјРѕ РїРѕРґРїРёСЃР°С‚СЊСЃСЏ РЅР° РЅР°С€ РєР°РЅР°Р»:</b>
рџ‘‰ {REQUIRED_CHANNEL}

вњ… <b>РџРѕСЃР»Рµ РїРѕРґРїРёСЃРєРё РЅР°Р¶РјРёС‚Рµ РєРЅРѕРїРєСѓ "РџСЂРѕРІРµСЂРёС‚СЊ РїРѕРґРїРёСЃРєСѓ"</b>

<i>Р­С‚Рѕ РЅРµРѕР±С…РѕРґРёРјРѕ РґР»СЏ РїРѕР»СѓС‡РµРЅРёСЏ Р°РєС‚СѓР°Р»СЊРЅС‹С… РЅРѕРІРѕСЃС‚РµР№ Рё РѕР±РЅРѕРІР»РµРЅРёР№</i>
""", parse_mode="HTML", reply_markup=kb)
                return
    except Exception as e:
        # Р•СЃР»Рё РѕС€РёР±РєР° РїСЂРѕРІРµСЂРєРё, РїСЂРѕРїСѓСЃРєР°РµРј РїСЂРѕРІРµСЂРєСѓ, РЅРѕ Р»РѕРіРёСЂСѓРµРј
        logging.warning(f"РћС€РёР±РєР° РїСЂРѕРІРµСЂРєРё РїРѕРґРїРёСЃРєРё РЅР° РєР°РЅР°Р» {REQUIRED_CHANNEL_ID}: {e}")
        logging.warning("РџСЂРѕРІРµСЂРєР° РїРѕРґРїРёСЃРєРё РїСЂРѕРїСѓС‰РµРЅР°. РЈР±РµРґРёС‚РµСЃСЊ, С‡С‚Рѕ Р±РѕС‚ СЏРІР»СЏРµС‚СЃСЏ Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂРѕРј РєР°РЅР°Р»Р°.")
    
    # РЈРІРµРґРѕРјР»СЏРµРј Django Рѕ РЅРѕРІРѕРј РїРѕР»СЊР·РѕРІР°С‚РµР»Рµ
    # Р’РђР–РќРћ: РџРµСЂРµРґР°РµРј РґР°РЅРЅС‹Рµ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ, РґР°Р¶Рµ РµСЃР»Рё РЅРµРєРѕС‚РѕСЂС‹Рµ РїРѕР»СЏ None
    if DJANGO_INTEGRATION:
        user_data = {
            'user_id': user.id,
