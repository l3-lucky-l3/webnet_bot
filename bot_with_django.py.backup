@router.callback_query(F.data.startswith("admin_referrers_list_page_"))
async def admin_referrers_list_handler(callback: CallbackQuery):
    """РћР±СЂР°Р±РѕС‚С‡РёРє СЃРїРёСЃРєР° СЂРµС„РµСЂРµСЂРѕРІ СЃ РїР°РіРёРЅР°С†РёРµР№ (РїРѕРґРґРµСЂР¶РєР° РїРѕРёСЃРєР° РІ callback_data)"""
    user_id = callback.from_user.id

    if not is_admin(user_id):
        await callback.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°", show_alert=True)
        return

    # Р¤РѕСЂРјР°С‚: admin_referrers_list_page_2 РёР»Рё admin_referrers_list_page_2_s_Р·Р°РїСЂРѕСЃ
    parts = callback.data.split("_")
    try:
        page_idx = parts.index("page")
        page = int(parts[page_idx + 1])
    except (ValueError, IndexError):
        page = 1
    search_query = ""
    if "_s_" in callback.data:
        try:
            # РїРѕСЃР»Рµ "page_N_s_" РёРґС‘С‚ РїРѕРёСЃРєРѕРІС‹Р№ Р·Р°РїСЂРѕСЃ
            search_query = callback.data.split("_s_", 1)[1].strip()
        except IndexError:
            pass

    await show_referrers_list(callback, page=page, search_query=search_query)
    await callback.answer()


@router.callback_query(F.data.startswith("admin_referrer_detail_"))
async def admin_referrer_detail_handler(callback: CallbackQuery):
    """РћР±СЂР°Р±РѕС‚С‡РёРє РґРµС‚Р°Р»СЊРЅРѕР№ СЃС‚Р°С‚РёСЃС‚РёРєРё СЂРµС„РµСЂР°Р»Р°"""
    user_id = callback.from_user.id
    
    if not is_admin(user_id):
        await callback.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°", show_alert=True)
        return
    
    if not DJANGO_INTEGRATION:
        await callback.answer("вќЊ РЎРёСЃС‚РµРјР° РЅРµРґРѕСЃС‚СѓРїРЅР°", show_alert=True)
        return
    
    try:
        referrer_id = int(callback.data.split("_")[-1])
        import aiohttp
        
        api_url = f'http://127.0.0.1:8123/bot_management/api/referrers/{referrer_id}/detail/'
        
        async with aiohttp.ClientSession() as session:
            async with session.get(api_url) as response:
                if response.status == 200:
                    data = await response.json()
                    if data.get('success'):
                        referrer = data.get('referrer', {})
                        stats = data.get('stats', {})
                        referrals = data.get('referrals', [])
                        
                        referrer_name = referrer.get('username') or referrer.get('first_name') or f"ID{referrer.get('user_id')}"
                        referral_code = referrer.get('referral_code', 'РќРµ СЃРѕР·РґР°РЅ')
                        
                        referrals_with_purchases = stats.get('referrals_with_purchases_count', 0)
                        total_referrals = stats.get('referrals_count', 0)
                        
                        detail_text = f"""
рџ‘Ґ <b>РЎС‚Р°С‚РёСЃС‚РёРєР° СЂРµС„РµСЂР°Р»Р°</b>

рџ‘¤ <b>Р РµС„РµСЂРµСЂ:</b> {referrer_name}
рџ†” <b>ID:</b> {referrer.get('user_id')}
рџ”‘ <b>Р РµС„РµСЂР°Р»СЊРЅС‹Р№ РєРѕРґ:</b> {referral_code}
рџ’° <b>Р РµС„РµСЂР°Р»СЊРЅС‹Р№ Р±Р°Р»Р°РЅСЃ:</b> {referrer.get('referral_balance', 0):.2f} в‚Ѕ

рџ“Љ <b>РћР±С‰Р°СЏ СЃС‚Р°С‚РёСЃС‚РёРєР°:</b>
вЂў Р’СЃРµРіРѕ СЂРµС„РµСЂР°Р»РѕРІ: <b>{total_referrals}</b>
вЂў Р РµС„РµСЂР°Р»РѕРІ СЃ РїРѕРєСѓРїРєР°РјРё: <b>{referrals_with_purchases}</b>
вЂў РџРѕРєСѓРїРѕРє: <b>{stats.get('total_purchases', 0)}</b>
вЂў Р’С‹СЂСѓС‡РєР°: <b>{stats.get('total_revenue', 0):.2f} в‚Ѕ</b>
вЂў РљРѕРјРёСЃСЃРёСЏ: <b>{stats.get('total_commission', 0):.2f} в‚Ѕ</b> ({stats.get('commission_percent', 20)}%)

рџ“‹ <b>Р РµС„РµСЂР°Р»С‹, РєРѕС‚РѕСЂС‹Рµ РїРµСЂРµС€Р»Рё РїРѕ СЃСЃС‹Р»РєРµ Рё РєСѓРїРёР»Рё:</b>
"""
                        # РџРѕРєР°Р·С‹РІР°РµРј СЂРµС„РµСЂР°Р»РѕРІ (СѓР¶Рµ РѕС‚С„РёР»СЊС‚СЂРѕРІР°РЅС‹ - С‚РѕР»СЊРєРѕ СЃ РїРѕРєСѓРїРєР°РјРё)
                        if not referrals:
                            detail_text += "\nвќЊ <i>РќРµС‚ СЂРµС„РµСЂР°Р»РѕРІ СЃ РїРѕРєСѓРїРєР°РјРё</i>"
                        else:
                            for i, ref in enumerate(referrals[:20], 1):
                                ref_name = ref.get('username') or ref.get('first_name') or f"ID{ref.get('user_id')}"
                                purchases_count = ref.get('purchases_count', 0)
                                total_spent = ref.get('total_spent', 0)
                                
                                detail_text += f"\n{i}. <b>{ref_name}</b> (ID: {ref.get('user_id')})"
                                detail_text += f"\n   РџРѕРєСѓРїРѕРє: {purchases_count} | РџРѕС‚СЂР°С‡РµРЅРѕ: {total_spent:.2f} в‚Ѕ"
                            
                            if len(referrals) > 20:
                                detail_text += f"\n\n... Рё РµС‰Рµ {len(referrals) - 20} СЂРµС„РµСЂР°Р»РѕРІ СЃ РїРѕРєСѓРїРєР°РјРё"
                        
                        kb = InlineKeyboardMarkup(inline_keyboard=[
                            [InlineKeyboardButton(text="рџ“Ґ Р­РєСЃРїРѕСЂС‚ СЂРµС„РµСЂР°Р»РѕРІ", callback_data=f"admin_referrer_export_{referrer_id}")],
                            [InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ Рє СЃРїРёСЃРєСѓ", callback_data="admin_referrers")]
                        ])
                        
                        try:
                            await callback.message.edit_text(detail_text, parse_mode="HTML", reply_markup=kb)
                        except:
                            await callback.message.answer(detail_text, parse_mode="HTML", reply_markup=kb)
                    else:
                        await callback.answer(f"вќЊ РћС€РёР±РєР°: {data.get('message', 'РќРµРёР·РІРµСЃС‚РЅР°СЏ РѕС€РёР±РєР°')}", show_alert=True)
                else:
                    await callback.answer("вќЊ РћС€РёР±РєР° СЃРµСЂРІРµСЂР°", show_alert=True)
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ РґРµС‚Р°Р»СЊРЅРѕР№ СЃС‚Р°С‚РёСЃС‚РёРєРё СЂРµС„РµСЂР°Р»Р°: {e}")
        await callback.answer(f"вќЊ РћС€РёР±РєР°: {str(e)}", show_alert=True)
    
    await callback.answer()


@router.callback_query(F.data == "admin_referrers_search")
async def admin_referrers_search_handler(callback: CallbackQuery, state: FSMContext):
    """РћР±СЂР°Р±РѕС‚С‡РёРє РїРѕРёСЃРєР° СЂРµС„РµСЂРµСЂРѕРІ"""
    user_id = callback.from_user.id
    
