7. Р’РєР»СЋС‡РёС‚Рµ VPN
8. Р“РѕС‚РѕРІРѕ! рџљЂ

вљ пёЏ <b>РљР»СЋС‡ РґРµР№СЃС‚РІСѓРµС‚ С‚РѕР»СЊРєРѕ 24 С‡Р°СЃР°!</b>"""

                            kb = InlineKeyboardMarkup(inline_keyboard=[
                                [InlineKeyboardButton(text="рџЏ  Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
                            ])

                            await send_or_edit_message_with_photo(callback, success_text, reply_markup=kb, edit_message=True, image_name="catalog.png")
                            return
                        else:
                            error_msg = data.get('error', 'РќРµРёР·РІРµСЃС‚РЅР°СЏ РѕС€РёР±РєР°')
                    else:
                        error_msg = f"HTTP {response.status}"
        except Exception as e:
            error_msg = str(e)

        # РћС€РёР±РєР° РІС‹РґР°С‡Рё РєР»СЋС‡Р°
        error_text = f"""
вќЊ <b>РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ РїСЂРѕР±РЅРѕРіРѕ РєР»СЋС‡Р°</b>

