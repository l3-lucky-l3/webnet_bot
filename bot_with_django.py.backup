@router.callback_query(F.data == "admin_toggle_manager_key_delivery")
async def admin_toggle_manager_key_delivery_handler(callback: CallbackQuery):
    """РћР±СЂР°Р±РѕС‚С‡РёРє РІРєР»СЋС‡РµРЅРёСЏ/РІС‹РєР»СЋС‡РµРЅРёСЏ С„СѓРЅРєС†РёРё 'РќР°РїРёСЃР°С‚СЊ РјРµРЅРµРґР¶РµСЂСѓ'"""
    user_id = callback.from_user.id
    
    if not is_admin(user_id):
        await callback.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°", show_alert=True)
        return
    
    if not DJANGO_INTEGRATION:
        await callback.answer("вќЊ РЎРёСЃС‚РµРјР° РЅРµРґРѕСЃС‚СѓРїРЅР°", show_alert=True)
        return
    
    try:
        import aiohttp
        
        # РџРѕР»СѓС‡Р°РµРј С‚РµРєСѓС‰РµРµ Р·РЅР°С‡РµРЅРёРµ
        api_url_get = 'http://127.0.0.1:8123/bot_management/api/settings/get/?key=manager_key_delivery_enabled'
        async with aiohttp.ClientSession() as session:
            async with session.get(api_url_get) as response:
                if response.status == 200:
                    data = await response.json()
                    current_value = data.get('value', 'true')
                    if current_value is None:
                        current_value = 'true'
                    new_value = 'false' if str(current_value).lower() == 'true' else 'true'
                    
                    # РћР±РЅРѕРІР»СЏРµРј Р·РЅР°С‡РµРЅРёРµ
                    api_url_update = 'http://127.0.0.1:8123/bot_management/api/settings/update/'
                    async with session.post(api_url_update, json={
                        'key': 'manager_key_delivery_enabled',
                        'value': new_value
                    }) as update_response:
                        if update_response.status == 200:
                            result = await update_response.json()
                            if result.get('success'):
                                status_text = "РІРєР»СЋС‡РµРЅР°" if new_value == 'true' else "РІС‹РєР»СЋС‡РµРЅР°"
                                await callback.answer(f"вњ… Р¤СѓРЅРєС†РёСЏ 'РџРѕР»СѓС‡РёС‚СЊ РєР»СЋС‡ Сѓ РјРµРЅРµРґР¶РµСЂР°' {status_text}", show_alert=True)
                                # Р’РѕР·РІСЂР°С‰Р°РµРјСЃСЏ РІ РЅР°СЃС‚СЂРѕР№РєРё
                                await admin_settings_handler(callback)
                            else:
                                await callback.answer(f"вќЊ РћС€РёР±РєР°: {result.get('message', 'РќРµРёР·РІРµСЃС‚РЅР°СЏ РѕС€РёР±РєР°')}", show_alert=True)
                        else:
                            await callback.answer("вќЊ РћС€РёР±РєР° РѕР±РЅРѕРІР»РµРЅРёСЏ РЅР°СЃС‚СЂРѕР№РєРё", show_alert=True)
                else:
                    await callback.answer("вќЊ РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ РЅР°СЃС‚СЂРѕР№РєРё", show_alert=True)
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РїРµСЂРµРєР»СЋС‡РµРЅРёСЏ С„СѓРЅРєС†РёРё РјРµРЅРµРґР¶РµСЂР°: {e}")
        await callback.answer(f"вќЊ РћС€РёР±РєР°: {str(e)}", show_alert=True)

