# Р¤СѓРЅРєС†РёСЏ РґР»СЏ РѕС‚РїСЂР°РІРєРё РїСЂРёРІРµС‚СЃС‚РІРµРЅРЅРѕРіРѕ СЃРѕРѕР±С‰РµРЅРёСЏ СЃ С„РѕС‚РѕРіСЂР°С„РёРµР№
async def send_welcome_with_photo(message: Message, text: str, reply_markup=None, reply_keyboard=None):
    """РћС‚РїСЂР°РІР»СЏРµС‚ РїСЂРёРІРµС‚СЃС‚РІРµРЅРЅРѕРµ СЃРѕРѕР±С‰РµРЅРёРµ СЃ С„РѕС‚РѕРіСЂР°С„РёРµР№ РёР· РїР°РїРєРё images"""
    return await send_or_edit_message_with_photo(message, text, reply_markup, edit_message=False, reply_keyboard=reply_keyboard)

# Р¤СѓРЅРєС†РёСЏ РґР»СЏ СЃСЂР°РІРЅРµРЅРёСЏ РєР»Р°РІРёР°С‚СѓСЂ
def keyboards_are_equal(kb1, kb2):
    """РЎСЂР°РІРЅРёРІР°РµС‚ РґРІРµ РєР»Р°РІРёР°С‚СѓСЂС‹ РЅР° СЂР°РІРµРЅСЃС‚РІРѕ"""
    if kb1 is None and kb2 is None:
        return True
    if kb1 is None or kb2 is None:
        return False
    
    try:
        # РЎСЂР°РІРЅРёРІР°РµРј inline_keyboard РµСЃР»Рё СЌС‚Рѕ InlineKeyboardMarkup
        if hasattr(kb1, 'inline_keyboard') and hasattr(kb2, 'inline_keyboard'):
            kb1_buttons = kb1.inline_keyboard
            kb2_buttons = kb2.inline_keyboard
            
            if len(kb1_buttons) != len(kb2_buttons):
                return False
                
            for row1, row2 in zip(kb1_buttons, kb2_buttons):
                if len(row1) != len(row2):
                    return False
                for i in range(len(row1)):
                    btn1 = row1[i]
                    btn2 = row2[i]
                    if btn1.text != btn2.text or btn1.callback_data != btn2.callback_data:
                        return False
            return True
        else:
            # Р”Р»СЏ РґСЂСѓРіРёС… С‚РёРїРѕРІ РєР»Р°РІРёР°С‚СѓСЂ РёСЃРїРѕР»СЊР·СѓРµРј СЃС‚СЂРѕРєРѕРІРѕРµ СЃСЂР°РІРЅРµРЅРёРµ
            return str(kb1) == str(kb2)
    except Exception as e:
        logging.warning(f"РћС€РёР±РєР° СЃСЂР°РІРЅРµРЅРёСЏ РєР»Р°РІРёР°С‚СѓСЂ: {e}")
        return False

# Р¤СѓРЅРєС†РёСЏ РґР»СЏ РѕР±СЂРµР·РєРё РґР»РёРЅРЅС‹С… СЃРѕРѕР±С‰РµРЅРёР№
def truncate_message(text: str, max_length: int = 4090) -> str:
    """РћР±СЂРµР·Р°РµС‚ СЃРѕРѕР±С‰РµРЅРёРµ РґРѕ РјР°РєСЃРёРјР°Р»СЊРЅРѕР№ РґР»РёРЅС‹ СЃ РґРѕР±Р°РІР»РµРЅРёРµРј РјРЅРѕРіРѕС‚РѕС‡РёСЏ"""
    if len(text) <= max_length:
        return text
    
    # РС‰РµРј РїРѕСЃР»РµРґРЅРёР№ РїРѕР»РЅС‹Р№ С‚РµРі РёР»Рё СЃР»РѕРІРѕ
    truncated = text[:max_length]
    
    # РџС‹С‚Р°РµРјСЃСЏ РЅР°Р№С‚Рё РїРѕСЃР»РµРґРЅРёР№ Р·Р°РєСЂС‹РІР°СЋС‰РёР№ С‚РµРі
    last_tag = truncated.rfind('</')
    if last_tag > max_length - 50:  # Р•СЃР»Рё С‚РµРі РЅРµ СЃР»РёС€РєРѕРј РґР°Р»РµРєРѕ РѕС‚ РєРѕРЅС†Р°
        truncated = truncated[:last_tag] + '</b></i>'
    else:
        truncated = truncated.rstrip() + "..."
    
    return truncated

# Р¤СѓРЅРєС†РёСЏ РґР»СЏ РїСЂРѕРІРµСЂРєРё РІР°Р»РёРґРЅРѕСЃС‚Рё СЃРѕРѕР±С‰РµРЅРёСЏ
def is_valid_message(text: str) -> bool:
    """РџСЂРѕРІРµСЂСЏРµС‚, СЏРІР»СЏРµС‚СЃСЏ Р»Рё СЃРѕРѕР±С‰РµРЅРёРµ РІР°Р»РёРґРЅС‹Рј РґР»СЏ РѕС‚РїСЂР°РІРєРё"""
    if not text or not text.strip():
        return False
    
    # РџСЂРѕРІРµСЂСЏРµРј, С‡С‚Рѕ СЃРѕРѕР±С‰РµРЅРёРµ РЅРµ СЃРѕСЃС‚РѕРёС‚ С‚РѕР»СЊРєРѕ РёР· HTML С‚РµРіРѕРІ
    import re
    clean_text = re.sub(r'<[^>]+>', '', text).strip()
    if not clean_text:
        return False
    
    # РџСЂРѕРІРµСЂСЏРµРј, С‡С‚Рѕ СЃРѕРѕР±С‰РµРЅРёРµ РЅРµ СЃРѕСЃС‚РѕРёС‚ С‚РѕР»СЊРєРѕ РёР· СЌРјРѕРґР·Рё Рё РїСЂРѕР±РµР»РѕРІ
    emoji_pattern = re.compile(r'[\U0001F600-\U0001F64F\U0001F300-\U0001F5FF\U0001F680-\U0001F6FF\U0001F1E0-\U0001F1FF\U00002600-\U000027BF\U0001F900-\U0001F9FF\U0001F018-\U0001F0F5\U0001F200-\U0001F2FF\s]+')
    if emoji_pattern.fullmatch(clean_text):
        return False
    
    return True


# РЈРЅРёРІРµСЂСЃР°Р»СЊРЅР°СЏ С„СѓРЅРєС†РёСЏ РґР»СЏ РѕС‚РїСЂР°РІРєРё/СЂРµРґР°РєС‚РёСЂРѕРІР°РЅРёСЏ СЃРѕРѕР±С‰РµРЅРёР№ СЃ РёР·РѕР±СЂР°Р¶РµРЅРёСЏРјРё
async def send_or_edit_message_with_photo(message_or_callback, text: str, reply_markup=None, edit_message=True, image_name="hellonightvpn.png", reply_keyboard=None):
    """
    РЈРЅРёРІРµСЂСЃР°Р»СЊРЅР°СЏ С„СѓРЅРєС†РёСЏ РґР»СЏ РѕС‚РїСЂР°РІРєРё РёР»Рё СЂРµРґР°РєС‚РёСЂРѕРІР°РЅРёСЏ СЃРѕРѕР±С‰РµРЅРёР№ СЃ РёР·РѕР±СЂР°Р¶РµРЅРёСЏРјРё

    Args:
        message_or_callback: Message РёР»Рё CallbackQuery РѕР±СЉРµРєС‚
        text: РўРµРєСЃС‚ СЃРѕРѕР±С‰РµРЅРёСЏ
        reply_markup: Inline РєР»Р°РІРёР°С‚СѓСЂР°
        edit_message: True - СЂРµРґР°РєС‚РёСЂРѕРІР°С‚СЊ СЃСѓС‰РµСЃС‚РІСѓСЋС‰РµРµ СЃРѕРѕР±С‰РµРЅРёРµ, False - РѕС‚РїСЂР°РІРёС‚СЊ РЅРѕРІРѕРµ
        image_name: РРјСЏ С„Р°Р№Р»Р° РёР·РѕР±СЂР°Р¶РµРЅРёСЏ РІ РїР°РїРєРµ images/
        reply_keyboard: Reply РєР»Р°РІРёР°С‚СѓСЂР° (РѕР±С‹С‡РЅР°СЏ РєР»Р°РІРёР°С‚СѓСЂР°)
    """
    try:
        # РџСЂРѕРІРµСЂСЏРµРј РІР°Р»РёРґРЅРѕСЃС‚СЊ СЃРѕРѕР±С‰РµРЅРёСЏ
        if not is_valid_message(text):
            logging.warning("РџРѕРїС‹С‚РєР° РѕС‚РїСЂР°РІРёС‚СЊ РЅРµРІР°Р»РёРґРЅРѕРµ СЃРѕРѕР±С‰РµРЅРёРµ")
            return False

        # РџСЂРѕРІРµСЂСЏРµРј, РѕС‚РєР»СЋС‡РµРЅС‹ Р»Рё С„РѕС‚Рѕ
        if DISABLE_PHOTOS:
            # РћС‚РїСЂР°РІР»СЏРµРј С‚РѕР»СЊРєРѕ С‚РµРєСЃС‚ Р±РµР· С„РѕС‚Рѕ
            is_callback = hasattr(message_or_callback, 'message')
            
            if edit_message:
                try:
                    if is_callback:
                        await message_or_callback.message.edit_text(text, parse_mode="HTML", reply_markup=reply_markup)
                    else:
                        await message_or_callback.answer(text, parse_mode="HTML", reply_markup=reply_markup, reply_keyboard=reply_keyboard)
                except Exception as e:
                    if "message is not modified" in str(e):
                        logging.info("РЎРѕРѕР±С‰РµРЅРёРµ РЅРµ РёР·РјРµРЅРёР»РѕСЃСЊ, РїСЂРѕРїСѓСЃРєР°РµРј СЂРµРґР°РєС‚РёСЂРѕРІР°РЅРёРµ")
                    else:
                        # Р•СЃР»Рё РЅРµР»СЊР·СЏ СЂРµРґР°РєС‚РёСЂРѕРІР°С‚СЊ, РѕС‚РїСЂР°РІР»СЏРµРј РЅРѕРІРѕРµ
                        if is_callback:
                            await message_or_callback.message.answer(text, parse_mode="HTML", reply_markup=reply_markup, reply_keyboard=reply_keyboard)
                        else:
                            await message_or_callback.answer(text, parse_mode="HTML", reply_markup=reply_markup, reply_keyboard=reply_keyboard)
            else:
                # РћС‚РїСЂР°РІР»СЏРµРј РЅРѕРІРѕРµ СЃРѕРѕР±С‰РµРЅРёРµ
                if is_callback:
                    await message_or_callback.message.answer(text, parse_mode="HTML", reply_markup=reply_markup, reply_keyboard=reply_keyboard)
                else:
                    await message_or_callback.answer(text, parse_mode="HTML", reply_markup=reply_markup, reply_keyboard=reply_keyboard)
            
            return True

        # РС‰РµРј РёР·РѕР±СЂР°Р¶РµРЅРёРµ (РµСЃР»Рё С„РѕС‚Рѕ РЅРµ РѕС‚РєР»СЋС‡РµРЅС‹)
        image_path = Path(f"images/{image_name}")
        if image_path.exists():
            logging.info(f"РћС‚РїСЂР°РІР»СЏРµРј/СЂРµРґР°РєС‚РёСЂСѓРµРј СЃ С„РѕС‚РѕРіСЂР°С„РёРµР№: {image_path}")
            
            # Р”Р»СЏ РїРѕРґРїРёСЃРµР№ Рє С„РѕС‚Рѕ Telegram РѕРіСЂР°РЅРёС‡РёРІР°РµС‚ РґРѕ 1024 СЃРёРјРІРѕР»РѕРІ
            # РћР±СЂРµР·Р°РµРј С‚РµРєСЃС‚ РµСЃР»Рё РѕРЅ СЃР»РёС€РєРѕРј РґР»РёРЅРЅС‹Р№ РґР»СЏ РїРѕРґРїРёСЃРё
            caption_text = truncate_message(text, max_length=1024)
            # Р•СЃР»Рё С‚РµРєСЃС‚ Р±С‹Р» РѕР±СЂРµР·Р°РЅ, СЃРѕС…СЂР°РЅСЏРµРј РїРѕР»РЅС‹Р№ С‚РµРєСЃС‚ РґР»СЏ РѕС‚РґРµР»СЊРЅРѕРіРѕ СЃРѕРѕР±С‰РµРЅРёСЏ
            full_text = text if len(text) <= 1024 else None
            
            # РСЃРїРѕР»СЊР·СѓРµРј РѕСЂРёРіРёРЅР°Р»СЊРЅРѕРµ РёР·РѕР±СЂР°Р¶РµРЅРёРµ Р±РµР· РѕР±СЂР°Р±РѕС‚РєРё
            processed_image_path = image_path
            
            # РћРїСЂРµРґРµР»СЏРµРј С‚РёРї РѕР±СЉРµРєС‚Р°
            is_callback = hasattr(message_or_callback, 'message')
            target_message = message_or_callback.message if is_callback else message_or_callback
            
            if edit_message and target_message.photo:
                # РџСЂРѕРІРµСЂСЏРµРј, РёР·РјРµРЅРёР»Р°СЃСЊ Р»Рё РїРѕРґРїРёСЃСЊ РёР»Рё РєР»Р°РІРёР°С‚СѓСЂР°
                current_caption = target_message.caption or ""
                current_reply_markup = target_message.reply_markup
                text_changed = current_caption != caption_text
                keyboard_changed = not keyboards_are_equal(current_reply_markup, reply_markup)
                
                if text_changed or keyboard_changed:
                    # Р•СЃР»Рё СЃРѕРѕР±С‰РµРЅРёРµ СѓР¶Рµ СЃРѕРґРµСЂР¶РёС‚ С„РѕС‚Рѕ, СЂРµРґР°РєС‚РёСЂСѓРµРј РµРіРѕ
                    try:
                        from aiogram.types import InputMediaPhoto
                        photo_file = FSInputFile(processed_image_path)
                        media = InputMediaPhoto(media=photo_file, caption=caption_text, parse_mode="HTML")
                        await target_message.edit_media(
                            media=media,
                            reply_markup=reply_markup
                        )
                        
                        # Р•СЃР»Рё С‚РµРєСЃС‚ Р±С‹Р» РѕР±СЂРµР·Р°РЅ, РѕС‚РїСЂР°РІР»СЏРµРј РѕСЃС‚Р°С‚РѕРє РѕС‚РґРµР»СЊРЅС‹Рј СЃРѕРѕР±С‰РµРЅРёРµРј
                        if full_text is None and len(text) > 1024:
                            # РћС‚РїСЂР°РІР»СЏРµРј РѕСЃС‚Р°С‚РѕРє С‚РµРєСЃС‚Р° РѕС‚РґРµР»СЊРЅС‹Рј СЃРѕРѕР±С‰РµРЅРёРµРј
                            remaining_text = text[1024:]
                            if is_callback:
                                await message_or_callback.message.answer(remaining_text, parse_mode="HTML")
                            else:
                                await message_or_callback.answer(remaining_text, parse_mode="HTML")
                    except Exception as e:
                        if "message is not modified" in str(e):
                            logging.info("РЎРѕРґРµСЂР¶РёРјРѕРµ С„РѕС‚Рѕ РЅРµ РёР·РјРµРЅРёР»РѕСЃСЊ, РїСЂРѕРїСѓСЃРєР°РµРј СЂРµРґР°РєС‚РёСЂРѕРІР°РЅРёРµ")
                        elif "caption is too long" in str(e).lower():
                            # Р•СЃР»Рё РїРѕРґРїРёСЃСЊ РІСЃРµ РµС‰Рµ СЃР»РёС€РєРѕРј РґР»РёРЅРЅР°СЏ, РѕС‚РїСЂР°РІР»СЏРµРј С„РѕС‚Рѕ Р±РµР· РїРѕРґРїРёСЃРё
                            logging.warning(f"РџРѕРґРїРёСЃСЊ СЃР»РёС€РєРѕРј РґР»РёРЅРЅР°СЏ, РѕС‚РїСЂР°РІР»СЏРµРј С„РѕС‚Рѕ Р±РµР· РїРѕРґРїРёСЃРё: {e}")
                            try:
                                from aiogram.types import InputMediaPhoto
                                photo_file = FSInputFile(processed_image_path)
                                media = InputMediaPhoto(media=photo_file)
                                await target_message.edit_media(
                                    media=media,
                                    reply_markup=reply_markup
                                )
                                # РћС‚РїСЂР°РІР»СЏРµРј С‚РµРєСЃС‚ РѕС‚РґРµР»СЊРЅС‹Рј СЃРѕРѕР±С‰РµРЅРёРµРј
                                if is_callback:
                                    await message_or_callback.message.answer(text, parse_mode="HTML")
                                else:
                                    await message_or_callback.answer(text, parse_mode="HTML")
                            except Exception as e2:
                                logging.error(f"РћС€РёР±РєР° РѕС‚РїСЂР°РІРєРё С„РѕС‚Рѕ Р±РµР· РїРѕРґРїРёСЃРё: {e2}")
                        else:
                            logging.error(f"РћС€РёР±РєР° СЂРµРґР°РєС‚РёСЂРѕРІР°РЅРёСЏ С„РѕС‚Рѕ: {e}")
                else:
                    # РЎРѕРґРµСЂР¶РёРјРѕРµ РЅРµ РёР·РјРµРЅРёР»РѕСЃСЊ, РЅРµ СЂРµРґР°РєС‚РёСЂСѓРµРј
                    logging.info("РЎРѕРґРµСЂР¶РёРјРѕРµ С„РѕС‚Рѕ Рё РєР»Р°РІРёР°С‚СѓСЂР° РЅРµ РёР·РјРµРЅРёР»РёСЃСЊ, РїСЂРѕРїСѓСЃРєР°РµРј СЂРµРґР°РєС‚РёСЂРѕРІР°РЅРёРµ")
            elif edit_message:
                # Р•СЃР»Рё СЃРѕРѕР±С‰РµРЅРёРµ Р±РµР· С„РѕС‚Рѕ, РЅРѕ РЅСѓР¶РЅРѕ СЂРµРґР°РєС‚РёСЂРѕРІР°С‚СЊ - РѕС‚РїСЂР°РІР»СЏРµРј РЅРѕРІРѕРµ СЃ С„РѕС‚Рѕ
                photo_file = FSInputFile(processed_image_path)
                try:
                    if is_callback:
                        await message_or_callback.message.answer_photo(
                            photo=photo_file,
                            caption=caption_text,
                            parse_mode="HTML",
                            reply_markup=reply_markup
                        )
                    else:
                        await message_or_callback.answer_photo(
                            photo=photo_file,
                            caption=caption_text,
                            parse_mode="HTML",
                            reply_markup=reply_markup,
                            reply_keyboard=reply_keyboard
                        )
                    
                    # Р•СЃР»Рё С‚РµРєСЃС‚ Р±С‹Р» РѕР±СЂРµР·Р°РЅ, РѕС‚РїСЂР°РІР»СЏРµРј РѕСЃС‚Р°С‚РѕРє РѕС‚РґРµР»СЊРЅС‹Рј СЃРѕРѕР±С‰РµРЅРёРµРј
                    if full_text is None and len(text) > 1024:
                        remaining_text = text[1024:]
                        if is_callback:
                            await message_or_callback.message.answer(remaining_text, parse_mode="HTML")
                        else:
                            await message_or_callback.answer(remaining_text, parse_mode="HTML")
                except Exception as e:
                    if "caption is too long" in str(e).lower():
                        # Р•СЃР»Рё РїРѕРґРїРёСЃСЊ РІСЃРµ РµС‰Рµ СЃР»РёС€РєРѕРј РґР»РёРЅРЅР°СЏ, РѕС‚РїСЂР°РІР»СЏРµРј С„РѕС‚Рѕ Р±РµР· РїРѕРґРїРёСЃРё
                        logging.warning(f"РџРѕРґРїРёСЃСЊ СЃР»РёС€РєРѕРј РґР»РёРЅРЅР°СЏ, РѕС‚РїСЂР°РІР»СЏРµРј С„РѕС‚Рѕ Р±РµР· РїРѕРґРїРёСЃРё: {e}")
                        if is_callback:
                            await message_or_callback.message.answer_photo(
                                photo=photo_file,
                                reply_markup=reply_markup
                            )
                            await message_or_callback.message.answer(text, parse_mode="HTML")
                        else:
                            await message_or_callback.answer_photo(
                                photo=photo_file,
                                reply_markup=reply_markup,
                                reply_keyboard=reply_keyboard
                            )
                            await message_or_callback.answer(text, parse_mode="HTML")
                    else:
                        raise
            else:
                # РћС‚РїСЂР°РІР»СЏРµРј РЅРѕРІРѕРµ СЃРѕРѕР±С‰РµРЅРёРµ СЃ С„РѕС‚Рѕ
                photo_file = FSInputFile(processed_image_path)
                try:
                    if is_callback:
                        await message_or_callback.message.answer_photo(
                            photo=photo_file,
                            caption=caption_text,
                            parse_mode="HTML",
                            reply_markup=reply_markup,
                            reply_keyboard=reply_keyboard
                        )
                    else:
                        await message_or_callback.answer_photo(
                            photo=photo_file,
                            caption=caption_text,
                            parse_mode="HTML",
                            reply_markup=reply_markup,
                            reply_keyboard=reply_keyboard
                        )
                    
                    # Р•СЃР»Рё С‚РµРєСЃС‚ Р±С‹Р» РѕР±СЂРµР·Р°РЅ, РѕС‚РїСЂР°РІР»СЏРµРј РѕСЃС‚Р°С‚РѕРє РѕС‚РґРµР»СЊРЅС‹Рј СЃРѕРѕР±С‰РµРЅРёРµРј
                    if full_text is None and len(text) > 1024:
                        remaining_text = text[1024:]
                        if is_callback:
                            await message_or_callback.message.answer(remaining_text, parse_mode="HTML")
                        else:
                            await message_or_callback.answer(remaining_text, parse_mode="HTML")
                except Exception as e:
                    if "caption is too long" in str(e).lower():
                        # Р•СЃР»Рё РїРѕРґРїРёСЃСЊ РІСЃРµ РµС‰Рµ СЃР»РёС€РєРѕРј РґР»РёРЅРЅР°СЏ, РѕС‚РїСЂР°РІР»СЏРµРј С„РѕС‚Рѕ Р±РµР· РїРѕРґРїРёСЃРё
                        logging.warning(f"РџРѕРґРїРёСЃСЊ СЃР»РёС€РєРѕРј РґР»РёРЅРЅР°СЏ, РѕС‚РїСЂР°РІР»СЏРµРј С„РѕС‚Рѕ Р±РµР· РїРѕРґРїРёСЃРё: {e}")
                        if is_callback:
                            await message_or_callback.message.answer_photo(
                                photo=photo_file,
                                reply_markup=reply_markup,
                                reply_keyboard=reply_keyboard
                            )
                            await message_or_callback.message.answer(text, parse_mode="HTML")
                        else:
                            await message_or_callback.answer_photo(
                                photo=photo_file,
                                reply_markup=reply_markup,
                                reply_keyboard=reply_keyboard
                            )
                            await message_or_callback.answer(text, parse_mode="HTML")
                    else:
                        raise
            
            # РЈРґР°Р»СЏРµРј РІСЂРµРјРµРЅРЅС‹Р№ С„Р°Р№Р» РµСЃР»Рё РѕРЅ Р±С‹Р» СЃРѕР·РґР°РЅ
            if processed_image_path != image_path and processed_image_path.exists():
                processed_image_path.unlink()
                logging.info("Р’СЂРµРјРµРЅРЅС‹Р№ С„Р°Р№Р» СѓРґР°Р»РµРЅ")
            
            return True
        else:
            logging.warning(f"Р¤Р°Р№Р» {image_path} РЅРµ РЅР°Р№РґРµРЅ")
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РѕС‚РїСЂР°РІРєРё/СЂРµРґР°РєС‚РёСЂРѕРІР°РЅРёСЏ С„РѕС‚РѕРіСЂР°С„РёРё: {e}")
    
    # Р•СЃР»Рё РЅРµ СѓРґР°Р»РѕСЃСЊ РѕС‚РїСЂР°РІРёС‚СЊ С„РѕС‚Рѕ, РёСЃРїРѕР»СЊР·СѓРµРј РѕР±С‹С‡РЅС‹Р№ С‚РµРєСЃС‚
    try:
        is_callback = hasattr(message_or_callback, 'message')
        
        if edit_message:
            # РџСЂРѕРІРµСЂСЏРµРј, РјРѕР¶РЅРѕ Р»Рё СЂРµРґР°РєС‚РёСЂРѕРІР°С‚СЊ СЃРѕРѕР±С‰РµРЅРёРµ
            if is_callback and hasattr(message_or_callback.message, 'text') and message_or_callback.message.text:
                # РџСЂРѕРІРµСЂСЏРµРј, РёР·РјРµРЅРёР»РѕСЃСЊ Р»Рё СЃРѕРґРµСЂР¶РёРјРѕРµ РёР»Рё РєР»Р°РІРёР°С‚СѓСЂР°
                current_text = message_or_callback.message.text
                current_reply_markup = message_or_callback.message.reply_markup
                text_changed = current_text != text
                keyboard_changed = not keyboards_are_equal(current_reply_markup, reply_markup)
                
                if text_changed or keyboard_changed:
                    # РЎРѕРѕР±С‰РµРЅРёРµ СЃРѕРґРµСЂР¶РёС‚ С‚РµРєСЃС‚, РјРѕР¶РЅРѕ СЂРµРґР°РєС‚РёСЂРѕРІР°С‚СЊ
                    try:
                        await message_or_callback.message.edit_text(text, parse_mode="HTML", reply_markup=reply_markup)
                    except Exception as e:
                        if "message is not modified" in str(e):
                            logging.info("РЎРѕРґРµСЂР¶РёРјРѕРµ С‚РµРєСЃС‚РѕРІРѕРіРѕ СЃРѕРѕР±С‰РµРЅРёСЏ РЅРµ РёР·РјРµРЅРёР»РѕСЃСЊ, РїСЂРѕРїСѓСЃРєР°РµРј СЂРµРґР°РєС‚РёСЂРѕРІР°РЅРёРµ")
                        else:
                            logging.error(f"РћС€РёР±РєР° СЂРµРґР°РєС‚РёСЂРѕРІР°РЅРёСЏ С‚РµРєСЃС‚Р°: {e}")
                else:
                    # РЎРѕРґРµСЂР¶РёРјРѕРµ РЅРµ РёР·РјРµРЅРёР»РѕСЃСЊ, РЅРµ СЂРµРґР°РєС‚РёСЂСѓРµРј
                    logging.info("РЎРѕРґРµСЂР¶РёРјРѕРµ СЃРѕРѕР±С‰РµРЅРёСЏ Рё РєР»Р°РІРёР°С‚СѓСЂР° РЅРµ РёР·РјРµРЅРёР»РёСЃСЊ, РїСЂРѕРїСѓСЃРєР°РµРј СЂРµРґР°РєС‚РёСЂРѕРІР°РЅРёРµ")
            elif is_callback and hasattr(message_or_callback.message, 'photo') and message_or_callback.message.photo:
                # РџСЂРѕРІРµСЂСЏРµРј, РёР·РјРµРЅРёР»Р°СЃСЊ Р»Рё РїРѕРґРїРёСЃСЊ РёР»Рё РєР»Р°РІРёР°С‚СѓСЂР°
                current_caption = message_or_callback.message.caption or ""
                current_reply_markup = message_or_callback.message.reply_markup
                text_changed = current_caption != text
                keyboard_changed = not keyboards_are_equal(current_reply_markup, reply_markup)
                
                if text_changed or keyboard_changed:
                    # РЎРѕРѕР±С‰РµРЅРёРµ СЃРѕРґРµСЂР¶РёС‚ С„РѕС‚Рѕ, СЂРµРґР°РєС‚РёСЂСѓРµРј РїРѕРґРїРёСЃСЊ
                    try:
                        await message_or_callback.message.edit_caption(
                            caption=text,
                            parse_mode="HTML",
                            reply_markup=reply_markup
                        )
                    except Exception as e:
                        if "message is not modified" in str(e):
                            logging.info("РџРѕРґРїРёСЃСЊ С„РѕС‚Рѕ РЅРµ РёР·РјРµРЅРёР»Р°СЃСЊ, РїСЂРѕРїСѓСЃРєР°РµРј СЂРµРґР°РєС‚РёСЂРѕРІР°РЅРёРµ")
                        else:
                            logging.error(f"РћС€РёР±РєР° СЂРµРґР°РєС‚РёСЂРѕРІР°РЅРёСЏ РїРѕРґРїРёСЃРё: {e}")
                else:
                    # РЎРѕРґРµСЂР¶РёРјРѕРµ РЅРµ РёР·РјРµРЅРёР»РѕСЃСЊ, РЅРµ СЂРµРґР°РєС‚РёСЂСѓРµРј
                    logging.info("РџРѕРґРїРёСЃСЊ СЃРѕРѕР±С‰РµРЅРёСЏ Рё РєР»Р°РІРёР°С‚СѓСЂР° РЅРµ РёР·РјРµРЅРёР»РёСЃСЊ, РїСЂРѕРїСѓСЃРєР°РµРј СЂРµРґР°РєС‚РёСЂРѕРІР°РЅРёРµ")
            else:
                # РќРµ РјРѕР¶РµРј СЂРµРґР°РєС‚РёСЂРѕРІР°С‚СЊ, РѕС‚РїСЂР°РІР»СЏРµРј РЅРѕРІРѕРµ
                if is_callback:
                    await message_or_callback.message.answer(text, parse_mode="HTML", reply_markup=reply_markup, reply_keyboard=reply_keyboard)
                else:
                    await message_or_callback.answer(text, parse_mode="HTML", reply_markup=reply_markup, reply_keyboard=reply_keyboard)
        else:
            # РћС‚РїСЂР°РІР»СЏРµРј РЅРѕРІРѕРµ СЃРѕРѕР±С‰РµРЅРёРµ
            if is_callback:
                await message_or_callback.message.answer(text, parse_mode="HTML", reply_markup=reply_markup, reply_keyboard=reply_keyboard)
            else:
                await message_or_callback.answer(text, parse_mode="HTML", reply_markup=reply_markup, reply_keyboard=reply_keyboard)
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РѕС‚РїСЂР°РІРєРё С‚РµРєСЃС‚РѕРІРѕРіРѕ СЃРѕРѕР±С‰РµРЅРёСЏ: {e}")
        # РџРѕСЃР»РµРґРЅСЏСЏ РїРѕРїС‹С‚РєР° - РїСЂРѕСЃС‚Рѕ РѕС‚РІРµС‚РёС‚СЊ
        try:
            if is_callback:
                await message_or_callback.answer(text, parse_mode="HTML", reply_markup=reply_markup)
            else:
                await message_or_callback.answer(text, parse_mode="HTML", reply_markup=reply_markup)
        except Exception as final_e:
            if "message is not modified" in str(final_e):
                logging.info("РЎРѕРґРµСЂР¶РёРјРѕРµ СЃРѕРѕР±С‰РµРЅРёСЏ РЅРµ РёР·РјРµРЅРёР»РѕСЃСЊ РІ РїРѕСЃР»РµРґРЅРµР№ РїРѕРїС‹С‚РєРµ, РїСЂРѕРїСѓСЃРєР°РµРј")
            else:
                logging.error(f"РљСЂРёС‚РёС‡РµСЃРєР°СЏ РѕС€РёР±РєР° РѕС‚РїСЂР°РІРєРё СЃРѕРѕР±С‰РµРЅРёСЏ: {final_e}")
                # РћС‚РїСЂР°РІР»СЏРµРј РїСЂРѕСЃС‚РѕРµ СЃРѕРѕР±С‰РµРЅРёРµ Р±РµР· С„РѕСЂРјР°С‚РёСЂРѕРІР°РЅРёСЏ
                try:
                    simple_text = text.replace('<b>', '').replace('</b>', '').replace('<i>', '').replace('</i>', '')
                    if is_callback:
                        await message_or_callback.answer(simple_text)
                    else:
                        await message_or_callback.answer(simple_text)
                except:
                    pass  # Р•СЃР»Рё РґР°Р¶Рµ СЌС‚Рѕ РЅРµ СЂР°Р±РѕС‚Р°РµС‚, РїСЂРѕСЃС‚Рѕ РёРіРЅРѕСЂРёСЂСѓРµРј
    
    return False

# Р¤СѓРЅРєС†РёСЏ РґР»СЏ РѕС‚РїСЂР°РІРєРё РїСЂРёРІРµС‚СЃС‚РІРµРЅРЅРѕРіРѕ СЃРѕРѕР±С‰РµРЅРёСЏ СЃ С„РѕС‚РѕРіСЂР°С„РёРµР№ С‡РµСЂРµР· callback
async def send_welcome_with_photo_callback(callback: CallbackQuery, text: str, reply_markup=None):
    """РћС‚РїСЂР°РІР»СЏРµС‚ РїСЂРёРІРµС‚СЃС‚РІРµРЅРЅРѕРµ СЃРѕРѕР±С‰РµРЅРёРµ СЃ С„РѕС‚РѕРіСЂР°С„РёРµР№ С‡РµСЂРµР· callback"""
    return await send_or_edit_message_with_photo(callback, text, reply_markup, edit_message=True)

# Django СѓР¶Рµ РЅР°СЃС‚СЂРѕРµРЅ РІС‹С€Рµ

# Р›РѕРіРёСЂРѕРІР°РЅРёРµ
logging.basicConfig(
    level=logging.DEBUG,  # РР·РјРµРЅРµРЅРѕ СЃ INFO РЅР° DEBUG РґР»СЏ РїРѕРєР°Р·Р° user_id РІ Р»РѕРіР°С…
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
)

# РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ
init_db()
bot = Bot(token=BOT_TOKEN)
dp = Dispatcher(storage=MemoryStorage())

# Р”РѕР±Р°РІР»СЏРµРј middleware РґР»СЏ Р·Р°С‰РёС‚С‹ РѕС‚ DDoS РџР•Р Р•Р” РІРєР»СЋС‡РµРЅРёРµРј router
# dp.message.middleware(ThrottlingMiddleware())  # Р’СЂРµРјРµРЅРЅРѕ РѕС‚РєР»СЋС‡РµРЅРѕ
# dp.callback_query.middleware(ThrottlingMiddleware())  # Р’СЂРµРјРµРЅРЅРѕ РѕС‚РєР»СЋС‡РµРЅРѕ
dp.message.middleware(SecurityMiddleware())
dp.callback_query.middleware(SecurityMiddleware())
dp.message.middleware(ErrorHandlingMiddleware())
dp.callback_query.middleware(ErrorHandlingMiddleware())

router = Router()
dp.include_router(router)

# HTTP СЃРµСЂРІРµСЂ РґР»СЏ РїРѕР»СѓС‡РµРЅРёСЏ СѓРІРµРґРѕРјР»РµРЅРёР№ РѕС‚ Django
from aiohttp import web
import aiohttp
from aiohttp import ClientSession, TCPConnector

# Р“Р»РѕР±Р°Р»СЊРЅР°СЏ СЃРµСЃСЃРёСЏ aiohttp СЃ connection pooling РґР»СЏ РѕРїС‚РёРјРёР·Р°С†РёРё
_http_session = None

def get_http_session():
    """РџРѕР»СѓС‡РёС‚СЊ РёР»Рё СЃРѕР·РґР°С‚СЊ РіР»РѕР±Р°Р»СЊРЅСѓСЋ HTTP СЃРµСЃСЃРёСЋ СЃ connection pooling"""
    global _http_session
    if _http_session is None or _http_session.closed:
        connector = TCPConnector(
            limit=100,  # РњР°РєСЃРёРјСѓРј СЃРѕРµРґРёРЅРµРЅРёР№
            limit_per_host=30,  # РњР°РєСЃРёРјСѓРј СЃРѕРµРґРёРЅРµРЅРёР№ РЅР° С…РѕСЃС‚
            ttl_dns_cache=300,  # РљСЌС€ DNS РЅР° 5 РјРёРЅСѓС‚
            force_close=False,  # РџРµСЂРµРёСЃРїРѕР»СЊР·РѕРІР°РЅРёРµ СЃРѕРµРґРёРЅРµРЅРёР№
            enable_cleanup_closed=True
        )
        timeout = aiohttp.ClientTimeout(total=10, connect=5)
        _http_session = ClientSession(connector=connector, timeout=timeout)
    return _http_session

async def handle_withdrawal_notification(request):
    """HTTP endpoint РґР»СЏ РїРѕР»СѓС‡РµРЅРёСЏ СѓРІРµРґРѕРјР»РµРЅРёР№ Рѕ Р·Р°СЏРІРєР°С… РЅР° РІС‹РІРѕРґ РѕС‚ Django"""
    try:
        data = await request.json()
        notification_type = data.get('notification_type')
        withdrawal_data = data.get('withdrawal_data')
        
        if not notification_type or not withdrawal_data:
            return web.json_response({
                'success': False,
                'message': 'РќРµ РІСЃРµ РѕР±СЏР·Р°С‚РµР»СЊРЅС‹Рµ РїРѕР»СЏ Р·Р°РїРѕР»РЅРµРЅС‹'
            }, status=400)
        
        # РћС‚РїСЂР°РІР»СЏРµРј СѓРІРµРґРѕРјР»РµРЅРёРµ РІ Telegram
        await send_withdrawal_notification(notification_type, withdrawal_data)
        
        return web.json_response({'success': True, 'message': 'РЈРІРµРґРѕРјР»РµРЅРёРµ РѕС‚РїСЂР°РІР»РµРЅРѕ'})
        
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РѕР±СЂР°Р±РѕС‚РєРё СѓРІРµРґРѕРјР»РµРЅРёСЏ Рѕ Р·Р°СЏРІРєРµ РЅР° РІС‹РІРѕРґ: {e}")
        return web.json_response({
            'success': False,
            'message': 'Р’РЅСѓС‚СЂРµРЅРЅСЏСЏ РѕС€РёР±РєР° СЃРµСЂРІРµСЂР°'
        }, status=500)

async def handle_platega_callback(request):
    """
    HTTP endpoint РґР»СЏ РїРѕР»СѓС‡РµРЅРёСЏ callback РѕС‚ Platega РЅР°РїСЂСЏРјСѓСЋ РІ Р±РѕС‚
    РЎРѕРіР»Р°СЃРЅРѕ РґРѕРєСѓРјРµРЅС‚Р°С†РёРё: https://docs.platega.io/callback-РѕР±-РёР·РјРµРЅРµРЅРёРё-СЃС‚Р°С‚СѓСЃР°-С‚СЂР°РЅР·Р°РєС†РёРё-22645075e0
    
    РСЃРїРѕР»СЊР·СѓРµС‚СЃСЏ РєРѕРіРґР° РЅРµС‚ РґРѕРјРµРЅР° - С‡РµСЂРµР· ngrok РёР»Рё РґСЂСѓРіРѕР№ С‚СѓРЅРЅРµР»СЊ
    """
    try:
        import json
        from config import PLATEGA_MERCHANT_ID, PLATEGA_SECRET
        
        logging.info("DEBUG: РџРѕР»СѓС‡РµРЅ POST Р·Р°РїСЂРѕСЃ РЅР° Platega callback РІ Р±РѕС‚Рµ")
        
        # РџСЂРѕРІРµСЂРєР° Р°РІС‚РѕСЂРёР·Р°С†РёРё С‡РµСЂРµР· Р·Р°РіРѕР»РѕРІРєРё
        merchant_id = request.headers.get('X-MerchantId')
        secret = request.headers.get('X-Secret')
        
        if not merchant_id or not secret:
            logging.error("DEBUG: РћС‚СЃСѓС‚СЃС‚РІСѓСЋС‚ РѕР±СЏР·Р°С‚РµР»СЊРЅС‹Рµ Р·Р°РіРѕР»РѕРІРєРё X-MerchantId РёР»Рё X-Secret")
            return web.json_response({'status': 'error', 'message': 'Unauthorized'}, status=401)
        
        # РџСЂРѕРІРµСЂСЏРµРј СѓС‡РµС‚РЅС‹Рµ РґР°РЅРЅС‹Рµ
        if merchant_id != PLATEGA_MERCHANT_ID or secret != PLATEGA_SECRET:
            logging.error(f"DEBUG: РќРµРІРµСЂРЅС‹Рµ СѓС‡РµС‚РЅС‹Рµ РґР°РЅРЅС‹Рµ")
            return web.json_response({'status': 'error', 'message': 'Unauthorized'}, status=401)
        
        logging.info("DEBUG: РђРІС‚РѕСЂРёР·Р°С†РёСЏ СѓСЃРїРµС€РЅР°")
        
        # РџРѕР»СѓС‡Р°РµРј РґР°РЅРЅС‹Рµ callback РёР· JSON С‚РµР»Р°
        try:
            callback_data = await request.json()
        except Exception as e:
            logging.error(f"DEBUG: РћС€РёР±РєР° РїР°СЂСЃРёРЅРіР° JSON: {e}")
            return web.json_response({'status': 'error', 'message': 'Invalid JSON'}, status=400)
        
        logging.info(f"DEBUG: РџРѕР»СѓС‡РµРЅ callback РѕС‚ Platega: {callback_data}")
        
        # Р’Р°Р»РёРґР°С†РёСЏ РѕР±СЏР·Р°С‚РµР»СЊРЅС‹С… РїРѕР»РµР№
        required_fields = ['id', 'amount', 'currency', 'status', 'paymentMethod']
        missing_fields = [field for field in required_fields if field not in callback_data]
        if missing_fields:
            logging.error(f"DEBUG: РћС‚СЃСѓС‚СЃС‚РІСѓСЋС‚ РѕР±СЏР·Р°С‚РµР»СЊРЅС‹Рµ РїРѕР»СЏ: {missing_fields}")
            return web.json_response({'status': 'error', 'message': f'Missing required fields: {missing_fields}'}, status=400)
        
        # РћР±СЂР°Р±Р°С‚С‹РІР°РµРј callback
        transaction_id = callback_data.get('id')
        status = callback_data.get('status', '').upper()
        
        logging.info(f"DEBUG: Transaction ID: {transaction_id}, Status: {status}")
        
        # РћР±СЂР°Р±Р°С‚С‹РІР°РµРј С‡РµСЂРµР· Django РµСЃР»Рё РґРѕСЃС‚СѓРїРµРЅ
        if DJANGO_INTEGRATION:
            try:
                from asgiref.sync import sync_to_async
                from bot_management.platega_service import PlategaService
                
                # Р’С‹Р·С‹РІР°РµРј СЃРёРЅС…СЂРѕРЅРЅСѓСЋ С„СѓРЅРєС†РёСЋ С‡РµСЂРµР· sync_to_async
                result = await sync_to_async(PlategaService.process_webhook)(
                    callback_data, 
                    merchant_id=merchant_id, 
                    secret=secret
                )
                
                if result:
                    logging.info("DEBUG: Callback СѓСЃРїРµС€РЅРѕ РѕР±СЂР°Р±РѕС‚Р°РЅ С‡РµСЂРµР· Django")
                    return web.json_response({'status': 'ok'}, status=200)
                else:
                    logging.warning("DEBUG: Callback РѕР±СЂР°Р±РѕС‚Р°РЅ СЃ РѕС€РёР±РєРѕР№")
                    return web.json_response({'status': 'ok', 'message': 'Received but processing failed'}, status=200)
            except Exception as e:
                logging.error(f"DEBUG: РћС€РёР±РєР° РѕР±СЂР°Р±РѕС‚РєРё С‡РµСЂРµР· Django: {e}")
                import traceback
                logging.error(traceback.format_exc())
                # РџСЂРѕРґРѕР»Р¶Р°РµРј РѕР±СЂР°Р±РѕС‚РєСѓ С‡РµСЂРµР· Р»РѕРєР°Р»СЊРЅСѓСЋ Р‘Р”
        else:
            logging.warning("DEBUG: Django РёРЅС‚РµРіСЂР°С†РёСЏ РЅРµРґРѕСЃС‚СѓРїРЅР°, РѕР±СЂР°Р±Р°С‚С‹РІР°РµРј С‡РµСЂРµР· Р»РѕРєР°Р»СЊРЅСѓСЋ Р‘Р”")
        
        # РћР±СЂР°Р±РѕС‚РєР° С‡РµСЂРµР· Р»РѕРєР°Р»СЊРЅСѓСЋ SQLite Р‘Р” (РµСЃР»Рё Django РЅРµРґРѕСЃС‚СѓРїРµРЅ)
        try:
            with get_db() as conn:
                # РќР°С…РѕРґРёРј РїР»Р°С‚РµР¶ РїРѕ transaction_id
                cursor = conn.execute("""
                    SELECT payment_id, user_id, status, subscription_type, amount
                    FROM payments
                    WHERE platega_transaction_id = ?
                """, (transaction_id,))
                
                payment = cursor.fetchone()
                
                if not payment:
                    logging.warning(f"DEBUG: РџР»Р°С‚РµР¶ СЃ transaction_id {transaction_id} РЅРµ РЅР°Р№РґРµРЅ РІ Р‘Р”")
                    return web.json_response({'status': 'ok', 'message': 'Payment not found'}, status=200)
                
                payment_id, user_id, payment_status, subscription_type, amount = payment
                
                logging.info(f"DEBUG: РќР°Р№РґРµРЅ РїР»Р°С‚РµР¶: payment_id={payment_id}, user_id={user_id}, status={payment_status}")
                
                # РћР±СЂР°Р±РѕС‚РєР° СЃС‚Р°С‚СѓСЃРѕРІ
                if status == 'CONFIRMED':
                    if payment_status == 'succeeded':
                        logging.info(f"DEBUG: РџР»Р°С‚РµР¶ {payment_id} СѓР¶Рµ РѕР±СЂР°Р±РѕС‚Р°РЅ")
                        return web.json_response({'status': 'ok'}, status=200)
                    
                    # РћР±РЅРѕРІР»СЏРµРј СЃС‚Р°С‚СѓСЃ (РЅРѕ РќР• РїРѕРґС‚РІРµСЂР¶РґР°РµРј Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРё)
                    logging.info(f"DEBUG: РџР»Р°С‚РµР¶ {payment_id} СѓСЃРїРµС€РµРЅ РІ Platega (CONFIRMED), РѕР±РЅРѕРІР»СЏРµРј СЃС‚Р°С‚СѓСЃ")
                    conn.execute("""
                        UPDATE payments
                        SET status = 'pending'
                        WHERE payment_id = ?
                    """, (payment_id,))
                    
                    # РЈРІРµРґРѕРјР»СЏРµРј РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ, С‡С‚Рѕ РЅСѓР¶РЅРѕ РїСЂРѕРІРµСЂРёС‚СЊ РїР»Р°С‚РµР¶
                    try:
                        await bot.send_message(
                            user_id,
                            f"""вњ… <b>РџР»Р°С‚РµР¶ РїРѕР»СѓС‡РµРЅ!</b>

рџ’і <b>РЎСѓРјРјР°:</b> {amount} в‚Ѕ
рџ“¦ <b>РџРѕРґРїРёСЃРєР°:</b> {subscription_type}

рџ”„ <b>РќР°Р¶РјРёС‚Рµ РєРЅРѕРїРєСѓ "РџСЂРѕРІРµСЂРёС‚СЊ РїР»Р°С‚РµР¶" РґР»СЏ РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ Рё РїРѕР»СѓС‡РµРЅРёСЏ РєР»СЋС‡Р°</b>

<i>РћР±С‹С‡РЅРѕ РїР»Р°С‚РµР¶ РїРѕРґС‚РІРµСЂР¶РґР°РµС‚СЃСЏ РІ С‚РµС‡РµРЅРёРµ РЅРµСЃРєРѕР»СЊРєРёС… РјРёРЅСѓС‚</i>""",
                            parse_mode="HTML"
                        )
                    except Exception as e:
                        logging.error(f"DEBUG: РћС€РёР±РєР° РѕС‚РїСЂР°РІРєРё СѓРІРµРґРѕРјР»РµРЅРёСЏ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ {user_id}: {e}")
                    
                    logging.info(f"DEBUG: РџР»Р°С‚РµР¶ {payment_id} РѕР±СЂР°Р±РѕС‚Р°РЅ")
                    return web.json_response({'status': 'ok'}, status=200)
                    
                elif status == 'CANCELED':
                    # РћС‚РјРµРЅСЏРµРј РїР»Р°С‚РµР¶
                    conn.execute("""
                        UPDATE payments
                        SET status = 'canceled'
                        WHERE payment_id = ?
                    """, (payment_id,))
                    
                    logging.info(f"DEBUG: РџР»Р°С‚РµР¶ {payment_id} РѕС‚РјРµРЅРµРЅ")
                    return web.json_response({'status': 'ok'}, status=200)
                else:
                    logging.warning(f"DEBUG: РќРµРёР·РІРµСЃС‚РЅС‹Р№ СЃС‚Р°С‚СѓСЃ: {status}")
                    return web.json_response({'status': 'ok'}, status=200)
                    
        except Exception as e:
            logging.error(f"DEBUG: РћС€РёР±РєР° РѕР±СЂР°Р±РѕС‚РєРё С‡РµСЂРµР· Р»РѕРєР°Р»СЊРЅСѓСЋ Р‘Р”: {e}")
            import traceback
            logging.error(traceback.format_exc())
            return web.json_response({'status': 'ok'}, status=200)  # Р’СЃРµ СЂР°РІРЅРѕ РІРѕР·РІСЂР°С‰Р°РµРј 200
        
    except Exception as e:
        logging.error(f"DEBUG: РћС€РёР±РєР° РѕР±СЂР°Р±РѕС‚РєРё callback: {e}")
        import traceback
        logging.error(traceback.format_exc())
        return web.json_response({'status': 'error', 'message': str(e)}, status=200)  # Р’СЃРµ СЂР°РІРЅРѕ 200 РґР»СЏ Platega

async def init_http_server():
    """РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ HTTP СЃРµСЂРІРµСЂР° РґР»СЏ Р±РѕС‚Р°"""
    app = web.Application()
    app.router.add_post('/api/withdrawal/notification/', handle_withdrawal_notification)
    # Endpoint РґР»СЏ Platega callback РЅР°РїСЂСЏРјСѓСЋ РІ Р±РѕС‚
    app.router.add_post('/api/platega/callback/', handle_platega_callback)
    
    runner = web.AppRunner(app)
    await runner.setup()
    # РЎР»СѓС€Р°РµРј РЅР° РІСЃРµС… РёРЅС‚РµСЂС„РµР№СЃР°С… (0.0.0.0) РґР»СЏ РґРѕСЃС‚СѓРїР° С‡РµСЂРµР· ngrok
    site = web.TCPSite(runner, '0.0.0.0', 8023)
    await site.start()
    logging.info("HTTP СЃРµСЂРІРµСЂ Р±РѕС‚Р° Р·Р°РїСѓС‰РµРЅ РЅР° РїРѕСЂС‚Сѓ 8023 (0.0.0.0)")
    logging.info("Р”Р»СЏ РїСѓР±Р»РёС‡РЅРѕРіРѕ РґРѕСЃС‚СѓРїР° РёСЃРїРѕР»СЊР·СѓР№С‚Рµ ngrok: ngrok http 8023")
    logging.info("URL РґР»СЏ Platega callback: https://РІР°С€-ngrok-url.ngrok.io/api/platega/callback/")

# РџСЂРѕРІРµСЂСЏРµРј РЅР°СЃС‚СЂРѕР№РєРё
print(f"SUPPORT_GROUP_ID: {SUPPORT_GROUP_ID}")
print(f"ADMIN_IDS: {ADMIN_IDS}")

# Р’СЂРµРјРµРЅРЅРѕ СѓСЃС‚Р°РЅР°РІР»РёРІР°РµРј SUPPORT_GROUP_ID РґР»СЏ С‚РµСЃС‚РёСЂРѕРІР°РЅРёСЏ
if not SUPPORT_GROUP_ID:
    SUPPORT_GROUP_ID = "-1001234567890"  # Р—Р°РјРµРЅРёС‚Рµ РЅР° СЂРµР°Р»СЊРЅС‹Р№ ID РіСЂСѓРїРїС‹
    print(f"РЈСЃС‚Р°РЅРѕРІР»РµРЅ РІСЂРµРјРµРЅРЅС‹Р№ SUPPORT_GROUP_ID: {SUPPORT_GROUP_ID}")

# Р¤СѓРЅРєС†РёСЏ РґР»СЏ РѕС‚РїСЂР°РІРєРё СѓРІРµРґРѕРјР»РµРЅРёР№ Рѕ Р·Р°СЏРІРєР°С… РЅР° РІС‹РІРѕРґ
async def send_withdrawal_notification(notification_type: str, withdrawal_data: dict):
    """РћС‚РїСЂР°РІР»СЏРµС‚ СѓРІРµРґРѕРјР»РµРЅРёСЏ Рѕ Р·Р°СЏРІРєР°С… РЅР° РІС‹РІРѕРґ РІ РіСЂСѓРїРїСѓ Рё РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ"""
    try:
        logging.info(f"РћС‚РїСЂР°РІР»СЏРµРј СѓРІРµРґРѕРјР»РµРЅРёРµ С‚РёРїР°: {notification_type}")
        logging.info(f"Р”Р°РЅРЅС‹Рµ Р·Р°СЏРІРєРё: {withdrawal_data}")
        
        user_id = withdrawal_data.get('user_id')
        amount = withdrawal_data.get('amount')
        payment_method = withdrawal_data.get('payment_method')
        payment_details = withdrawal_data.get('payment_details')
        username = withdrawal_data.get('username', 'N/A')
        first_name = withdrawal_data.get('first_name', '')
        
        # РћРїСЂРµРґРµР»СЏРµРј РЅР°Р·РІР°РЅРёРµ СЃРїРѕСЃРѕР±Р° РІС‹РїР»Р°С‚С‹
        method_names = {
            "bank_card": "Р‘Р°РЅРєРѕРІСЃРєР°СЏ РєР°СЂС‚Р°",
            "yoomoney": "Р®Money",
            "sberbank": "РЎР±РµСЂР±Р°РЅРє",
            "tinkoff": "РўРёРЅСЊРєРѕС„С„"
        }
        method_name = method_names.get(payment_method, payment_method)
        
        if notification_type == 'new_request':
            # РЈРІРµРґРѕРјР»РµРЅРёРµ РІ РіСЂСѓРїРїСѓ Рѕ РЅРѕРІРѕР№ Р·Р°СЏРІРєРµ
            group_message = f"""
рџ”” <b>РќРѕРІР°СЏ Р·Р°СЏРІРєР° РЅР° РІС‹РІРѕРґ СЃСЂРµРґСЃС‚РІ</b>

рџ‘¤ <b>РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ:</b> @{username} ({first_name})
рџ†” <b>ID:</b> {user_id}
рџ’° <b>РЎСѓРјРјР°:</b> {amount} в‚Ѕ
рџ’і <b>РЎРїРѕСЃРѕР± РІС‹РїР»Р°С‚С‹:</b> {method_name}
рџ“ќ <b>Р РµРєРІРёР·РёС‚С‹:</b> {payment_details[:20]}...

вЏ° <b>РўСЂРµР±СѓРµС‚ РѕР±СЂР°Р±РѕС‚РєРё</b>
"""
            
            # РЈРІРµРґРѕРјР»РµРЅРёРµ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ
            user_message = f"""
вњ… <b>Р—Р°СЏРІРєР° РЅР° РІС‹РІРѕРґ СЃРѕР·РґР°РЅР°</b>

рџ’° <b>РЎСѓРјРјР°:</b> {amount} в‚Ѕ
рџ’і <b>РЎРїРѕСЃРѕР± РІС‹РїР»Р°С‚С‹:</b> {method_name}
рџ“ќ <b>Р РµРєРІРёР·РёС‚С‹:</b> {payment_details}

вЏі <b>РЎС‚Р°С‚СѓСЃ:</b> Р’ РѕР±СЂР°Р±РѕС‚РєРµ
рџ“‹ <b>Р’Р°С€Р° Р·Р°СЏРІРєР° РїРµСЂРµРґР°РЅР° Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂСѓ</b>

вЏ° <b>РћР¶РёРґР°Р№С‚Рµ СѓРІРµРґРѕРјР»РµРЅРёСЏ Рѕ СЃС‚Р°С‚СѓСЃРµ</b>
"""
            
        elif notification_type == 'approved':
            # РЈРІРµРґРѕРјР»РµРЅРёРµ РІ РіСЂСѓРїРїСѓ РѕР± РѕРґРѕР±СЂРµРЅРёРё
            group_message = f"""
вњ… <b>Р—Р°СЏРІРєР° РЅР° РІС‹РІРѕРґ РѕРґРѕР±СЂРµРЅР°</b>

рџ‘¤ <b>РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ:</b> @{username} ({first_name})
рџ†” <b>ID:</b> {user_id}
рџ’° <b>РЎСѓРјРјР°:</b> {amount} в‚Ѕ
рџ’і <b>РЎРїРѕСЃРѕР± РІС‹РїР»Р°С‚С‹:</b> {method_name}

рџЋЇ <b>Р“РѕС‚РѕРІРѕ Рє РІС‹РїР»Р°С‚Рµ</b>
"""
            
            # РЈРІРµРґРѕРјР»РµРЅРёРµ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ
            user_message = f"""
рџЋ‰ <b>Р—Р°СЏРІРєР° РЅР° РІС‹РІРѕРґ РѕРґРѕР±СЂРµРЅР°!</b>

рџ’° <b>РЎСѓРјРјР°:</b> {amount} в‚Ѕ
рџ’і <b>РЎРїРѕСЃРѕР± РІС‹РїР»Р°С‚С‹:</b> {method_name}
рџ“ќ <b>Р РµРєРІРёР·РёС‚С‹:</b> {payment_details}

вњ… <b>РЎС‚Р°С‚СѓСЃ:</b> РћРґРѕР±СЂРµРЅРѕ
вЏ° <b>РћР¶РёРґР°Р№С‚Рµ РІС‹РїР»Р°С‚С‹</b>

рџ’Ў <b>РЎСЂРµРґСЃС‚РІР° Р±СѓРґСѓС‚ РїРµСЂРµРІРµРґРµРЅС‹ РІ Р±Р»РёР¶Р°Р№С€РµРµ РІСЂРµРјСЏ</b>
"""
            
        elif notification_type == 'completed':
            # РЈРІРµРґРѕРјР»РµРЅРёРµ РІ РіСЂСѓРїРїСѓ Рѕ Р·Р°РІРµСЂС€РµРЅРёРё РІС‹РїР»Р°С‚С‹
            group_message = f"""
рџ’° <b>Р’С‹РїР»Р°С‚Р° Р·Р°РІРµСЂС€РµРЅР°</b>

рџ‘¤ <b>РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ:</b> @{username} ({first_name})
рџ†” <b>ID:</b> {user_id}
рџ’° <b>РЎСѓРјРјР°:</b> {amount} в‚Ѕ
рџ’і <b>РЎРїРѕСЃРѕР± РІС‹РїР»Р°С‚С‹:</b> {method_name}

вњ… <b>Р’С‹РїР»Р°С‚Р° СѓСЃРїРµС€РЅРѕ Р·Р°РІРµСЂС€РµРЅР°</b>
"""
            
            # РЈРІРµРґРѕРјР»РµРЅРёРµ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ
            user_message = f"""
рџЋ‰ <b>Р’С‹РїР»Р°С‚Р° Р·Р°РІРµСЂС€РµРЅР°!</b>

рџ’° <b>РЎСѓРјРјР°:</b> {amount} в‚Ѕ
рџ’і <b>РЎРїРѕСЃРѕР± РІС‹РїР»Р°С‚С‹:</b> {method_name}
рџ“ќ <b>Р РµРєРІРёР·РёС‚С‹:</b> {payment_details}

вњ… <b>РЎС‚Р°С‚СѓСЃ:</b> Р’С‹РїР»Р°С‡РµРЅРѕ
рџ’і <b>РЎСЂРµРґСЃС‚РІР° РїРµСЂРµРІРµРґРµРЅС‹ РЅР° СѓРєР°Р·Р°РЅРЅС‹Рµ СЂРµРєРІРёР·РёС‚С‹</b>

рџ™Џ <b>РЎРїР°СЃРёР±Рѕ Р·Р° РёСЃРїРѕР»СЊР·РѕРІР°РЅРёРµ РЅР°С€РµРіРѕ СЃРµСЂРІРёСЃР°!</b>
"""
            
        elif notification_type == 'rejected':
            # РЈРІРµРґРѕРјР»РµРЅРёРµ РІ РіСЂСѓРїРїСѓ РѕР± РѕС‚РєР»РѕРЅРµРЅРёРё
            group_message = f"""
вќЊ <b>Р—Р°СЏРІРєР° РЅР° РІС‹РІРѕРґ РѕС‚РєР»РѕРЅРµРЅР°</b>

рџ‘¤ <b>РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ:</b> @{username} ({first_name})
рџ†” <b>ID:</b> {user_id}
рџ’° <b>РЎСѓРјРјР°:</b> {amount} в‚Ѕ
рџ’і <b>РЎРїРѕСЃРѕР± РІС‹РїР»Р°С‚С‹:</b> {method_name}

рџљ« <b>Р—Р°СЏРІРєР° РѕС‚РєР»РѕРЅРµРЅР°</b>
"""
            
            # РЈРІРµРґРѕРјР»РµРЅРёРµ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ
            user_message = f"""
вќЊ <b>Р—Р°СЏРІРєР° РЅР° РІС‹РІРѕРґ РѕС‚РєР»РѕРЅРµРЅР°</b>

рџ’° <b>РЎСѓРјРјР°:</b> {amount} в‚Ѕ
рџ’і <b>РЎРїРѕСЃРѕР± РІС‹РїР»Р°С‚С‹:</b> {method_name}

рџљ« <b>РЎС‚Р°С‚СѓСЃ:</b> РћС‚РєР»РѕРЅРµРЅРѕ
рџ’Ў <b>РЎСЂРµРґСЃС‚РІР° РІРѕР·РІСЂР°С‰РµРЅС‹ РЅР° СЂРµС„РµСЂР°Р»СЊРЅС‹Р№ Р±Р°Р»Р°РЅСЃ</b>

рџ“ћ <b>РџРѕ РІРѕРїСЂРѕСЃР°Рј РѕР±СЂР°С‰Р°Р№С‚РµСЃСЊ РІ РїРѕРґРґРµСЂР¶РєСѓ</b>
"""
        
        # РћС‚РїСЂР°РІР»СЏРµРј СѓРІРµРґРѕРјР»РµРЅРёРµ РІ РіСЂСѓРїРїСѓ (РµСЃР»Рё СѓРєР°Р·Р°РЅ ID РіСЂСѓРїРїС‹)
        if SUPPORT_GROUP_ID:
            try:
                logging.info(f"РћС‚РїСЂР°РІР»СЏРµРј СѓРІРµРґРѕРјР»РµРЅРёРµ РІ РіСЂСѓРїРїСѓ {SUPPORT_GROUP_ID}")
                await bot.send_message(
                    chat_id=SUPPORT_GROUP_ID,
                    text=group_message,
                    parse_mode="HTML"
                )
                logging.info(f"РЈРІРµРґРѕРјР»РµРЅРёРµ РІ РіСЂСѓРїРїСѓ РѕС‚РїСЂР°РІР»РµРЅРѕ СѓСЃРїРµС€РЅРѕ")
            except Exception as e:
                logging.error(f"РћС€РёР±РєР° РѕС‚РїСЂР°РІРєРё СѓРІРµРґРѕРјР»РµРЅРёСЏ РІ РіСЂСѓРїРїСѓ: {e}")
        else:
            logging.warning("SUPPORT_GROUP_ID РЅРµ СѓСЃС‚Р°РЅРѕРІР»РµРЅ, СѓРІРµРґРѕРјР»РµРЅРёРµ РІ РіСЂСѓРїРїСѓ РЅРµ РѕС‚РїСЂР°РІР»РµРЅРѕ")
        
        # РћС‚РїСЂР°РІР»СЏРµРј СѓРІРµРґРѕРјР»РµРЅРёРµ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ
        try:
            await bot.send_message(
                chat_id=user_id,
                text=user_message,
                parse_mode="HTML"
            )
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° РѕС‚РїСЂР°РІРєРё СѓРІРµРґРѕРјР»РµРЅРёСЏ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ {user_id}: {e}")
            
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РѕС‚РїСЂР°РІРєРё СѓРІРµРґРѕРјР»РµРЅРёСЏ Рѕ Р·Р°СЏРІРєРµ РЅР° РІС‹РІРѕРґ: {e}")

