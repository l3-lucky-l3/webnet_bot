                [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
            ])
    else:
        text = "вќЊ РЎРёСЃС‚РµРјР° РЅРµРґРѕСЃС‚СѓРїРЅР°"
        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
        ])
    
    await send_or_edit_message_with_photo(callback, text, reply_markup=kb, edit_message=True, image_name="money.png")


# РћР±СЂР°Р±РѕС‚С‡РёРєРё РІС‹Р±РѕСЂР° СЃРїРѕСЃРѕР±Р° РІС‹РїР»Р°С‚С‹
@router.callback_query(F.data.startswith("withdrawal_"))
async def withdrawal_method_handler(callback: CallbackQuery, state: FSMContext):
    """РћР±СЂР°Р±РѕС‚С‡РёРє РІС‹Р±РѕСЂР° СЃРїРѕСЃРѕР±Р° РІС‹РїР»Р°С‚С‹"""
    user_id = callback.from_user.id
    method = callback.data.replace("withdrawal_", "")
    
    method_names = {
        "bank_card": "Р‘Р°РЅРєРѕРІСЃРєР°СЏ РєР°СЂС‚Р°",
        "yoomoney": "Р®Money",
        "sberbank": "РЎР±РµСЂР±Р°РЅРє",
        "tinkoff": "РўРёРЅСЊРєРѕС„С„"
    }
    
    method_name = method_names.get(method, method)
    
    # РЎРѕС…СЂР°РЅСЏРµРј РІС‹Р±СЂР°РЅРЅС‹Р№ СЃРїРѕСЃРѕР± РІ СЃРѕСЃС‚РѕСЏРЅРёРё
    await state.update_data(withdrawal_method=method)
    
    text = f"""
рџ’° <b>Р—Р°РїСЂРѕСЃ РЅР° РІС‹РІРѕРґ СЃСЂРµРґСЃС‚РІ</b>

рџ’і <b>РЎРїРѕСЃРѕР± РІС‹РїР»Р°С‚С‹:</b> {method_name}

рџ“ќ <b>Р’РІРµРґРёС‚Рµ СЂРµРєРІРёР·РёС‚С‹ РґР»СЏ РІС‹РїР»Р°С‚С‹:</b>

"""
    
    if method == "bank_card":
        text += """
рџ’і <b>Р”Р»СЏ Р±Р°РЅРєРѕРІСЃРєРѕР№ РєР°СЂС‚С‹ СѓРєР°Р¶РёС‚Рµ:</b>
вЂў РќРѕРјРµСЂ РєР°СЂС‚С‹ (16 С†РёС„СЂ)
вЂў РРјСЏ РІР»Р°РґРµР»СЊС†Р° РєР°СЂС‚С‹

РџСЂРёРјРµСЂ: 1234 5678 9012 3456, РРІР°РЅ РРІР°РЅРѕРІ
"""
    elif method == "yoomoney":
        text += """
рџ’Ћ <b>Р”Р»СЏ Р®Money СѓРєР°Р¶РёС‚Рµ:</b>
вЂў РќРѕРјРµСЂ РєРѕС€РµР»СЊРєР°

РџСЂРёРјРµСЂ: 4100112345678901
"""
    elif method == "sberbank":
        text += """
рџЏ¦ <b>Р”Р»СЏ РЎР±РµСЂР±Р°РЅРєР° СѓРєР°Р¶РёС‚Рµ:</b>
вЂў РќРѕРјРµСЂ РєР°СЂС‚С‹ РёР»Рё СЃС‡РµС‚Р°

РџСЂРёРјРµСЂ: 1234 5678 9012 3456
"""
    elif method == "tinkoff":
        text += """
рџЏЄ <b>Р”Р»СЏ РўРёРЅСЊРєРѕС„С„ СѓРєР°Р¶РёС‚Рµ:</b>
вЂў РќРѕРјРµСЂ РєР°СЂС‚С‹

РџСЂРёРјРµСЂ: 1234 5678 9012 3456
"""
    
    text += """

рџ’Ў <b>Р’РІРµРґРёС‚Рµ СЂРµРєРІРёР·РёС‚С‹ РІ СЃР»РµРґСѓСЋС‰РµРј СЃРѕРѕР±С‰РµРЅРёРё</b>
"""
    
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="вќЊ РћС‚РјРµРЅРёС‚СЊ", callback_data="referral_withdrawal")]
    ])
    
    await send_or_edit_message_with_photo(callback, text, reply_markup=kb, edit_message=True, image_name="payment.png")
    
    # РЈСЃС‚Р°РЅР°РІР»РёРІР°РµРј СЃРѕСЃС‚РѕСЏРЅРёРµ РѕР¶РёРґР°РЅРёСЏ СЂРµРєРІРёР·РёС‚РѕРІ
    await state.set_state(WithdrawalState.waiting_payment_details)


class WithdrawalState(StatesGroup):
    waiting_payment_details = State()
    waiting_amount = State()


# РћР±СЂР°Р±РѕС‚С‡РёРє РїРѕРґРґРµСЂР¶РєРё
