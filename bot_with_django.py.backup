# РџСЂРёС‘Рј PDF
@router.message(F.content_type == ContentType.DOCUMENT)
@protect_message('messages')
async def handle_pdf(message: Message):
    if not message.document.mime_type == "application/pdf":
        await message.answer("""
вќЊ <b>РќРµРІРµСЂРЅС‹Р№ С„РѕСЂРјР°С‚ С„Р°Р№Р»Р°!</b>

рџ“Ћ <b>РџРѕР¶Р°Р»СѓР№СЃС‚Р°, РѕС‚РїСЂР°РІСЊС‚Рµ РёРјРµРЅРЅРѕ PDF-С„Р°Р№Р»:</b>
вЂў РќРµ СЃРєСЂРёРЅС€РѕС‚ СЌРєСЂР°РЅР°
вЂў РќРµ С„РѕС‚РѕРіСЂР°С„РёСЋ С‡РµРєР°
вЂў Рђ РёРјРµРЅРЅРѕ PDF-РґРѕРєСѓРјРµРЅС‚

рџ’Ў <b>РљР°Рє РїРѕР»СѓС‡РёС‚СЊ PDF:</b>
вЂў РЎРєР°С‡Р°Р№С‚Рµ С‡РµРє РёР· Р±Р°РЅРєРѕРІСЃРєРѕРіРѕ РїСЂРёР»РѕР¶РµРЅРёСЏ
вЂў РР»Рё РїРѕРїСЂРѕСЃРёС‚Рµ Р±Р°РЅРє РѕС‚РїСЂР°РІРёС‚СЊ С‡РµРє РЅР° email
""", parse_mode="HTML")
        return

    with get_db() as conn:
        cursor = conn.cursor()
        cursor.execute("""
            SELECT * FROM payments 
            WHERE user_id = ? AND status = 'pending'
            ORDER BY created_at DESC LIMIT 1
        """, (message.from_user.id,))
        payment = cursor.fetchone()

        if not payment:
            await message.answer("""
вќЊ <b>РђРєС‚РёРІРЅС‹Р№ РїР»Р°С‚РµР¶ РЅРµ РЅР°Р№РґРµРЅ!</b>

рџ”„ <b>Р§С‚Рѕ РґРµР»Р°С‚СЊ:</b>
1пёЏвѓЈ РќР°Р¶РјРёС‚Рµ /start
2пёЏвѓЈ Р’С‹Р±РµСЂРёС‚Рµ РїРѕРґРїРёСЃРєСѓ
3пёЏвѓЈ РџРѕР»СѓС‡РёС‚Рµ РґР°РЅРЅС‹Рµ РґР»СЏ РѕРїР»Р°С‚С‹
4пёЏвѓЈ РЎРґРµР»Р°Р№С‚Рµ РїРµСЂРµРІРѕРґ
5пёЏвѓЈ РћС‚РїСЂР°РІСЊС‚Рµ PDF-С‡РµРє

<i>РџР»Р°С‚РµР¶ РґРѕР»Р¶РµРЅ Р±С‹С‚СЊ Р°РєС‚РёРІРЅС‹Рј РґР»СЏ Р·Р°РіСЂСѓР·РєРё С‡РµРєР°</i>
""", parse_mode="HTML")
            return

        cursor.execute("""
            UPDATE payments SET pdf_file_id = ?, has_receipt = 1 WHERE payment_id = ?
        """, (message.document.file_id, payment["payment_id"]))

    # РЈРІРµРґРѕРјР»СЏРµРј Django Рѕ Р·Р°РіСЂСѓР¶РµРЅРЅРѕРј С‡РµРєРµ
    if DJANGO_INTEGRATION:
        await notify_django_payment_receipt(payment["payment_id"], message.document.file_id)

    # РЈРІРµРґРѕРјР»РµРЅРёРµ Р°РґРјРёРЅР°Рј
    if payment['subscription_type'] == 'trial':
        sub_type_text = "рџЋЃ РџСЂРѕР±РЅР°СЏ"
    elif payment['subscription_type'] == 'month':
        sub_type_text = "рџ“… РњРµСЃСЏС‡РЅР°СЏ"
    elif payment['subscription_type'] == '3months':
        sub_type_text = "рџ“… 3 РјРµСЃСЏС†Р°"
    elif payment['subscription_type'] == '6months':
        sub_type_text = "рџ“… 6 РјРµСЃСЏС†РµРІ"
    elif payment['subscription_type'] == 'year':
        sub_type_text = "рџ“… Р“РѕРґРѕРІР°СЏ"
    else:
        sub_type_text = payment['subscription_type']
    
    for admin_id in ADMIN_IDS:
        try:
            await bot.send_message(
                admin_id,
                f"""
рџ“Ґ <b>РќРѕРІС‹Р№ РїР»Р°С‚РµР¶ С‚СЂРµР±СѓРµС‚ РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ</b>

рџ‘¤ <b>РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ:</b> @{message.from_user.username or message.from_user.id}
рџ’° <b>РЎСѓРјРјР°:</b> <code>{payment['amount']} в‚Ѕ</code>
рџЋ« <b>РўРёРї РїРѕРґРїРёСЃРєРё:</b> {sub_type_text}
рџ’і <b>ID РєР°СЂС‚С‹:</b> <code>{payment['card_id']}</code>

рџ“Ћ <b>Р§РµРє Р·Р°РіСЂСѓР¶РµРЅ Рё РіРѕС‚РѕРІ Рє РїСЂРѕРІРµСЂРєРµ</b>
""",
                parse_mode="HTML",
                reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                    [InlineKeyboardButton(text="рџ‘Ѓ РџРѕСЃРјРѕС‚СЂРµС‚СЊ С‡РµРє", callback_data=f"view_pdf:{payment['payment_id']}")],
                    [InlineKeyboardButton(text="вњ… РџРѕРґС‚РІРµСЂРґРёС‚СЊ", callback_data=f"confirm:{payment['payment_id']}"),
                     InlineKeyboardButton(text="вќЊ РћС‚РєР»РѕРЅРёС‚СЊ", callback_data=f"reject:{payment['payment_id']}")]
                ])
            )
        except:
            pass

    await message.answer("""
вњ… <b>Р§РµРє СѓСЃРїРµС€РЅРѕ РїРѕР»СѓС‡РµРЅ!</b>

рџ“‹ <b>Р§С‚Рѕ РїСЂРѕРёСЃС…РѕРґРёС‚ РґР°Р»СЊС€Рµ:</b>
1пёЏвѓЈ РђРґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂ РїСЂРѕРІРµСЂРёС‚ РІР°С€ С‡РµРє
2пёЏвѓЈ РЎРІРµСЂРёС‚ СЃСѓРјРјСѓ Рё РїРѕР»СѓС‡Р°С‚РµР»СЏ
3пёЏвѓЈ РџРѕРґС‚РІРµСЂРґРёС‚ РёР»Рё РѕС‚РєР»РѕРЅРёС‚ РїР»Р°С‚РµР¶
4пёЏвѓЈ РџСЂРё РїРѕРґС‚РІРµСЂР¶РґРµРЅРёРё РІС‹ РїРѕР»СѓС‡РёС‚Рµ РєР»СЋС‡

вЏ° <b>Р’СЂРµРјСЏ РѕР±СЂР°Р±РѕС‚РєРё:</b> РѕР±С‹С‡РЅРѕ РІ С‚РµС‡РµРЅРёРµ 15-30 РјРёРЅСѓС‚

<i>РЎРїР°СЃРёР±Рѕ Р·Р° РїРѕРєСѓРїРєСѓ! рџЋ‰</i>
""", parse_mode="HTML")

# РџРѕРґРґРµСЂР¶РєР°
@router.callback_query(F.data == "support")
async def support_start(callback: CallbackQuery, state: FSMContext):
    # РџСЂРёРЅСѓРґРёС‚РµР»СЊРЅРѕ СЃР±СЂР°СЃС‹РІР°РµРј СЃРѕСЃС‚РѕСЏРЅРёРµ РїРµСЂРµРґ РЅР°С‡Р°Р»РѕРј РїРѕРґРґРµСЂР¶РєРё
    await state.clear()
    print(f"DEBUG: РЎРѕСЃС‚РѕСЏРЅРёРµ СЃР±СЂРѕС€РµРЅРѕ РїРµСЂРµРґ РЅР°С‡Р°Р»РѕРј РїРѕРґРґРµСЂР¶РєРё РґР»СЏ {callback.from_user.id}")
    
    chat_id = get_or_create_support_chat(callback.from_user.id)
    print(f"DEBUG: РЎРѕР·РґР°РЅ/РЅР°Р№РґРµРЅ С‡Р°С‚ РїРѕРґРґРµСЂР¶РєРё СЃ ID: {chat_id}")
    await state.set_state(SupportState.in_chat)
    await state.set_data({"chat_id": chat_id})
    print(f"DEBUG: РЈСЃС‚Р°РЅРѕРІР»РµРЅРѕ СЃРѕСЃС‚РѕСЏРЅРёРµ РїРѕРґРґРµСЂР¶РєРё РґР»СЏ {callback.from_user.id}")
    
    support_text = """
рџ›  <b>РЎР»СѓР¶Р±Р° РїРѕРґРґРµСЂР¶РєРё</b>

рџ’¬ <b>РњС‹ РіРѕС‚РѕРІС‹ РїРѕРјРѕС‡СЊ!</b>

рџ“ќ <b>РћРїРёС€РёС‚Рµ РІР°С€Сѓ РїСЂРѕР±Р»РµРјСѓ:</b>
вЂў РџСЂРѕР±Р»РµРјС‹ СЃ РѕРїР»Р°С‚РѕР№
вЂў Р’РѕРїСЂРѕСЃС‹ РїРѕ РїРѕРґРїРёСЃРєРµ
вЂў РўРµС…РЅРёС‡РµСЃРєРёРµ РЅРµРїРѕР»Р°РґРєРё
вЂў Р”СЂСѓРіРёРµ РІРѕРїСЂРѕСЃС‹

вЏ° <b>Р’СЂРµРјСЏ РѕС‚РІРµС‚Р°:</b> РѕР±С‹С‡РЅРѕ РІ С‚РµС‡РµРЅРёРµ 15-30 РјРёРЅСѓС‚

<i>РќР°РїРёС€РёС‚Рµ РІР°С€ РІРѕРїСЂРѕСЃ РЅРёР¶Рµ в¬‡пёЏ</i>
"""
    
    support_kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="вќ“ Р§Р°СЃС‚С‹Рµ РІРѕРїСЂРѕСЃС‹", callback_data="faq")],
        [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
    ])
    
    await send_or_edit_message_with_photo(callback, support_text, reply_markup=support_kb, edit_message=True)

# РћР±СЂР°Р±РѕС‚С‡РёРєРё СЃРѕСЃС‚РѕСЏРЅРёР№ РґРѕР»Р¶РЅС‹ Р±С‹С‚СЊ РІС‹С€Рµ РґСЂСѓРіРёС… РѕР±СЂР°Р±РѕС‚С‡РёРєРѕРІ СЃРѕРѕР±С‰РµРЅРёР№
@router.message(BroadcastState.waiting_message)
async def process_broadcast_message(message: Message, state: FSMContext):
    """РћР±СЂР°Р±РѕС‚РєР° С‚РµРєСЃС‚Р° СЂР°СЃСЃС‹Р»РєРё"""
    logging.info(f"DEBUG: РџРѕР»СѓС‡РµРЅРѕ СЃРѕРѕР±С‰РµРЅРёРµ РґР»СЏ СЂР°СЃСЃС‹Р»РєРё РѕС‚ {message.from_user.id}, С‚РµРєСЃС‚: {(message.text or message.caption or '')[:50]}")
    user_id = message.from_user.id
    
    # РџСЂРѕРІРµСЂСЏРµРј С‚РµРєСѓС‰РµРµ СЃРѕСЃС‚РѕСЏРЅРёРµ
    current_state = await state.get_state()
    logging.info(f"DEBUG: РўРµРєСѓС‰РµРµ СЃРѕСЃС‚РѕСЏРЅРёРµ: {current_state}, РѕР¶РёРґР°РµС‚СЃСЏ: {BroadcastState.waiting_message}")
    
    if current_state != BroadcastState.waiting_message:
        logging.warning(f"DEBUG: РЎРѕСЃС‚РѕСЏРЅРёРµ РЅРµ СЃРѕРѕС‚РІРµС‚СЃС‚РІСѓРµС‚! РћР¶РёРґР°Р»РѕСЃСЊ: {BroadcastState.waiting_message}, РїРѕР»СѓС‡РµРЅРѕ: {current_state}")
        # Р’СЃРµ СЂР°РІРЅРѕ РѕР±СЂР°Р±Р°С‚С‹РІР°РµРј, РµСЃР»Рё СЌС‚Рѕ Р°РґРјРёРЅ
        if not is_admin(user_id):
            return
    
    if not is_admin(user_id):
        logging.warning(f"РџРѕРїС‹С‚РєР° РґРѕСЃС‚СѓРїР° Рє СЂР°СЃСЃС‹Р»РєРµ РѕС‚ РЅРµ-Р°РґРјРёРЅР° {user_id}")
        await message.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°")
        await state.clear()
        return
    
    # РџСЂРѕРІРµСЂСЏРµРј РѕС‚РјРµРЅСѓ
    if message.text and message.text.strip() == "/cancel":
        logging.info(f"Р Р°СЃСЃС‹Р»РєР° РѕС‚РјРµРЅРµРЅР° РїРѕР»СЊР·РѕРІР°С‚РµР»РµРј {user_id}")
        await message.answer("вќЊ Р Р°СЃСЃС‹Р»РєР° РѕС‚РјРµРЅРµРЅР°")
        await state.clear()
        return
    
    raw_text = message.text or message.caption or ""
    
    if not raw_text.strip():
        logging.warning(f"РџСѓСЃС‚РѕРµ СЃРѕРѕР±С‰РµРЅРёРµ РґР»СЏ СЂР°СЃСЃС‹Р»РєРё РѕС‚ {user_id}")
        await message.answer("вќЊ РўРµРєСЃС‚ СЃРѕРѕР±С‰РµРЅРёСЏ РЅРµ РјРѕР¶РµС‚ Р±С‹С‚СЊ РїСѓСЃС‚С‹Рј. Р’РІРµРґРёС‚Рµ С‚РµРєСЃС‚ РёР»Рё РѕС‚РїСЂР°РІСЊС‚Рµ /cancel РґР»СЏ РѕС‚РјРµРЅС‹.")
        return

    # РџР°СЂСЃРёРј С‚РµРєСЃС‚ Рё РєРЅРѕРїРєРё
    lines = raw_text.splitlines()
    text_lines = []
    buttons = []  # СЃРїРёСЃРѕРє СЃР»РѕРІР°СЂРµР№: {'text': ..., 'url': ...} РёР»Рё {'text': ..., 'callback_data': ...}
    for line in lines:
        stripped = line.strip()
        if stripped.lower().startswith("btn:"):
            payload = stripped[4:].strip()
            if not payload:
                continue
            if "|" in payload:
                title, data = [p.strip() for p in payload.split("|", 1)]
            else:
                title, data = payload, payload

            if not title or not data:
                continue

            # URL-РєРЅРѕРїРєР° РёР»Рё callback-РєРЅРѕРїРєР°
            if data.startswith("http://") or data.startswith("https://"):
                buttons.append({"text": title, "url": data})
            else:
                buttons.append({"text": title, "callback_data": data})
        else:
            text_lines.append(line)

    message_text = "\n".join(text_lines).strip()

    if not message_text:
        logging.warning(f"РџСѓСЃС‚РѕР№ С‚РµРєСЃС‚ РїРѕСЃР»Рµ РїР°СЂСЃРёРЅРіР° РєРЅРѕРїРѕРє РґР»СЏ СЂР°СЃСЃС‹Р»РєРё РѕС‚ {user_id}")
        await message.answer("вќЊ РўРµРєСЃС‚ СЃРѕРѕР±С‰РµРЅРёСЏ РЅРµ РјРѕР¶РµС‚ Р±С‹С‚СЊ РїСѓСЃС‚С‹Рј. РЈРґР°Р»РёС‚Рµ СЃС‚СЂРѕРєРё СЃ РєРЅРѕРїРєР°РјРё РёР»Рё РґРѕР±Р°РІСЊС‚Рµ С‚РµРєСЃС‚ РІС‹С€Рµ.")
        return

    logging.info(f"РћР±СЂР°Р±РѕС‚РєР° СЃРѕРѕР±С‰РµРЅРёСЏ РґР»СЏ СЂР°СЃСЃС‹Р»РєРё: {message_text[:50]}...")
    
    # РЎРѕС…СЂР°РЅСЏРµРј РјРµРґРёР°, РµСЃР»Рё РµСЃС‚СЊ
    photo_file_id = None
    video_file_id = None

    if message.photo:
        photo_file_id = message.photo[-1].file_id
        await state.update_data(photo_file_id=photo_file_id)
    if message.video:
        video_file_id = message.video.file_id
        await state.update_data(video_file_id=video_file_id)
    
    # РџРѕР»СѓС‡Р°РµРј РєРѕР»РёС‡РµСЃС‚РІРѕ РїРѕР»СЊР·РѕРІР°С‚РµР»РµР№
    user_count = 0
    if DJANGO_INTEGRATION:
        try:
            import aiohttp
            api_url = 'http://127.0.0.1:8123/bot_management/api/statistics/'
            async with aiohttp.ClientSession() as session:
                async with session.get(api_url) as response:
                    if response.status == 200:
                        data = await response.json()
                        user_count = data.get('users', {}).get('total', 0)
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ СЃС‚Р°С‚РёСЃС‚РёРєРё: {e}")
    else:
        with get_db() as conn:
            result = conn.execute("SELECT COUNT(*) as count FROM users").fetchone()
            user_count = result['count'] if result else 0
    
    # РЎРѕС…СЂР°РЅСЏРµРј РґР°РЅРЅС‹Рµ
    await state.update_data(message_text=message_text, user_count=user_count, buttons=buttons)
    
    # РџРѕРєР°Р·С‹РІР°РµРј РїСЂРµРІСЊСЋ
    preview_text = f"""
рџ“ў <b>РџСЂРµРґРІР°СЂРёС‚РµР»СЊРЅС‹Р№ РїСЂРѕСЃРјРѕС‚СЂ СЂР°СЃСЃС‹Р»РєРё</b>

рџ‘Ґ <b>РџРѕР»СѓС‡Р°С‚РµР»РµР№:</b> <code>{user_count}</code> РїРѕР»СЊР·РѕРІР°С‚РµР»РµР№

рџ“ќ <b>РўРµРєСЃС‚ СЃРѕРѕР±С‰РµРЅРёСЏ:</b>
{message_text}

"""
    if buttons:
        preview_text += "\nрџ” <b>РљРЅРѕРїРєРё:</b>\n"
        for b in buttons:
            if 'url' in b:
                preview_text += f"вЂў {b['text']} в†’ {b['url']}\n"
            else:
                preview_text += f"вЂў {b['text']} (callback: {b['callback_data']})\n"

    preview_text += """

вљ пёЏ <b>Р’РЅРёРјР°РЅРёРµ:</b> Р Р°СЃСЃС‹Р»РєР° РЅР°С‡РЅРµС‚СЃСЏ СЃСЂР°Р·Сѓ РїРѕСЃР»Рµ РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ!
"""
    
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="вњ… РћС‚РїСЂР°РІРёС‚СЊ СЂР°СЃСЃС‹Р»РєСѓ", callback_data="confirm_broadcast")],
        [InlineKeyboardButton(text="вќЊ РћС‚РјРµРЅРёС‚СЊ", callback_data="admin_broadcast")]
    ])
    
    if video_file_id:
        await message.answer_video(
            video=video_file_id,
            caption=preview_text,
            parse_mode="HTML",
            reply_markup=kb
        )
    elif photo_file_id:
        await message.answer_photo(
            photo=photo_file_id,
            caption=preview_text,
            parse_mode="HTML",
            reply_markup=kb
        )
    else:
        await message.answer(preview_text, parse_mode="HTML", reply_markup=kb)
    
    await state.set_state(BroadcastState.waiting_confirmation)

@router.message(AdminState.waiting_user_id)
async def admin_handle_user_id(message: Message, state: FSMContext):
    """РћР±СЂР°Р±РѕС‚С‡РёРє РІРІРѕРґР° ID РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ РґР»СЏ Р°РґРјРёРЅРєРё Рё РґСЂСѓРіРёС… РґРµР№СЃС‚РІРёР№"""
    user_id = message.from_user.id
    
    if not is_admin(user_id):
        await message.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°")
        await state.clear()
        return
    
    # РџСЂРѕРІРµСЂСЏРµРј РѕС‚РјРµРЅСѓ
    if message.text and message.text.strip() == "/cancel":
        await message.answer("вќЊ РћРїРµСЂР°С†РёСЏ РѕС‚РјРµРЅРµРЅР°")
        await state.clear()
        return
    
    # РџСЂРѕРІРµСЂСЏРµРј, РєР°РєРѕРµ РґРµР№СЃС‚РІРёРµ РІС‹РїРѕР»РЅСЏРµС‚СЃСЏ
    data = await state.get_data()
    action = data.get('action')
    
    if action == 'edit_price':
        subscription_type = data.get('subscription_type')
        price_text = message.text.strip()
        
        try:
            price = int(price_text)
            if price <= 0:
                raise ValueError()
        except (ValueError, TypeError):
            await message.answer("вќЊ Р¦РµРЅР° РґРѕР»Р¶РЅР° Р±С‹С‚СЊ РїРѕР»РѕР¶РёС‚РµР»СЊРЅС‹Рј С†РµР»С‹Рј С‡РёСЃР»РѕРј. РџРѕРїСЂРѕР±СѓР№С‚Рµ СЃРЅРѕРІР° РёР»Рё РѕС‚РїСЂР°РІСЊС‚Рµ /cancel")
            return
        
        # РћР±РЅРѕРІР»СЏРµРј С†РµРЅСѓ
        try:
            import aiohttp
            
            api_url = 'http://127.0.0.1:8123/bot_management/api/prices/update/'
            
            async with aiohttp.ClientSession() as session:
                async with session.post(api_url, json={
                    'subscription_type': subscription_type,
                    'price': price
                }) as response:
                    if response.status == 200:
                        result = await response.json()
                        if result.get('success'):
                            await message.answer(f"вњ… Р¦РµРЅР° РґР»СЏ {subscription_type} РѕР±РЅРѕРІР»РµРЅР° РЅР° {price} в‚Ѕ")
                        else:
                            await message.answer(f"вќЊ РћС€РёР±РєР°: {result.get('message', 'РќРµРёР·РІРµСЃС‚РЅР°СЏ РѕС€РёР±РєР°')}")
                    else:
                        error_text = await response.text()
                        await message.answer(f"вќЊ РћС€РёР±РєР° СЃРµСЂРІРµСЂР°: {error_text}")
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° РѕР±РЅРѕРІР»РµРЅРёСЏ С†РµРЅС‹: {e}")
            await message.answer(f"вќЊ РћС€РёР±РєР°: {str(e)}")
        
        await state.clear()
        return
    
    elif action == 'edit_name':
        subscription_type = data.get('subscription_type')
        name = message.text.strip()
        
        if not name:
            await message.answer("вќЊ РќР°Р·РІР°РЅРёРµ РЅРµ РјРѕР¶РµС‚ Р±С‹С‚СЊ РїСѓСЃС‚С‹Рј. РџРѕРїСЂРѕР±СѓР№С‚Рµ СЃРЅРѕРІР° РёР»Рё РѕС‚РїСЂР°РІСЊС‚Рµ /cancel")
            return
        
        # РћР±РЅРѕРІР»СЏРµРј РЅР°Р·РІР°РЅРёРµ
        try:
            import aiohttp
            
            api_url = 'http://127.0.0.1:8123/bot_management/api/subscription/name/update/'
            
            async with aiohttp.ClientSession() as session:
                async with session.post(api_url, json={
                    'subscription_type': subscription_type,
                    'name': name
                }) as response:
                    if response.status == 200:
                        result = await response.json()
                        if result.get('success'):
                            await message.answer(f"вњ… РќР°Р·РІР°РЅРёРµ РґР»СЏ {subscription_type} РѕР±РЅРѕРІР»РµРЅРѕ РЅР° \"{name}\"")
                        else:
                            await message.answer(f"вќЊ РћС€РёР±РєР°: {result.get('message', 'РќРµРёР·РІРµСЃС‚РЅР°СЏ РѕС€РёР±РєР°')}")
                    else:
                        error_text = await response.text()
                        await message.answer(f"вќЊ РћС€РёР±РєР° СЃРµСЂРІРµСЂР°: {error_text}")
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° РѕР±РЅРѕРІР»РµРЅРёСЏ РЅР°Р·РІР°РЅРёСЏ: {e}")
            await message.answer(f"вќЊ РћС€РёР±РєР°: {str(e)}")
        
        await state.clear()
        return
    
    # РћР±СЂР°Р±РѕС‚РєР° РїРѕРёСЃРєР° РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ (РѕСЂРёРіРёРЅР°Р»СЊРЅР°СЏ Р»РѕРіРёРєР°)
    try:
        search_user_id = int(message.text.strip())
    except ValueError:
        await message.answer("вќЊ РџРѕР¶Р°Р»СѓР№СЃС‚Р°, РІРІРµРґРёС‚Рµ РєРѕСЂСЂРµРєС‚РЅС‹Р№ ID РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ (С‡РёСЃР»Рѕ)")
        return
    
    if not DJANGO_INTEGRATION:
        await message.answer("вќЊ РЎРёСЃС‚РµРјР° РЅРµРґРѕСЃС‚СѓРїРЅР°")
        await state.clear()
        return
    
    try:
        import aiohttp
        
        # РџРѕР»СѓС‡Р°РµРј РїСЂРѕС„РёР»СЊ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ
        api_url = f'http://127.0.0.1:8123/bot_management/api/users/{search_user_id}/profile/'
        
        async with aiohttp.ClientSession() as session:
            async with session.get(api_url) as response:
                if response.status == 200:
                    data = await response.json()
                    
                    if data.get('success'):
                        user_info = data.get('user', {})
                        first_name = user_info.get('first_name', 'РќРµ СѓРєР°Р·Р°РЅРѕ')
                        last_name = user_info.get('last_name') or ''
                        if last_name and last_name != 'None' and last_name.strip():
                            full_name = f"{first_name} {last_name}"
                        else:
                            full_name = first_name
                        
                        username = user_info.get('username', 'РќРµ СѓРєР°Р·Р°РЅ')
                        created_at = user_info.get('created_at', 'РќРµРёР·РІРµСЃС‚РЅРѕ')
                        referral_code = user_info.get('referral_code', 'РќРµ СЃРѕР·РґР°РЅ')
                        referrals_count = user_info.get('referrals_count', 0)
                        referral_balance = user_info.get('referral_balance', 0)
                        
                        user_text = f"""
рџ‘¤ <b>РџСЂРѕС„РёР»СЊ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ</b>

рџ†” <b>ID:</b> {search_user_id}
рџ‘¤ <b>РРјСЏ:</b> {full_name}
рџ“± <b>Username:</b> @{username}
рџ“… <b>Р”Р°С‚Р° СЂРµРіРёСЃС‚СЂР°С†РёРё:</b> {created_at}

рџ‘Ґ <b>Р РµС„РµСЂР°Р»СЊРЅР°СЏ РїСЂРѕРіСЂР°РјРјР°:</b>
рџЋЇ <b>РљРѕРґ:</b> {referral_code}
рџ“Љ <b>РџСЂРёРіР»Р°С€РµРЅРѕ:</b> {referrals_count}
рџ’° <b>Р РµС„РµСЂР°Р»СЊРЅС‹Р№ Р±Р°Р»Р°РЅСЃ:</b> {referral_balance} в‚Ѕ
"""
                    else:
                        user_text = f"вќЊ РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ СЃ ID {search_user_id} РЅРµ РЅР°Р№РґРµРЅ"
                else:
                    user_text = f"вќЊ РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ СЃ ID {search_user_id} РЅРµ РЅР°Р№РґРµРЅ"
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ РїСЂРѕС„РёР»СЏ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ: {e}")
        user_text = "вќЊ РћС€РёР±РєР° Р·Р°РіСЂСѓР·РєРё РґР°РЅРЅС‹С…"
    
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="рџ”Ќ РќР°Р№С‚Рё РґСЂСѓРіРѕРіРѕ", callback_data="admin_find_user")],
        [InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ РІ Р°РґРјРёРЅРєСѓ", callback_data="admin_panel")]
    ])
    
    await message.answer(user_text, parse_mode="HTML", reply_markup=kb)
    await state.clear()

@router.message(SupportState.in_chat)
async def support_message(message: Message, state: FSMContext):
    print(f"DEBUG: РџРѕР»СѓС‡РµРЅРѕ СЃРѕРѕР±С‰РµРЅРёРµ РІ РїРѕРґРґРµСЂР¶РєСѓ РѕС‚ {message.from_user.id}")
    print(f"DEBUG: РўРµРєСѓС‰РµРµ СЃРѕСЃС‚РѕСЏРЅРёРµ: {await state.get_state()}")
    
    data = await state.get_data()
    chat_id = data.get("chat_id")
    if not chat_id:
        print("DEBUG: chat_id РЅРµ РЅР°Р№РґРµРЅ РІ СЃРѕСЃС‚РѕСЏРЅРёРё!")
        await message.answer("вќЊ РћС€РёР±РєР°: РЅРµ СѓРґР°Р»РѕСЃСЊ РЅР°Р№С‚Рё С‡Р°С‚ РїРѕРґРґРµСЂР¶РєРё. РџРѕРїСЂРѕР±СѓР№С‚Рµ РЅР°С‡Р°С‚СЊ Р·Р°РЅРѕРІРѕ.")
        await state.clear()
        return
    
    # РћР±СЂР°Р±Р°С‚С‹РІР°РµРј С„РѕС‚Рѕ РІ РїРѕРґРґРµСЂР¶РєСѓ
    if message.photo:
        print(f"DEBUG: РџРѕР»СѓС‡РµРЅРѕ С„РѕС‚Рѕ РІ РїРѕРґРґРµСЂР¶РєСѓ РѕС‚ {message.from_user.id}")
        photo = message.photo[-1]
        
        # РЎРѕС…СЂР°РЅСЏРµРј СЃРѕРѕР±С‰РµРЅРёРµ СЃ С„РѕС‚Рѕ РІ Р±Р°Р·Сѓ (Р‘Р•Р—РћРџРђРЎРќРћ)
        await save_support_message_safe(chat_id, 'user', message.caption or "рџ“ё Р¤РѕС‚Рѕ", photo.file_id)
        
        # РЈРІРµРґРѕРјР»СЏРµРј С‚РѕР»СЊРєРѕ РІ РіСЂСѓРїРїСѓ РїРѕРґРґРµСЂР¶РєРё
        if SUPPORT_GROUP_ID:
            try:
                # Р¤РѕСЂРјР°С‚РёСЂСѓРµРј РёРјСЏ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ - РµСЃР»Рё РµСЃС‚СЊ С„Р°РјРёР»РёСЏ, РґРѕР±Р°РІР»СЏРµРј РµС‘
                if message.from_user.username:
                    user_info = f"@{message.from_user.username}"
                else:
                    first_name = message.from_user.first_name or ''
                    last_name = message.from_user.last_name or ''
                    if last_name and last_name != 'None' and last_name.strip():
                        user_info = f"{first_name} {last_name}"
                    elif first_name:
                        user_info = first_name
                    else:
                        user_info = f"ID{message.from_user.id}"
                
                await bot.send_photo(
                    SUPPORT_GROUP_ID,
                    photo=photo.file_id,
                    caption=f"""
рџ“ё <b>Р¤РѕС‚Рѕ РѕС‚ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ РІ РїРѕРґРґРµСЂР¶РєСѓ</b>

рџ‘¤ <b>РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ:</b> {user_info}
рџ†” <b>ID С‡Р°С‚Р°:</b> {chat_id}
рџ“ќ <b>РџРѕРґРїРёСЃСЊ:</b> {message.caption or 'Р‘РµР· РїРѕРґРїРёСЃРё'}

<i>РћС‚РІРµС‚СЊС‚Рµ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ С‡РµСЂРµР· Р°РґРјРёРЅ РїР°РЅРµР»СЊ</i>
""",
                    parse_mode="HTML"
                )
            except Exception as e:
                logging.error(f"РћС€РёР±РєР° СѓРІРµРґРѕРјР»РµРЅРёСЏ РІ РіСЂСѓРїРїСѓ РїРѕРґРґРµСЂР¶РєРё: {e}")
        
        # РџРѕРґС‚РІРµСЂР¶РґР°РµРј РїРѕР»СѓС‡РµРЅРёРµ С„РѕС‚Рѕ
        await message.answer("""
вњ… <b>Р¤РѕС‚Рѕ РѕС‚РїСЂР°РІР»РµРЅРѕ РІ РїРѕРґРґРµСЂР¶РєСѓ!</b>

