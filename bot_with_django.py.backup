@router.callback_query(F.data == "my_keys")
async def show_my_keys(callback: CallbackQuery):
    """РџРѕРєР°Р·Р°С‚СЊ РјРµРЅСЋ РІС‹Р±РѕСЂР° С‚РёРїР° VPN РґР»СЏ РїСЂРѕСЃРјРѕС‚СЂР° РєР»СЋС‡РµР№"""
    user_id = callback.from_user.id

    if DJANGO_INTEGRATION:
        try:
            import aiohttp

            # Р—Р°РїСЂРѕСЃ Рє API РґР»СЏ РїРѕР»СѓС‡РµРЅРёСЏ РєР»СЋС‡РµР№ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ
            api_url = f'http://127.0.0.1:8123/bot_management/api/users/{user_id}/keys/'

            async with aiohttp.ClientSession() as session:
                async with session.get(api_url) as response:
                    if response.status == 200:
                        data = await response.json()

                        if data.get('success') and data.get('keys'):
                            # РЎС‡РёС‚Р°РµРј РєРѕР»РёС‡РµСЃС‚РІРѕ РєР»СЋС‡РµР№ РєР°Р¶РґРѕРіРѕ С‚РёРїР°
                            regular_count = sum(1 for key in data['keys'] if key.get('vpn_type') == 'regular')
                            night_count = len(data['keys']) - regular_count
                            
                            keys_text = "рџ”‘ <b>Р’Р°С€Рё РєР»СЋС‡Рё РїРѕРґРїРёСЃРєРё</b>\n\n"
                            
                            if regular_count > 0:
                                keys_text += f"рџЊЌ <b>РћР±С‹С‡РЅС‹Р№ VPN:</b> {regular_count} РєР»СЋС‡(Р°)\n"
                            if night_count > 0:
                                keys_text += f"рџЊ™ <b>Night VPN:</b> {night_count} РєР»СЋС‡(Р°)\n"
                            
                            if regular_count == 0 and night_count == 0:
                                keys_text += "\nрџ“­ <b>РЈ РІР°СЃ РїРѕРєР° РЅРµС‚ РєР»СЋС‡РµР№</b>"

                            kb = InlineKeyboardMarkup(inline_keyboard=[
                                [InlineKeyboardButton(text=f"рџЊЌ РћР±С‹С‡РЅС‹Р№ VPN ({regular_count})", callback_data="my_keys_regular")],
                                [InlineKeyboardButton(text=f"рџЊ™ Night VPN ({night_count})", callback_data="my_keys_night")],
                                [InlineKeyboardButton(text="рџ”„ РћР±РЅРѕРІРёС‚СЊ", callback_data="my_keys")],
                                [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
                            ])

                            await send_or_edit_message_with_photo(callback, keys_text, reply_markup=kb, edit_message=True, image_name="my_keys.png")
                        else:
                            # РќРµС‚ РєР»СЋС‡РµР№
                            no_keys_text = """
рџ”‘ <b>Р’Р°С€Рё РєР»СЋС‡Рё РїРѕРґРїРёСЃРєРё</b>

рџ“­ <b>РЈ РІР°СЃ РїРѕРєР° РЅРµС‚ РєР»СЋС‡РµР№</b>

рџ’Ў <b>РљР°Рє РїРѕР»СѓС‡РёС‚СЊ РєР»СЋС‡:</b>
вЂў Р’С‹Р±РµСЂРёС‚Рµ РїРѕРґС…РѕРґСЏС‰СѓСЋ РїРѕРґРїРёСЃРєСѓ
вЂў РћРїР»Р°С‚РёС‚Рµ С‡РµСЂРµР· Р±РµР·РѕРїР°СЃРЅСѓСЋ РїР»Р°С‚РµР¶РЅСѓСЋ СЃРёСЃС‚РµРјСѓ
вЂў РџРѕР»СѓС‡РёС‚Рµ РєР»СЋС‡ Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРё
"""

                            kb = InlineKeyboardMarkup(inline_keyboard=[
                                [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
                            ])

                            await send_or_edit_message_with_photo(callback, no_keys_text, reply_markup=kb, edit_message=True, image_name="my_keys.png")
                        [InlineKeyboardButton(text="рџ”„ РћР±РЅРѕРІРёС‚СЊ", callback_data="my_keys")],
                        [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
                    ])
                    await send_or_edit_message_with_photo(callback, "вќЊ <b>РћС€РёР±РєР° API</b>\n\nРџРѕРїСЂРѕР±СѓР№С‚Рµ РїРѕР·Р¶Рµ.", reply_markup=kb, edit_message=True, image_name="my_keys.png")
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° РїРѕРєР°Р·Р° РєР»СЋС‡РµР№: {e}")
            await send_or_edit_message_with_photo(callback, "вќЊ <b>РћС€РёР±РєР° Р·Р°РіСЂСѓР·РєРё РєР»СЋС‡РµР№</b>\n\nРџРѕРїСЂРѕР±СѓР№С‚Рµ РїРѕР·Р¶Рµ.", reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="рџ”„ РћР±РЅРѕРІРёС‚СЊ", callback_data="my_keys")],
                [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
            ]), edit_message=True, image_name="my_keys.png")
    else:
        await send_or_edit_message_with_photo(callback, "вќЊ <b>Django РёРЅС‚РµРіСЂР°С†РёСЏ РЅРµРґРѕСЃС‚СѓРїРЅР°</b>", edit_message=True, image_name="my_keys.png")


@router.callback_query(F.data == "my_keys_regular")
async def show_my_keys_regular(callback: CallbackQuery):
    """РџРѕРєР°Р·Р°С‚СЊ РєР»СЋС‡Рё РћР±С‹С‡РЅРѕРіРѕ VPN"""
    user_id = callback.from_user.id

    if DJANGO_INTEGRATION:
        try:
            import aiohttp

            api_url = f'http://127.0.0.1:8123/bot_management/api/users/{user_id}/keys/'

            async with aiohttp.ClientSession() as session:
                async with session.get(api_url) as response:
                    if response.status == 200:
                        data = await response.json()

                        if data.get('success') and data.get('keys'):
                            # Р¤РёР»СЊС‚СЂСѓРµРј С‚РѕР»СЊРєРѕ РћР±С‹С‡РЅС‹Р№ VPN
                            regular_keys = [key for key in data['keys'] if key.get('vpn_type') == 'regular']

                            if regular_keys:
                                keys_text = "рџЊЌ <b>РћР±С‹С‡РЅС‹Р№ VPN - Р’Р°С€Рё РєР»СЋС‡Рё</b>\n\n"
                                kb_buttons = []

                                for i, key in enumerate(regular_keys, 1):
                                    sub_type = key.get('subscription_type_display', key.get('subscription_type', 'РќРµРёР·РІРµСЃС‚РЅРѕ'))
                                    payment_id = key.get('payment_id', i)

                                    from datetime import datetime
                                    try:
                                        purchase_date = datetime.fromisoformat(key['created_at'].replace('Z', '+00:00'))
                                        formatted_date = purchase_date.strftime('%d.%m.%Y')
                                    except:
                                        formatted_date = "РќРµРёР·РІРµСЃС‚РЅРѕ"

                                    button_text = f"рџЊЌ {i}. {sub_type} ({formatted_date})"
                                    if len(button_text) > 64:
                                        button_text = button_text[:61] + "..."

                                    kb_buttons.append([InlineKeyboardButton(
                                        text=button_text,
                                        callback_data=f"key_detail:{payment_id}"
                                    )])

                                kb_buttons.append([
                                    InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ", callback_data="my_keys"),
                                    InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")
                                ])

                                kb = InlineKeyboardMarkup(inline_keyboard=kb_buttons)
                                await send_or_edit_message_with_photo(callback, keys_text, reply_markup=kb, edit_message=True, image_name="my_keys.png")
                            else:
                                await send_or_edit_message_with_photo(callback, "рџ“­ <b>РЈ РІР°СЃ РЅРµС‚ РєР»СЋС‡РµР№ РћР±С‹С‡РЅРѕРіРѕ VPN</b>", reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                                    [InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ", callback_data="my_keys")],
                                    [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
                                ]), edit_message=True, image_name="my_keys.png")
                        else:
                            await send_or_edit_message_with_photo(callback, "вќЊ <b>РћС€РёР±РєР° Р·Р°РіСЂСѓР·РєРё РєР»СЋС‡РµР№</b>", reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                                [InlineKeyboardButton(text="рџ”„ РћР±РЅРѕРІРёС‚СЊ", callback_data="my_keys_regular")],
                                [InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ", callback_data="my_keys")]
                            ]), edit_message=True, image_name="my_keys.png")
                    else:
                        await send_or_edit_message_with_photo(callback, "вќЊ <b>РћС€РёР±РєР° API</b>", reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                            [InlineKeyboardButton(text="рџ”„ РџРѕРїСЂРѕР±РѕРІР°С‚СЊ СЃРЅРѕРІР°", callback_data="my_keys_regular")],
                            [InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ", callback_data="my_keys")]
                        ]), edit_message=True, image_name="my_keys.png")
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° РїРѕРєР°Р·Р° РєР»СЋС‡РµР№ РћР±С‹С‡РЅРѕРіРѕ VPN: {e}")
            await send_or_edit_message_with_photo(callback, "вќЊ <b>РћС€РёР±РєР° Р·Р°РіСЂСѓР·РєРё РєР»СЋС‡РµР№</b>\n\nРџРѕРїСЂРѕР±СѓР№С‚Рµ РїРѕР·Р¶Рµ.", reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="рџ”„ РћР±РЅРѕРІРёС‚СЊ", callback_data="my_keys_regular")],
                [InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ", callback_data="my_keys")]
            ]), edit_message=True, image_name="my_keys.png")
    else:
        await send_or_edit_message_with_photo(callback, "вќЊ <b>Django РёРЅС‚РµРіСЂР°С†РёСЏ РЅРµРґРѕСЃС‚СѓРїРЅР°</b>", edit_message=True, image_name="my_keys.png")


