# РћР±СЂР°Р±РѕС‚С‡РёРє РґР»СЏ СЂРµРєРІРёР·РёС‚РѕРІ РІС‹РІРѕРґР° СЃСЂРµРґСЃС‚РІ
@router.message(WithdrawalState.waiting_payment_details)
async def handle_withdrawal_details(message: Message, state: FSMContext):
    """РћР±СЂР°Р±РѕС‚РєР° СЂРµРєРІРёР·РёС‚РѕРІ РґР»СЏ РІС‹РІРѕРґР° СЃСЂРµРґСЃС‚РІ"""
    user_id = message.from_user.id
    payment_details = message.text.strip()
    
    if not payment_details:
        await message.answer("вќЊ РџРѕР¶Р°Р»СѓР№СЃС‚Р°, РІРІРµРґРёС‚Рµ СЂРµРєРІРёР·РёС‚С‹ РґР»СЏ РІС‹РїР»Р°С‚С‹")
        return
    
    # РџРѕР»СѓС‡Р°РµРј РґР°РЅРЅС‹Рµ РёР· СЃРѕСЃС‚РѕСЏРЅРёСЏ
    data = await state.get_data()
    withdrawal_method = data.get('withdrawal_method')
    
    if not withdrawal_method:
        await message.answer("вќЊ РћС€РёР±РєР°: СЃРїРѕСЃРѕР± РІС‹РїР»Р°С‚С‹ РЅРµ РІС‹Р±СЂР°РЅ")
        await state.clear()
        return
    
    # Р—Р°РїСЂР°С€РёРІР°РµРј СЃСѓРјРјСѓ РґР»СЏ РІС‹РІРѕРґР°
    method_names = {
        "bank_card": "Р‘Р°РЅРєРѕРІСЃРєР°СЏ РєР°СЂС‚Р°",
        "yoomoney": "Р®Money",
        "sberbank": "РЎР±РµСЂР±Р°РЅРє",
        "tinkoff": "РўРёРЅСЊРєРѕС„С„"
    }
    
    method_name = method_names.get(withdrawal_method, withdrawal_method)
    
    # РЎРѕС…СЂР°РЅСЏРµРј СЂРµРєРІРёР·РёС‚С‹
    await state.update_data(payment_details=payment_details)
    
    # РџРѕР»СѓС‡Р°РµРј СЂРµС„РµСЂР°Р»СЊРЅС‹Р№ Р±Р°Р»Р°РЅСЃ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ
    referral_balance = 0
    if DJANGO_INTEGRATION:
        try:
            import aiohttp
            
            api_url = f'http://127.0.0.1:8123/bot_management/api/referral/balance/{user_id}/'
            
            async with aiohttp.ClientSession() as session:
                async with session.get(api_url) as response:
                    if response.status == 200:
                        data = await response.json()
                        if data.get('success'):
                            referral_balance = data.get('referral_balance', 0)
        except Exception as e:
            print(f"РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ СЂРµС„РµСЂР°Р»СЊРЅРѕРіРѕ Р±Р°Р»Р°РЅСЃР°: {e}")
    
    text = f"""
рџ’° <b>РџРѕРґС‚РІРµСЂР¶РґРµРЅРёРµ Р·Р°РїСЂРѕСЃР° РЅР° РІС‹РІРѕРґ</b>

рџ’і <b>РЎРїРѕСЃРѕР± РІС‹РїР»Р°С‚С‹:</b> {method_name}
рџ“ќ <b>Р РµРєРІРёР·РёС‚С‹:</b> {payment_details}

рџ’µ <b>Р’РІРµРґРёС‚Рµ СЃСѓРјРјСѓ РґР»СЏ РІС‹РІРѕРґР° (РјРёРЅРёРјСѓРј 500 в‚Ѕ):</b>

рџ’° <b>Р’Р°С€ СЂРµС„РµСЂР°Р»СЊРЅС‹Р№ Р±Р°Р»Р°РЅСЃ:</b> {referral_balance} в‚Ѕ
"""
    
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="вќЊ РћС‚РјРµРЅРёС‚СЊ", callback_data="referral_withdrawal")]
    ])
    
    await message.answer(text, reply_markup=kb, parse_mode="HTML")
    
    # РџРµСЂРµС…РѕРґРёРј Рє СЃРѕСЃС‚РѕСЏРЅРёСЋ РѕР¶РёРґР°РЅРёСЏ СЃСѓРјРјС‹
    await state.set_state(WithdrawalState.waiting_amount)


@router.message(WithdrawalState.waiting_amount)
async def handle_withdrawal_amount(message: Message, state: FSMContext):
    """РћР±СЂР°Р±РѕС‚РєР° СЃСѓРјРјС‹ РґР»СЏ РІС‹РІРѕРґР° СЃСЂРµРґСЃС‚РІ"""
    user_id = message.from_user.id
    
    try:
        amount = float(message.text.strip())
    except ValueError:
        await message.answer("вќЊ РџРѕР¶Р°Р»СѓР№СЃС‚Р°, РІРІРµРґРёС‚Рµ РєРѕСЂСЂРµРєС‚РЅСѓСЋ СЃСѓРјРјСѓ (РЅР°РїСЂРёРјРµСЂ: 500)")
        return
    
    # РџСЂРѕРІРµСЂСЏРµРј РјРёРЅРёРјР°Р»СЊРЅСѓСЋ СЃСѓРјРјСѓ
    min_withdrawal = 500
    if amount < min_withdrawal:
        await message.answer(f"вќЊ РњРёРЅРёРјР°Р»СЊРЅР°СЏ СЃСѓРјРјР° РґР»СЏ РІС‹РІРѕРґР°: {min_withdrawal} в‚Ѕ")
        return
    
    # РџРѕР»СѓС‡Р°РµРј РґР°РЅРЅС‹Рµ РёР· СЃРѕСЃС‚РѕСЏРЅРёСЏ
    data = await state.get_data()
    withdrawal_method = data.get('withdrawal_method')
    payment_details = data.get('payment_details')
    
    if not withdrawal_method or not payment_details:
        await message.answer("вќЊ РћС€РёР±РєР°: РґР°РЅРЅС‹Рµ РЅРµ СЃРѕС…СЂР°РЅРµРЅС‹")
        await state.clear()
        return
    
    method_names = {
        "bank_card": "Р‘Р°РЅРєРѕРІСЃРєР°СЏ РєР°СЂС‚Р°",
        "yoomoney": "Р®Money",
        "sberbank": "РЎР±РµСЂР±Р°РЅРє",
        "tinkoff": "РўРёРЅСЊРєРѕС„С„"
    }
    
    method_name = method_names.get(withdrawal_method, withdrawal_method)
    
    # РћС‚РїСЂР°РІР»СЏРµРј Р·Р°РїСЂРѕСЃ РЅР° РІС‹РІРѕРґ
    if DJANGO_INTEGRATION:
        try:
            import aiohttp
            
            api_url = 'http://127.0.0.1:8123/bot_management/api/referral/withdrawal/request/'
            
            async with aiohttp.ClientSession() as session:
                async with session.post(api_url, json={
                    'user_id': user_id,
                    'amount': amount,
                    'payment_method': withdrawal_method,
                    'payment_details': payment_details
                }) as response:
                    if response.status == 200:
                        data = await response.json()
                        
                        if data.get('success'):
                            text = f"""
вњ… <b>Р—Р°РїСЂРѕСЃ РЅР° РІС‹РІРѕРґ СЃРѕР·РґР°РЅ!</b>

рџ’° <b>РЎСѓРјРјР°:</b> {amount} в‚Ѕ
рџ’і <b>РЎРїРѕСЃРѕР± РІС‹РїР»Р°С‚С‹:</b> {method_name}
рџ“ќ <b>Р РµРєРІРёР·РёС‚С‹:</b> {payment_details}

вЏі <b>Р’Р°С€ Р·Р°РїСЂРѕСЃ РѕС‚РїСЂР°РІР»РµРЅ РЅР° СЂР°СЃСЃРјРѕС‚СЂРµРЅРёРµ Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂСѓ</b>

рџ“‹ <b>РЎС‚Р°С‚СѓСЃ:</b> Р’ РѕР¶РёРґР°РЅРёРё
вЏ° <b>Р’СЂРµРјСЏ РѕР±СЂР°Р±РѕС‚РєРё:</b> РґРѕ 24 С‡Р°СЃРѕРІ

рџ’Ў <b>Р’С‹ РїРѕР»СѓС‡РёС‚Рµ СѓРІРµРґРѕРјР»РµРЅРёРµ РѕР± РёР·РјРµРЅРµРЅРёРё СЃС‚Р°С‚СѓСЃР°</b>
"""
                            
                            kb = InlineKeyboardMarkup(inline_keyboard=[
                                [InlineKeyboardButton(text="рџ“‹ РџСЂРѕРІРµСЂРёС‚СЊ СЃС‚Р°С‚СѓСЃ", callback_data="referral_withdrawal")],
                                [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
                            ])
                            
                            await message.answer(text, reply_markup=kb, parse_mode="HTML")
                            
                            # РћС‚РїСЂР°РІР»СЏРµРј СѓРІРµРґРѕРјР»РµРЅРёРµ Рѕ РЅРѕРІРѕР№ Р·Р°СЏРІРєРµ
                            withdrawal_data = {
                                'user_id': user_id,
                                'amount': amount,
                                'payment_method': withdrawal_method,
                                'payment_details': payment_details,
                                'username': message.from_user.username,
                                'first_name': message.from_user.first_name
                            }
                            await send_withdrawal_notification('new_request', withdrawal_data)
                        else:
                            error_message = data.get('message', 'РќРµРёР·РІРµСЃС‚РЅР°СЏ РѕС€РёР±РєР°')
                            await message.answer(f"вќЊ РћС€РёР±РєР° СЃРѕР·РґР°РЅРёСЏ Р·Р°РїСЂРѕСЃР°: {error_message}")
                    else:
                        await message.answer("вќЊ РћС€РёР±РєР° СЃРµСЂРІРµСЂР° РїСЂРё СЃРѕР·РґР°РЅРёРё Р·Р°РїСЂРѕСЃР°")
        except Exception as e:
            print(f"РћС€РёР±РєР° СЃРѕР·РґР°РЅРёСЏ Р·Р°РїСЂРѕСЃР° РЅР° РІС‹РІРѕРґ: {e}")
            await message.answer("вќЊ РћС€РёР±РєР° СЃРѕР·РґР°РЅРёСЏ Р·Р°РїСЂРѕСЃР°")
    else:
        await message.answer("вќЊ РЎРёСЃС‚РµРјР° РЅРµРґРѕСЃС‚СѓРїРЅР°")
    
    # РћС‡РёС‰Р°РµРј СЃРѕСЃС‚РѕСЏРЅРёРµ
    await state.clear()



# РЈРЅРёРІРµСЂСЃР°Р»СЊРЅС‹Р№ РѕР±СЂР°Р±РѕС‚С‡РёРє РґР»СЏ РЅРµРёР·РІРµСЃС‚РЅС‹С… РєРѕРјР°РЅРґ
@router.message()
async def handle_unknown_message(message: Message, state: FSMContext):
    """РћР±СЂР°Р±РѕС‚С‡РёРє РґР»СЏ РІСЃРµС… РЅРµРёР·РІРµСЃС‚РЅС‹С… СЃРѕРѕР±С‰РµРЅРёР№"""
    # РџСЂРѕРїСѓСЃРєР°РµРј СЃРѕРѕР±С‰РµРЅРёСЏ, РµСЃР»Рё РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ РЅР°С…РѕРґРёС‚СЃСЏ РІ СЃРѕСЃС‚РѕСЏРЅРёРё СЂР°СЃСЃС‹Р»РєРё РёР»Рё Р·Р°РіСЂСѓР·РєРё РєР»СЋС‡РµР№
    current_state = await state.get_state()
    if current_state == BroadcastState.waiting_message or current_state == BroadcastState.waiting_confirmation:
        return
    
    # РџСЂРѕРїСѓСЃРєР°РµРј СЃРѕРѕР±С‰РµРЅРёСЏ, РµСЃР»Рё РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ РЅР°С…РѕРґРёС‚СЃСЏ РІ СЃРѕСЃС‚РѕСЏРЅРёРё Р·Р°РіСЂСѓР·РєРё РєР»СЋС‡РµР№
    if current_state == UploadKeysState.waiting_keys:
        return
    
    await message.answer("рџ¤– РЇ РЅРµ Р·РЅР°СЋ С‚Р°РєРѕР№ РєРѕРјР°РЅРґС‹. РСЃРїРѕР»СЊР·СѓР№С‚Рµ /start РґР»СЏ РґРѕСЃС‚СѓРїР° Рє РіР»Р°РІРЅРѕРјСѓ РјРµРЅСЋ.")


# --- РђРґРјРёРЅ-РїР°РЅРµР»СЊ РѕР±СЂР°Р±РѕС‚С‡РёРєРё ---

@router.callback_query(F.data == "admin_stats")
async def admin_stats_handler(callback: CallbackQuery):
    """РћР±СЂР°Р±РѕС‚С‡РёРє СЃС‚Р°С‚РёСЃС‚РёРєРё РґР»СЏ Р°РґРјРёРЅРєРё"""
    user_id = callback.from_user.id
    
    if not is_admin(user_id):
        await callback.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°", show_alert=True)
        return
    
    if not DJANGO_INTEGRATION:
        await callback.answer("вќЊ РЎРёСЃС‚РµРјР° РЅРµРґРѕСЃС‚СѓРїРЅР°", show_alert=True)
        return
    
    try:
        import aiohttp
        
        api_url = 'http://127.0.0.1:8123/bot_management/api/statistics/'
        
        async with aiohttp.ClientSession() as session:
            async with session.get(api_url) as response:
                if response.status == 200:
                    data = await response.json()
                    
                    users = data.get('users', {})
                    payments = data.get('payments', {})
                    keys = data.get('keys', {})
                    
                    stats_text = f"""
рџ“Љ <b>РЎС‚Р°С‚РёСЃС‚РёРєР° СЃРёСЃС‚РµРјС‹</b>

рџ‘Ґ <b>РџРѕР»СЊР·РѕРІР°С‚РµР»Рё:</b>
вЂў Р’СЃРµРіРѕ: <b>{users.get('total', 0)}</b>
вЂў РќРѕРІС‹С… СЃРµРіРѕРґРЅСЏ: <b>{users.get('new_today', 0)}</b>
вЂў РќРѕРІС‹С… Р·Р° РЅРµРґРµР»СЋ: <b>{users.get('new_week', 0)}</b>

рџ’і <b>РџР»Р°С‚РµР¶Рё:</b>
вЂў Р’СЃРµРіРѕ: <b>{payments.get('total', 0)}</b>
вЂў РћР¶РёРґР°СЋС‚ РѕР±СЂР°Р±РѕС‚РєРё: <b>{payments.get('pending', 0)}</b>
вЂў РЈСЃРїРµС€РЅС‹С…: <b>{payments.get('succeeded', 0)}</b>
вЂў Р’С‹СЂСѓС‡РєР°: <b>{payments.get('revenue', 0):.2f} в‚Ѕ</b>
вЂў <b>Р—Р° СЃРµРіРѕРґРЅСЏ:</b> {payments.get('revenue_today', 0):.2f} в‚Ѕ

рџ”‘ <b>РљР»СЋС‡Рё:</b>
вЂў Р’СЃРµРіРѕ РєР»СЋС‡РµР№: <b>{keys.get('total', 0)}</b>
вЂў Р”РѕСЃС‚СѓРїРЅРѕ: <b>{keys.get('available', 0)}</b>
"""
                else:
                    stats_text = "вќЊ <b>РћС€РёР±РєР° Р·Р°РіСЂСѓР·РєРё СЃС‚Р°С‚РёСЃС‚РёРєРё</b>"
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ СЃС‚Р°С‚РёСЃС‚РёРєРё: {e}")
        stats_text = "вќЊ <b>РћС€РёР±РєР° Р·Р°РіСЂСѓР·РєРё РґР°РЅРЅС‹С…</b>"
    
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="рџ”„ РћР±РЅРѕРІРёС‚СЊ", callback_data="admin_stats")],
        [InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ РІ Р°РґРјРёРЅРєСѓ", callback_data="admin_panel")]
    ])
    
    try:
        await callback.message.edit_text(stats_text, parse_mode="HTML", reply_markup=kb)
    except:
        await callback.message.answer(stats_text, parse_mode="HTML", reply_markup=kb)
    
    await callback.answer()

