"""

        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="рџ›  РџРѕРґРґРµСЂР¶РєР°", url="https://t.me/yamalube61")],
            [InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ", callback_data="get_key_menu")]
        ])

        await send_or_edit_message_with_photo(callback, error_text, reply_markup=kb, edit_message=True, image_name="catalog.png")
    else:
        await send_or_edit_message_with_photo(callback, "вќЊ РЎРёСЃС‚РµРјР° РЅРµРґРѕСЃС‚СѓРїРЅР°. РџРѕРїСЂРѕР±СѓР№С‚Рµ РїРѕР·Р¶Рµ.", edit_message=True, image_name="catalog.png")


