@router.callback_query(F.data.startswith("pay_sbp_"))
async def pay_with_sbp(callback: CallbackQuery):
    """РћР±СЂР°Р±РѕС‚РєР° РѕРїР»Р°С‚С‹ РїРѕ РЎР‘Рџ (СЂСѓС‡РЅР°СЏ)"""
    user_id = callback.from_user.id

    # РР·РІР»РµРєР°РµРј С‚РёРї РїРѕРґРїРёСЃРєРё Рё vpn_type
    # Р¤РѕСЂРјР°С‚: pay_sbp_{sub_type}_{vpn_type} РёР»Рё pay_sbp_{sub_type} (СЃС‚Р°СЂС‹Р№ С„РѕСЂРјР°С‚)
    parts = callback.data.replace("pay_sbp_", "").split("_")
    
    if len(parts) >= 2 and parts[-1] in ['night', 'regular']:
        vpn_type = parts.pop()
        subscription_type = "_".join(parts)
    else:
        vpn_type = 'night'
        subscription_type = callback.data.replace("pay_sbp_", "")

    # РџСЂРѕРІРµСЂСЏРµРј С‚РёРї РїРѕРґРїРёСЃРєРё РІ Р·Р°РІРёСЃРёРјРѕСЃС‚Рё РѕС‚ VPN
