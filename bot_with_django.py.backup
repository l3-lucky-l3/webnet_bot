    else:
        # Р•СЃР»Рё Django РЅРµРґРѕСЃС‚СѓРїРµРЅ, СЃРѕС…СЂР°РЅСЏРµРј С‚РѕР»СЊРєРѕ РІ SQLite Рё РѕС‚РїСЂР°РІР»СЏРµРј СѓРІРµРґРѕРјР»РµРЅРёСЏ
        with get_db() as conn:
