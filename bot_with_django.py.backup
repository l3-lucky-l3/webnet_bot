                                await callback.message.answer(key_detail_text, parse_mode="HTML", reply_markup=kb)
                                await callback.answer()
                            else:
                                await callback.answer("вќЊ РљР»СЋС‡ РЅРµ РЅР°Р№РґРµРЅ", show_alert=True)
                        else:
