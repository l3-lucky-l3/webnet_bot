@router.callback_query(F.data.startswith("pay_bank_card_"))
async def pay_with_bank_card(callback: CallbackQuery):
    """РћР±СЂР°Р±РѕС‚РєР° РѕРїР»Р°С‚С‹ Р±Р°РЅРєРѕРІСЃРєРѕР№ РєР°СЂС‚РѕР№"""
    user_id = callback.from_user.id

    # РР·РІР»РµРєР°РµРј С‚РёРї РїРѕРґРїРёСЃРєРё Рё vpn_type
    # Р¤РѕСЂРјР°С‚: pay_bank_card_{sub_type}_{vpn_type} РёР»Рё pay_bank_card_{sub_type} (СЃС‚Р°СЂС‹Р№ С„РѕСЂРјР°С‚)
    parts = callback.data.replace("pay_bank_card_", "").split("_")
    
    if len(parts) >= 2 and parts[-1] in ['night', 'regular']:
        vpn_type = parts.pop()
        subscription_type = "_".join(parts)
    else:
        vpn_type = 'night'
        subscription_type = callback.data.replace("pay_bank_card_", "")

    # РџСЂРѕРІРµСЂСЏРµРј С‚РёРї РїРѕРґРїРёСЃРєРё РІ Р·Р°РІРёСЃРёРјРѕСЃС‚Рё РѕС‚ VPN
    if vpn_type == 'regular':
        valid_types = ['day', 'month', '3months', '6months', 'year', '2years']
        if subscription_type not in valid_types:
            await callback.answer("вќЊ РќРµРІРµСЂРЅС‹Р№ С‚РёРї РїРѕРґРїРёСЃРєРё", show_alert=True)
            return
        amount = REGULAR_VPN_PRICES.get(subscription_type, 0)
    else:
        valid_types = ['trial', 'month', '3months', '6months', 'year']
        if subscription_type not in valid_types:
            await callback.answer("вќЊ РќРµРІРµСЂРЅС‹Р№ С‚РёРї РїРѕРґРїРёСЃРєРё", show_alert=True)
            return
        # РџРѕР»СѓС‡Р°РµРј С†РµРЅСѓ РёР· Р±Р°Р·С‹ РґР°РЅРЅС‹С… РґР»СЏ Night VPN
        try:
            import aiohttp
            api_url = 'http://127.0.0.1:8123/bot_management/api/prices/get/'
            async with aiohttp.ClientSession() as session:
                async with session.get(api_url) as response:
                    if response.status == 200:
                        data = await response.json()
                        prices = data.get('prices', {})
                        amount = prices.get(subscription_type, PRICES.get(subscription_type, 0))
                    else:
                        amount = PRICES.get(subscription_type, 0)
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ С†РµРЅС‹: {e}")
            amount = PRICES.get(subscription_type, 0)

    # РћРїСЂРµРґРµР»СЏРµРј РЅР°Р·РІР°РЅРёРµ РїРѕРґРїРёСЃРєРё
    sub_names = {
        'day': '1 РґРµРЅСЊ',
        'month': '1 РјРµСЃСЏС†',
        '3months': '3 РјРµСЃСЏС†Р°',
        '6months': '6 РјРµСЃСЏС†РµРІ',
        'year': '1 РіРѕРґ',
        '2years': '2 РіРѕРґР°'
    }
    sub_name = sub_names.get(subscription_type, 'РџРѕРґРїРёСЃРєР°')
    vpn_label = "рџЊЌ РћР±С‹С‡РЅС‹Р№ VPN" if vpn_type == 'regular' else "рџЊ™ Night VPN"

    # РЎРѕР·РґР°РµРј РїР»Р°С‚РµР¶
    if DJANGO_INTEGRATION:
        if vpn_type == 'regular':
            # Р”Р»СЏ РћР±С‹С‡РЅРѕРіРѕ VPN СЃРѕР·РґР°РµРј РїР»Р°С‚РµР¶ СЃ vpn_type='regular'
            payment_data = await create_platega_payment(
                user_id=user_id,
                subscription_type=f'regular_{subscription_type}',
                amount=amount,
                return_url=None,
                payment_method=11,  # Р‘Р°РЅРєРѕРІСЃРєР°СЏ РєР°СЂС‚Р°
                vpn_type='regular'  # РўРёРї VPN
            )

            if payment_data:
                keyboard = InlineKeyboardMarkup(inline_keyboard=[
                    [InlineKeyboardButton(text="рџ’і РћРїР»Р°С‚РёС‚СЊ РєР°СЂС‚РѕР№", url=payment_data['confirmation_url'])],
