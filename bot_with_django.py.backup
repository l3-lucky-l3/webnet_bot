        await callback.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°", show_alert=True)
        return
    
    await callback.message.answer(
        "рџ”Ќ <b>РџРѕРёСЃРє СЂРµС„РµСЂРµСЂРѕРІ</b>\n\n"
        "Р’РІРµРґРёС‚Рµ username, РёРјСЏ, С„Р°РјРёР»РёСЋ РёР»Рё ID РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ РґР»СЏ РїРѕРёСЃРєР°:\n"
        "рџ’Ў <i>Р”Р»СЏ РѕС‚РјРµРЅС‹ РІРІРµРґРёС‚Рµ /cancel</i>",
        parse_mode="HTML"
    )
    
    await state.set_state(ReferrersSearchState.waiting_search)
    await callback.answer()


@router.message(ReferrersSearchState.waiting_search)
async def handle_referrers_search(message: Message, state: FSMContext):
    """РћР±СЂР°Р±РѕС‚РєР° РїРѕРёСЃРєРѕРІРѕРіРѕ Р·Р°РїСЂРѕСЃР° РїРѕ СЂРµС„РµСЂРµСЂР°Рј"""
    user_id = message.from_user.id

    if not is_admin(user_id):
        await state.clear()
        return

    if message.text and message.text.strip().lower() == '/cancel':
        await message.answer("вќЊ РџРѕРёСЃРє РѕС‚РјРµРЅРµРЅ")
        await state.clear()
        return

    search_query = (message.text or "").strip()
    if not search_query:
        await message.answer("вќЊ Р’РІРµРґРёС‚Рµ username, РёРјСЏ, С„Р°РјРёР»РёСЋ РёР»Рё ID РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ РґР»СЏ РїРѕРёСЃРєР°.")
        return

    class FakeCallback:
        def __init__(self, msg):
            self.message = msg
            self.from_user = msg.from_user
        async def answer(self, *args, **kwargs):
            pass

    await show_referrers_list(FakeCallback(message), page=1, search_query=search_query)
    await state.clear()


@router.callback_query(F.data.startswith("admin_referrer_export_"))
async def admin_referrer_export_handler(callback: CallbackQuery):
    """РћР±СЂР°Р±РѕС‚С‡РёРє СЌРєСЃРїРѕСЂС‚Р° СЂРµС„РµСЂР°Р»РѕРІ РєРѕРЅРєСЂРµС‚РЅРѕРіРѕ СЂРµС„РµСЂРµСЂР° (С‚РѕР»СЊРєРѕ С‚РµС…, РєС‚Рѕ РєСѓРїРёР»)"""
    user_id = callback.from_user.id
    
    if not is_admin(user_id):
        await callback.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°", show_alert=True)
        return
    
    if not DJANGO_INTEGRATION:
        await callback.answer("вќЊ РЎРёСЃС‚РµРјР° РЅРµРґРѕСЃС‚СѓРїРЅР°", show_alert=True)
        return
    
    try:
        referrer_id = int(callback.data.split("_")[-1])
        import aiohttp
        
        api_url = f'http://127.0.0.1:8123/bot_management/api/referrers/{referrer_id}/export/'
        
        async with aiohttp.ClientSession() as session:
            async with session.get(api_url) as response:
                if response.status == 200:
                    # РџРѕР»СѓС‡Р°РµРј CSV С„Р°Р№Р»
                    csv_content = await response.read()
                    
                    # РћС‚РїСЂР°РІР»СЏРµРј С„Р°Р№Р» РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ
                    from aiogram.types import BufferedInputFile
                    filename = f"referrer_{referrer_id}_referrals.csv"
                    file = BufferedInputFile(csv_content, filename=filename)
                    await callback.message.answer_document(
                        document=file,
                        caption=f"рџ“Ґ <b>Р­РєСЃРїРѕСЂС‚ СЂРµС„РµСЂР°Р»РѕРІ</b>\n\nР­РєСЃРїРѕСЂС‚РёСЂРѕРІР°РЅС‹ С‚РѕР»СЊРєРѕ СЂРµС„РµСЂР°Р»С‹, РєРѕС‚РѕСЂС‹Рµ РїРµСЂРµС€Р»Рё РїРѕ СЃСЃС‹Р»РєРµ Рё РєСѓРїРёР»Рё С‡С‚Рѕ-С‚Рѕ",
                        parse_mode="HTML"
                    )
                    await callback.answer("вњ… Р¤Р°Р№Р» РѕС‚РїСЂР°РІР»РµРЅ")
                else:
                    error_text = await response.text()
                    await callback.answer(f"вќЊ РћС€РёР±РєР° СЌРєСЃРїРѕСЂС‚Р°: {error_text[:50]}", show_alert=True)
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° СЌРєСЃРїРѕСЂС‚Р° СЂРµС„РµСЂР°Р»РѕРІ СЂРµС„РµСЂРµСЂР°: {e}")
        await callback.answer(f"вќЊ РћС€РёР±РєР°: {str(e)}", show_alert=True)


@router.callback_query(F.data.startswith("toggle_key_"))
async def toggle_key_handler(callback: CallbackQuery):
    """РћР±СЂР°Р±РѕС‚С‡РёРє РІРєР»СЋС‡РµРЅРёСЏ/РІС‹РєР»СЋС‡РµРЅРёСЏ РєР»СЋС‡Р°"""
    user_id = callback.from_user.id
    
    if not is_admin(user_id):
        await callback.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°", show_alert=True)
        return
    
    try:
        parts = callback.data.split("_")
        key_id = int(parts[2])
        is_active = parts[3] == "on"
        
        import aiohttp
        
        api_url = 'http://127.0.0.1:8123/bot_management/api/keys/toggle/'
        
        async with aiohttp.ClientSession() as session:
            async with session.post(api_url, json={
                'key_id': key_id,
                'is_active': is_active
            }) as response:
                if response.status == 200:
                    result = await response.json()
                    if result.get('success'):
                        await callback.answer(f"вњ… РљР»СЋС‡ {'РІРєР»СЋС‡РµРЅ' if is_active else 'РІС‹РєР»СЋС‡РµРЅ'}", show_alert=True)
                        # РћР±РЅРѕРІР»СЏРµРј СЃРїРёСЃРѕРє РєР»СЋС‡РµР№
                        await show_keys_list(callback, page=1)
                    else:
