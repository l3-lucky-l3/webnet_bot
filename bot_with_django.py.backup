вЂў Р’СЃРµРіРѕ РєР»СЋС‡РµР№: <b>{keys.get('total', 0)}</b>
вЂў Р”РѕСЃС‚СѓРїРЅРѕ: <b>{keys.get('available', 0)}</b>

<i>Р’С‹Р±РµСЂРёС‚Рµ РґРµР№СЃС‚РІРёРµ в¬‡пёЏ</i>
"""
                else:
                    keys_text = "вќЊ <b>РћС€РёР±РєР° Р·Р°РіСЂСѓР·РєРё РґР°РЅРЅС‹С…</b>"
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ РєР»СЋС‡РµР№: {e}")
        keys_text = "вќЊ <b>РћС€РёР±РєР° Р·Р°РіСЂСѓР·РєРё РґР°РЅРЅС‹С…</b>"
    
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="рџ“Ґ Р—Р°РіСЂСѓР·РёС‚СЊ РєР»СЋС‡Рё", callback_data="admin_upload_keys")],
        [InlineKeyboardButton(text="рџ“‹ РЎРїРёСЃРѕРє РєР»СЋС‡РµР№", callback_data="admin_keys_list")],
        [InlineKeyboardButton(text="рџ”„ РћР±РЅРѕРІРёС‚СЊ", callback_data="admin_keys")],
        [InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ РІ Р°РґРјРёРЅРєСѓ", callback_data="admin_panel")]
    ])
    
    try:
        await callback.message.edit_text(keys_text, parse_mode="HTML", reply_markup=kb)
    except:
        await callback.message.answer(keys_text, parse_mode="HTML", reply_markup=kb)
    
    await callback.answer()

@router.callback_query(F.data == "admin_broadcast")
async def admin_broadcast_handler(callback: CallbackQuery, state: FSMContext):
    """РћР±СЂР°Р±РѕС‚С‡РёРє СЂР°СЃСЃС‹Р»РєРё"""
    user_id = callback.from_user.id
    
    if not is_admin(user_id):
        await callback.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°", show_alert=True)
        return
    
    # РћС‡РёС‰Р°РµРј СЃРѕСЃС‚РѕСЏРЅРёРµ РїСЂРё РІРѕР·РІСЂР°С‚Рµ РІ РјРµРЅСЋ СЂР°СЃСЃС‹Р»РєРё
    await state.clear()
    
    # РџРѕР»СѓС‡Р°РµРј РєРѕР»РёС‡РµСЃС‚РІРѕ РїРѕР»СЊР·РѕРІР°С‚РµР»РµР№
    user_count = 0
    if DJANGO_INTEGRATION:
        try:
            import aiohttp
            api_url = 'http://127.0.0.1:8123/bot_management/api/statistics/'
            async with aiohttp.ClientSession() as session:
                async with session.get(api_url) as response:
                    if response.status == 200:
                        data = await response.json()
                        user_count = data.get('users', {}).get('total', 0)
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ СЃС‚Р°С‚РёСЃС‚РёРєРё РґР»СЏ СЂР°СЃСЃС‹Р»РєРё: {e}")
    else:
        # РСЃРїРѕР»СЊР·СѓРµРј РїСЂСЏРјСѓСЋ Р±Р°Р·Сѓ РґР°РЅРЅС‹С…
        with get_db() as conn:
            result = conn.execute("SELECT COUNT(*) as count FROM users").fetchone()
            user_count = result['count'] if result else 0
    
    broadcast_text = f"""
рџ“ў <b>Р Р°СЃСЃС‹Р»РєР° СЃРѕРѕР±С‰РµРЅРёР№</b>

рџ‘Ґ <b>РџРѕР»СѓС‡Р°С‚РµР»РµР№:</b> {user_count} РїРѕР»СЊР·РѕРІР°С‚РµР»РµР№

рџ“ќ <b>РРЅСЃС‚СЂСѓРєС†РёСЏ:</b>
1. РќР°Р¶РјРёС‚Рµ "РќР°С‡Р°С‚СЊ СЂР°СЃСЃС‹Р»РєСѓ"
2. РћС‚РїСЂР°РІСЊС‚Рµ С‚РµРєСЃС‚ СЃРѕРѕР±С‰РµРЅРёСЏ (РјРѕР¶РЅРѕ СЃ С„РѕС‚Рѕ РёР»Рё РІРёРґРµРѕ)
3. (РќРµРѕР±СЏР·Р°С‚РµР»СЊРЅРѕ) Р”РѕР±Р°РІСЊС‚Рµ СЃС‚СЂРѕРєРё РґР»СЏ РєРЅРѕРїРѕРє С„РѕСЂРјР°С‚Р°:
   <code>btn: РўРµРєСЃС‚ РєРЅРѕРїРєРё | https://example.com</code>
   РёР»Рё
   <code>btn: РўРµРєСЃС‚ РєРЅРѕРїРєРё | catalog</code>
4. РџРѕРґС‚РІРµСЂРґРёС‚Рµ РѕС‚РїСЂР°РІРєСѓ

вљ пёЏ <b>Р’РЅРёРјР°РЅРёРµ:</b> Р Р°СЃСЃС‹Р»РєР° Р±СѓРґРµС‚ РѕС‚РїСЂР°РІР»РµРЅР° РІСЃРµРј РїРѕР»СЊР·РѕРІР°С‚РµР»СЏРј Р±РѕС‚Р°!
"""
    
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="рџ“ќ РќР°С‡Р°С‚СЊ СЂР°СЃСЃС‹Р»РєСѓ", callback_data="start_broadcast")],
        [InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ РІ Р°РґРјРёРЅРєСѓ", callback_data="admin_panel")]
    ])
    
    try:
        await callback.message.edit_text(broadcast_text, parse_mode="HTML", reply_markup=kb)
    except:
        await callback.message.answer(broadcast_text, parse_mode="HTML", reply_markup=kb)
    
    await callback.answer()

@router.callback_query(F.data == "start_broadcast")
async def start_broadcast_handler(callback: CallbackQuery, state: FSMContext):
    """РќР°С‡Р°Р»Рѕ СЃРѕР·РґР°РЅРёСЏ СЂР°СЃСЃС‹Р»РєРё"""
    user_id = callback.from_user.id
    
    if not is_admin(user_id):
        await callback.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°", show_alert=True)
        return
    
    logging.info(f"DEBUG: РќР°С‡Р°Р»Рѕ СЃРѕР·РґР°РЅРёСЏ СЂР°СЃСЃС‹Р»РєРё РґР»СЏ Р°РґРјРёРЅР° {user_id}")
    
    await callback.message.answer(
        "рџ“ќ <b>Р’РІРµРґРёС‚Рµ С‚РµРєСЃС‚ СЃРѕРѕР±С‰РµРЅРёСЏ РґР»СЏ СЂР°СЃСЃС‹Р»РєРё:</b>\n\n"
        "рџ’Ў <i>РњРѕР¶РЅРѕ РїСЂРёРєСЂРµРїРёС‚СЊ С„РѕС‚Рѕ РёР»Рё РІРёРґРµРѕ вЂ“ РѕРЅРё Р±СѓРґСѓС‚ РѕС‚РїСЂР°РІР»РµРЅС‹ РІРјРµСЃС‚Рµ СЃ С‚РµРєСЃС‚РѕРј.</i>\n"
        "рџ’Ў <i>Р”Р»СЏ РґРѕР±Р°РІР»РµРЅРёСЏ РєРЅРѕРїРѕРє РґРѕР±Р°РІСЊС‚Рµ СЃС‚СЂРѕРєРё РІРёРґР°:</i>\n"
        "   <code>btn: РўРµРєСЃС‚ РєРЅРѕРїРєРё | https://example.com</code>\n"
        "   <code>btn: РўРµРєСЃС‚ РєРЅРѕРїРєРё | catalog</code>\n"
        "рџ’Ў <i>Р”Р»СЏ РѕС‚РјРµРЅС‹ РІРІРµРґРёС‚Рµ /cancel</i>",
        parse_mode="HTML"
    )
    
    await state.set_state(BroadcastState.waiting_message)
    current_state = await state.get_state()
    logging.info(f"DEBUG: РЈСЃС‚Р°РЅРѕРІР»РµРЅРѕ СЃРѕСЃС‚РѕСЏРЅРёРµ СЂР°СЃСЃС‹Р»РєРё: {current_state}, РѕР¶РёРґР°РµС‚СЃСЏ: {BroadcastState.waiting_message}")
    await callback.answer()

@router.callback_query(F.data == "confirm_broadcast")
async def confirm_broadcast_handler(callback: CallbackQuery, state: FSMContext):
    """РџРѕРґС‚РІРµСЂР¶РґРµРЅРёРµ Рё РѕС‚РїСЂР°РІРєР° СЂР°СЃСЃС‹Р»РєРё"""
    user_id = callback.from_user.id
    
    if not is_admin(user_id):
        await callback.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°", show_alert=True)
        return
    
    data = await state.get_data()
    message_text = data.get('message_text', '')
    user_count = data.get('user_count', 0)
    photo_file_id = data.get('photo_file_id')
    video_file_id = data.get('video_file_id')
    buttons = data.get('buttons', []) or []
    
    if not message_text:
        await callback.answer("вќЊ РћС€РёР±РєР°: С‚РµРєСЃС‚ СЃРѕРѕР±С‰РµРЅРёСЏ РЅРµ РЅР°Р№РґРµРЅ", show_alert=True)
        await state.clear()
        return
    
    # РЈРІРµРґРѕРјР»СЏРµРј Рѕ РЅР°С‡Р°Р»Рµ СЂР°СЃСЃС‹Р»РєРё
    start_text = (
        f"рџ“ў <b>Р Р°СЃСЃС‹Р»РєР° РЅР°С‡Р°Р»Р°СЃСЊ</b>\n\n"
        f"рџ‘Ґ РћС‚РїСЂР°РІРєР° {user_count} РїРѕР»СЊР·РѕРІР°С‚РµР»СЏРј...\n"
        f"вЏі РџРѕР¶Р°Р»СѓР№СЃС‚Р°, РїРѕРґРѕР¶РґРёС‚Рµ..."
    )
    try:
        if callback.message.photo or callback.message.video:
            # РџСЂРµРІСЊСЋ Р±С‹Р»Рѕ СЃ РјРµРґРёР° вЂ“ СЂРµРґР°РєС‚РёСЂСѓРµРј РїРѕРґРїРёСЃСЊ
            await callback.message.edit_caption(start_text, parse_mode="HTML")
        else:
            await callback.message.edit_text(start_text, parse_mode="HTML")
    except Exception as e:
        logging.warning(f"РќРµ СѓРґР°Р»РѕСЃСЊ РѕС‚СЂРµРґР°РєС‚РёСЂРѕРІР°С‚СЊ СЃРѕРѕР±С‰РµРЅРёРµ РїСЂРё СЃС‚Р°СЂС‚Рµ СЂР°СЃСЃС‹Р»РєРё: {e}, РѕС‚РїСЂР°РІР»СЏРµРј РЅРѕРІРѕРµ")
        await callback.message.answer(start_text, parse_mode="HTML")
    
    await callback.answer("Р Р°СЃСЃС‹Р»РєР° РЅР°С‡Р°Р»Р°СЃСЊ...")
    
    # РЎРѕР±РёСЂР°РµРј РєР»Р°РІРёР°С‚СѓСЂСѓ РґР»СЏ СЂР°СЃСЃС‹Р»РєРё (РєРЅРѕРїРєРё РїРѕРґ РїРѕСЃС‚РѕРј)
    reply_keyboard = None
    if buttons:
        kb_rows = []
        for b in buttons:
            text = b.get('text')
            if not text:
                continue
            if 'url' in b:
                kb_rows.append([InlineKeyboardButton(text=text, url=b['url'])])
            elif 'callback_data' in b:
                kb_rows.append([InlineKeyboardButton(text=text, callback_data=b['callback_data'])])
        if kb_rows:
            reply_keyboard = InlineKeyboardMarkup(inline_keyboard=kb_rows)

    # РџРѕР»СѓС‡Р°РµРј СЃРїРёСЃРѕРє РїРѕР»СЊР·РѕРІР°С‚РµР»РµР№
    users = []
    if DJANGO_INTEGRATION:
        try:
            import aiohttp
            # РџРѕР»СѓС‡Р°РµРј СЃРїРёСЃРѕРє РїРѕР»СЊР·РѕРІР°С‚РµР»РµР№ С‡РµСЂРµР· API РёР»Рё РЅР°РїСЂСЏРјСѓСЋ РёР· Р±Р°Р·С‹
            # РџРѕРєР° РёСЃРїРѕР»СЊР·СѓРµРј РїСЂСЏРјСѓСЋ Р±Р°Р·Сѓ РґР°РЅРЅС‹С…
            with get_db() as conn:
                users = conn.execute("SELECT user_id FROM users").fetchall()
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ РїРѕР»СЊР·РѕРІР°С‚РµР»РµР№: {e}")
            users = []
    else:
        with get_db() as conn:
            users = conn.execute("SELECT user_id FROM users").fetchall()
    
    # РћС‚РїСЂР°РІР»СЏРµРј СЂР°СЃСЃС‹Р»РєСѓ
    sent_count = 0
    failed_count = 0
    
    for user in users:
        try:
            user_id = user['user_id'] if isinstance(user, dict) else user[0]
            
            if video_file_id:
                await bot.send_video(
                    chat_id=user_id,
                    video=video_file_id,
                    caption=message_text,
                    parse_mode="HTML",
                    reply_markup=reply_keyboard
                )
            elif photo_file_id:
                await bot.send_photo(
                    chat_id=user_id,
                    photo=photo_file_id,
                    caption=message_text,
                    parse_mode="HTML",
                    reply_markup=reply_keyboard
                )
            else:
                await bot.send_message(
                    chat_id=user_id,
                    text=message_text,
                    parse_mode="HTML",
                    reply_markup=reply_keyboard
                )
            
            sent_count += 1
            
            # РќРµР±РѕР»СЊС€Р°СЏ Р·Р°РґРµСЂР¶РєР°, С‡С‚РѕР±С‹ РЅРµ РїСЂРµРІС‹СЃРёС‚СЊ Р»РёРјРёС‚С‹ API
            if sent_count % 30 == 0:
                await asyncio.sleep(1)
                # РћР±РЅРѕРІР»СЏРµРј СЃС‚Р°С‚СѓСЃ РєР°Р¶РґС‹Рµ 30 СЃРѕРѕР±С‰РµРЅРёР№
                progress_text = (
                    f"рџ“ў <b>Р Р°СЃСЃС‹Р»РєР° РІ РїСЂРѕС†РµСЃСЃРµ</b>\n\n"
                    f"вњ… РћС‚РїСЂР°РІР»РµРЅРѕ: {sent_count}/{user_count}\n"
                    f"вќЊ РћС€РёР±РѕРє: {failed_count}\n"
                    f"вЏі РџСЂРѕРґРѕР»Р¶Р°РµС‚СЃСЏ..."
                )
                try:
                    if callback.message.photo or callback.message.video:
                        await callback.message.edit_caption(progress_text, parse_mode="HTML")
                    else:
                        await callback.message.edit_text(progress_text, parse_mode="HTML")
                except Exception:
                    pass
            
        except Exception as e:
            failed_count += 1
            logging.error(f"РћС€РёР±РєР° РѕС‚РїСЂР°РІРєРё РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ {user_id}: {e}")
    
    # Р¤РёРЅР°Р»СЊРЅС‹Р№ СЂРµР·СѓР»СЊС‚Р°С‚
    result_text = f"""
вњ… <b>Р Р°СЃСЃС‹Р»РєР° Р·Р°РІРµСЂС€РµРЅР°!</b>

рџ“Љ <b>РЎС‚Р°С‚РёСЃС‚РёРєР°:</b>
вЂў вњ… РћС‚РїСЂР°РІР»РµРЅРѕ: {sent_count}
вЂў вќЊ РћС€РёР±РѕРє: {failed_count}
вЂў рџ“Љ Р’СЃРµРіРѕ РїРѕР»СѓС‡Р°С‚РµР»РµР№: {user_count}
"""
    
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ РІ Р°РґРјРёРЅРєСѓ", callback_data="admin_panel")]
    ])
    
    try:
        if callback.message.photo or callback.message.video:
            await callback.message.edit_caption(result_text, parse_mode="HTML", reply_markup=kb)
        else:
            await callback.message.edit_text(result_text, parse_mode="HTML", reply_markup=kb)
    except Exception:
        await callback.message.answer(result_text, parse_mode="HTML", reply_markup=kb)
    
    await state.clear()

# --- РћР±СЂР°Р±РѕС‚С‡РёРєРё Р·Р°РіСЂСѓР·РєРё РєР»СЋС‡РµР№ Рё РЅР°СЃС‚СЂРѕРµРє ---

@router.callback_query(F.data == "admin_upload_keys")
async def admin_upload_keys_handler(callback: CallbackQuery, state: FSMContext):
    """РќР°С‡Р°Р»Рѕ Р·Р°РіСЂСѓР·РєРё РєР»СЋС‡РµР№"""
    logging.info(f"DEBUG: РџРѕР»СѓС‡РµРЅ callback admin_upload_keys РѕС‚ {callback.from_user.id}")
    user_id = callback.from_user.id
    
    if not is_admin(user_id):
        logging.warning(f"DEBUG: РџРѕРїС‹С‚РєР° РґРѕСЃС‚СѓРїР° Рє Р·Р°РіСЂСѓР·РєРµ РєР»СЋС‡РµР№ РѕС‚ РЅРµ-Р°РґРјРёРЅР° {user_id}")
        await callback.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°", show_alert=True)
        return
    
    text = """
рџ“Ґ <b>Р—Р°РіСЂСѓР·РєР° РєР»СЋС‡РµР№</b>

рџ“ќ <b>РРЅСЃС‚СЂСѓРєС†РёСЏ:</b>
1. Р’С‹Р±РµСЂРёС‚Рµ С‚РёРї РїРѕРґРїРёСЃРєРё
2. Р’С‹Р±РµСЂРёС‚Рµ РєРѕР»РёС‡РµСЃС‚РІРѕ Р°РєС‚РёРІР°С†РёР№
3. РћС‚РїСЂР°РІСЊС‚Рµ СЃРїРёСЃРѕРє РєР»СЋС‡РµР№ (РєР°Р¶РґС‹Р№ РєР»СЋС‡ СЃ РЅРѕРІРѕР№ СЃС‚СЂРѕРєРё РёР»Рё С‡РµСЂРµР· Р·Р°РїСЏС‚СѓСЋ)

<i>РќР°Р¶РјРёС‚Рµ РєРЅРѕРїРєСѓ РЅРёР¶Рµ РґР»СЏ РЅР°С‡Р°Р»Р°</i>
"""
    
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="рџЋЃ РџСЂРѕР±РЅР°СЏ (1 РґРµРЅСЊ)", callback_data="upload_keys_trial")],
        [InlineKeyboardButton(text="рџ“… РњРµСЃСЏС‡РЅР°СЏ (РѕР±С‰Р°СЏ Р±Р°Р·Р° РґР»СЏ 1 РјРµСЃ / 3 РјРµСЃ / РіРѕРґ)", callback_data="upload_keys_month")],
        [InlineKeyboardButton(text="вќЊ РћС‚РјРµРЅРёС‚СЊ", callback_data="admin_keys")]
    ])
    
    try:
        await callback.message.edit_text(text, parse_mode="HTML", reply_markup=kb)
    except:
        await callback.message.answer(text, parse_mode="HTML", reply_markup=kb)
    
    await callback.answer()

@router.callback_query(F.data.startswith("upload_keys_"))
async def admin_upload_keys_type_handler(callback: CallbackQuery, state: FSMContext):
    """Р’С‹Р±РѕСЂ С‚РёРїР° РїРѕРґРїРёСЃРєРё РґР»СЏ Р·Р°РіСЂСѓР·РєРё РєР»СЋС‡РµР№"""
    user_id = callback.from_user.id
    
    if not is_admin(user_id):
        await callback.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°", show_alert=True)
        return
    
    sub_type = callback.data.replace("upload_keys_", "")
    
    # РЎРѕС…СЂР°РЅСЏРµРј С‚РёРї РїРѕРґРїРёСЃРєРё
    await state.update_data(subscription_type=sub_type)
    
    text = f"""
рџ“Ґ <b>Р—Р°РіСЂСѓР·РєР° РєР»СЋС‡РµР№</b>

рџ“… <b>РўРёРї РїРѕРґРїРёСЃРєРё:</b> {sub_type}

рџ“ќ <b>Р’С‹Р±РµСЂРёС‚Рµ РєРѕР»РёС‡РµСЃС‚РІРѕ Р°РєС‚РёРІР°С†РёР№:</b>
"""
    
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="1", callback_data=f"upload_activations_{sub_type}_1"),
         InlineKeyboardButton(text="2", callback_data=f"upload_activations_{sub_type}_2"),
         InlineKeyboardButton(text="3", callback_data=f"upload_activations_{sub_type}_3"),
         InlineKeyboardButton(text="4", callback_data=f"upload_activations_{sub_type}_4"),
         InlineKeyboardButton(text="5", callback_data=f"upload_activations_{sub_type}_5")],
        [InlineKeyboardButton(text="6", callback_data=f"upload_activations_{sub_type}_6"),
         InlineKeyboardButton(text="7", callback_data=f"upload_activations_{sub_type}_7"),
         InlineKeyboardButton(text="8", callback_data=f"upload_activations_{sub_type}_8"),
         InlineKeyboardButton(text="9", callback_data=f"upload_activations_{sub_type}_9"),
         InlineKeyboardButton(text="10", callback_data=f"upload_activations_{sub_type}_10")],
        [InlineKeyboardButton(text="вќЊ РћС‚РјРµРЅРёС‚СЊ", callback_data="admin_upload_keys")]
    ])
    
    try:
        await callback.message.edit_text(text, parse_mode="HTML", reply_markup=kb)
    except:
        await callback.message.answer(text, parse_mode="HTML", reply_markup=kb)
    
    await callback.answer()

@router.callback_query(F.data.startswith("upload_activations_"))
async def admin_upload_keys_activations_handler(callback: CallbackQuery, state: FSMContext):
    """Р’С‹Р±РѕСЂ РєРѕР»РёС‡РµСЃС‚РІР° Р°РєС‚РёРІР°С†РёР№ Рё Р·Р°РїСЂРѕСЃ РєР»СЋС‡РµР№"""
    user_id = callback.from_user.id
    
    if not is_admin(user_id):
        await callback.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°", show_alert=True)
        return
    
    # РџР°СЂСЃРёРј РґР°РЅРЅС‹Рµ РёР· callback_data: upload_activations_{sub_type}_{activations}
    parts = callback.data.split("_")
    sub_type = parts[2]
    activations = int(parts[3])
    
    # РЎРѕС…СЂР°РЅСЏРµРј РґР°РЅРЅС‹Рµ
    await state.update_data(
        subscription_type=sub_type,
        total_activations=activations
    )
    
    text = f"""
рџ“Ґ <b>Р—Р°РіСЂСѓР·РєР° РєР»СЋС‡РµР№</b>

рџ“… <b>РўРёРї РїРѕРґРїРёСЃРєРё:</b> {sub_type}
рџ”ў <b>РђРєС‚РёРІР°С†РёР№:</b> {activations}

рџ“ќ <b>РћС‚РїСЂР°РІСЊС‚Рµ СЃРїРёСЃРѕРє РєР»СЋС‡РµР№:</b>
вЂў РљР°Р¶РґС‹Р№ РєР»СЋС‡ СЃ РЅРѕРІРѕР№ СЃС‚СЂРѕРєРё
вЂў РР»Рё С‡РµСЂРµР· Р·Р°РїСЏС‚СѓСЋ

<i>РџСЂРёРјРµСЂ:</i>
<code>key1
key2
key3</code>

<i>РР»Рё:</i>
<code>key1, key2, key3</code>

<i>Р”Р»СЏ РѕС‚РјРµРЅС‹ РѕС‚РїСЂР°РІСЊС‚Рµ /cancel</i>
"""
    
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="вќЊ РћС‚РјРµРЅРёС‚СЊ", callback_data="admin_keys")]
    ])
    
    try:
        await callback.message.edit_text(text, parse_mode="HTML", reply_markup=kb)
    except:
        await callback.message.answer(text, parse_mode="HTML", reply_markup=kb)
    
    await state.set_state(UploadKeysState.waiting_keys)
    await callback.answer()

# --- Р¤СѓРЅРєС†РёРё РґР»СЏ РѕС‚РѕР±СЂР°Р¶РµРЅРёСЏ СЃРїРёСЃРєРѕРІ ---

async def show_keys_list(callback: CallbackQuery, page=1):
    """РћС‚РѕР±СЂР°Р¶РµРЅРёРµ СЃРїРёСЃРєР° РєР»СЋС‡РµР№"""
    try:
        import aiohttp
        
        api_url = f'http://127.0.0.1:8123/bot_management/api/keys/list/?page={page}&limit=10'
        
        async with aiohttp.ClientSession() as session:
            async with session.get(api_url) as response:
                if response.status == 200:
                    data = await response.json()
                    keys = data.get('keys', [])
                    total = data.get('total', 0)
                    pages = data.get('pages', 1)
                    
                    keys_text = f"""
рџ”‘ <b>РЎРїРёСЃРѕРє РєР»СЋС‡РµР№</b>

рџ“Љ <b>Р’СЃРµРіРѕ:</b> {total}
рџ“„ <b>РЎС‚СЂР°РЅРёС†Р°:</b> {page}/{pages}

"""
                    keys_text += "\n<b>РќР°Р¶РјРёС‚Рµ РЅР° РєР»СЋС‡ РґР»СЏ СѓРїСЂР°РІР»РµРЅРёСЏ:</b>\n\n"
                    
                    kb_buttons = []
                    # РЎРѕР·РґР°РµРј РєРЅРѕРїРєРё РґР»СЏ РєР°Р¶РґРѕРіРѕ РєР»СЋС‡Р°
                    for key in keys[:10]:  # РџРѕРєР°Р·С‹РІР°РµРј РїРµСЂРІС‹Рµ 10
                        status = "вњ…" if key.get('is_active') else "вќЊ"
                        sub_type = key.get('subscription_type', 'N/A')
                        key_value = key.get('key_value', 'N/A')
                        key_id = key.get('key_id')
                        
                        # РЎРѕРєСЂР°С‰Р°РµРј РєР»СЋС‡ РґР»СЏ РѕС‚РѕР±СЂР°Р¶РµРЅРёСЏ РЅР° РєРЅРѕРїРєРµ
                        button_text = f"{status} {sub_type}"
                        if len(key_value) > 15:
                            button_text += f" - {key_value[:15]}..."
                        else:
                            button_text += f" - {key_value}"
                        
                        kb_buttons.append([InlineKeyboardButton(
                            text=button_text,
                            callback_data=f"admin_key_detail_{key_id}"
                        )])
                    
                    # РљРЅРѕРїРєРё РЅР°РІРёРіР°С†РёРё
                    nav_buttons = []
                    if page > 1:
                        nav_buttons.append(InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ", callback_data=f"admin_keys_list_page_{page-1}"))
                    if page < pages:
                        nav_buttons.append(InlineKeyboardButton(text="Р’РїРµСЂРµРґ вћЎпёЏ", callback_data=f"admin_keys_list_page_{page+1}"))
                    if nav_buttons:
                        kb_buttons.append(nav_buttons)
                    kb_buttons.append([InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ РІ СѓРїСЂР°РІР»РµРЅРёРµ РєР»СЋС‡Р°РјРё", callback_data="admin_keys")])
                    
                    kb = InlineKeyboardMarkup(inline_keyboard=kb_buttons)
                    
                    try:
                        await callback.message.edit_text(keys_text, parse_mode="HTML", reply_markup=kb)
                    except:
                        await callback.message.answer(keys_text, parse_mode="HTML", reply_markup=kb)
                else:
                    await callback.message.answer("вќЊ РћС€РёР±РєР° Р·Р°РіСЂСѓР·РєРё СЃРїРёСЃРєР° РєР»СЋС‡РµР№")
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ СЃРїРёСЃРєР° РєР»СЋС‡РµР№: {e}")
        await callback.message.answer(f"вќЊ РћС€РёР±РєР°: {str(e)}")


async def show_payments_list(callback: CallbackQuery, page=1):
    """РћС‚РѕР±СЂР°Р¶РµРЅРёРµ СЃРїРёСЃРєР° РїР»Р°С‚РµР¶РµР№"""
    try:
        import aiohttp
        
        api_url = f'http://127.0.0.1:8123/bot_management/api/payments/list/?page={page}&limit=10'
        
        async with aiohttp.ClientSession() as session:
            async with session.get(api_url) as response:
                if response.status == 200:
                    data = await response.json()
                    payments = data.get('payments', [])
                    total = data.get('total', 0)
                    pages = data.get('pages', 1)
                    
                    payments_text = f"""
