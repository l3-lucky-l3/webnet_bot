    keyboard = [
        [InlineKeyboardButton(text="рџ”‘ РџРѕР»СѓС‡РёС‚СЊ РєР»СЋС‡", callback_data="get_key_menu")],
    ]

    # Р”РѕР±Р°РІР»СЏРµРј РєРЅРѕРїРєСѓ "РќР°РїРёСЃР°С‚СЊ РјРµРЅРµРґР¶РµСЂСѓ" РµСЃР»Рё С„СѓРЅРєС†РёСЏ РІРєР»СЋС‡РµРЅР°
    if manager_key_delivery_enabled:
        keyboard.append([InlineKeyboardButton(text="рџ“ћ РџРѕР»СѓС‡РёС‚СЊ РєР»СЋС‡ Сѓ РјРµРЅРµРґР¶РµСЂР°", url="https://t.me/yamalube61")])

    keyboard.extend([
        [InlineKeyboardButton(text="рџ”ђ РњРѕРё РєР»СЋС‡Рё", callback_data="my_keys"), InlineKeyboardButton(text="рџ‘¤ РџСЂРѕС„РёР»СЊ", callback_data="profile")],
        [InlineKeyboardButton(text="рџ‘Ґ Р РµС„РµСЂР°Р»СЊРЅР°СЏ СЃРёСЃС‚РµРјР°", callback_data="referral_info")],
        [InlineKeyboardButton(text="рџ“Њ РџСЂРѕРєСЃРё РґР»СЏ Telegram", callback_data="tg_proxy")],
        [InlineKeyboardButton(text="в­ђ РћС‚Р·С‹РІС‹", url="https://t.me/otzyvywebnetvpn")],
        [InlineKeyboardButton(text="рџ›  РџРѕРґРґРµСЂР¶РєР°", url="https://t.me/yamalube61"), InlineKeyboardButton(text="в„№пёЏ Рћ СЃРµСЂРІРёСЃРµ", callback_data="about")],
    ])
    
    # Р”РѕР±Р°РІР»СЏРµРј РєРЅРѕРїРєСѓ Р°РґРјРёРЅРєРё РґР»СЏ Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂРѕРІ
    if is_admin(user_id):
        keyboard.append([InlineKeyboardButton(text="рџ”§ РђРґРјРёРЅ-РїР°РЅРµР»СЊ", callback_data="admin_panel")])
    
