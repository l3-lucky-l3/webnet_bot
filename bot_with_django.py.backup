@router.message(Command("menu"))
@protect_message('messages')
async def cmd_menu(message: Message):
    """РљРѕРјР°РЅРґР° /menu - РїРѕРєР°Р·С‹РІР°РµС‚ РіР»Р°РІРЅРѕРµ РјРµРЅСЋ"""
    welcome_text = """
<b>Р“Р»СѓС€Р°С‚ СЃРІСЏР·СЊ?</b>

<b>РњС‹ РїРѕРјРѕРіР°РµРј РѕСЃС‚Р°РІР°С‚СЊСЃСЏ РЅР° СЃРІСЏР·Рё 24/7.</b>

Р“РґРµ Р±С‹ РІС‹ РЅРё Р±С‹Р»Рё вЂ” РІ Р»СЋР±РѕР№ С‚РѕС‡РєРµ РЅР°С€РµР№ СЃС‚СЂР°РЅС‹рџ‡·рџ‡є.

РќРµРІР°Р¶РЅРѕ, С‡С‚Рѕ РІС‹ РёСЃРїРѕР»СЊР·СѓРµС‚Рµ вЂ” Wi-Fi РёР»Рё РјРѕР±РёР»СЊРЅС‹Рµ РґР°РЅРЅС‹Рµ.

рџ”Ґ <b>Р Р°Р±РѕС‚Р°РµС‚ РЅР° РІСЃРµС… РѕРїРµСЂР°С‚РѕСЂР°С….</b>
вњ… <b>Р Р°Р±РѕС‚Р°РµС‚ РІРѕ РІСЃРµС… РіРѕСЂРѕРґР°С….</b>

<i>Р’С‹Р±РµСЂРёС‚Рµ РґРµР№СЃС‚РІРёРµ РёР· РјРµРЅСЋ РЅРёР¶Рµ: в¬‡пёЏ</i>
"""
    
    # РџСЂРѕРІРµСЂСЏРµРј, РІРєР»СЋС‡РµРЅР° Р»Рё С„СѓРЅРєС†РёСЏ "РќР°РїРёСЃР°С‚СЊ РјРµРЅРµРґР¶РµСЂСѓ"
    manager_key_delivery_enabled = True  # РџРѕ СѓРјРѕР»С‡Р°РЅРёСЋ РІРєР»СЋС‡РµРЅРѕ
    if DJANGO_INTEGRATION:
        try:
            import aiohttp
            api_url = 'http://127.0.0.1:8123/bot_management/api/settings/get/?key=manager_key_delivery_enabled'
            async with aiohttp.ClientSession() as session:
                async with session.get(api_url) as response:
                    if response.status == 200:
                        data = await response.json()
                        if data.get('success'):
                            value = data.get('value')
                            if value is not None:
                                manager_key_delivery_enabled = str(value).lower() == 'true'
        except:
            pass  # РСЃРїРѕР»СЊР·СѓРµРј Р·РЅР°С‡РµРЅРёРµ РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ
    
    keyboard = [
        [InlineKeyboardButton(text="рџ”‘ РџРѕР»СѓС‡РёС‚СЊ РєР»СЋС‡", callback_data="get_key_menu")],
    ]
    
    # Р”РѕР±Р°РІР»СЏРµРј РєРЅРѕРїРєСѓ "РќР°РїРёСЃР°С‚СЊ РјРµРЅРµРґР¶РµСЂСѓ" РµСЃР»Рё С„СѓРЅРєС†РёСЏ РІРєР»СЋС‡РµРЅР°
    if manager_key_delivery_enabled:
        keyboard.append([InlineKeyboardButton(text="рџ“ћ РџРѕР»СѓС‡РёС‚СЊ РєР»СЋС‡ Сѓ РјРµРЅРµРґР¶РµСЂР°", url="https://t.me/yamalube61")])
    
    keyboard.extend([
        [InlineKeyboardButton(text="рџ”ђ РњРѕРё РєР»СЋС‡Рё", callback_data="my_keys"), InlineKeyboardButton(text="рџ‘¤ РџСЂРѕС„РёР»СЊ", callback_data="profile")],
        [InlineKeyboardButton(text="рџ‘Ґ Р РµС„РµСЂР°Р»СЊРЅР°СЏ СЃРёСЃС‚РµРјР°", callback_data="referral_info")],
        [InlineKeyboardButton(text="рџ“Њ РџСЂРѕРєСЃРё РґР»СЏ Telegram", callback_data="tg_proxy")],
        [InlineKeyboardButton(text="в­ђ РћС‚Р·С‹РІС‹", url="https://t.me/otzyvywebnetvpn")],
        [InlineKeyboardButton(text="рџ›  РџРѕРґРґРµСЂР¶РєР°", url="https://t.me/yamalube61"), InlineKeyboardButton(text="в„№пёЏ Рћ СЃРµСЂРІРёСЃРµ", callback_data="about")],
    ])

    # Р”РѕР±Р°РІР»СЏРµРј РєРЅРѕРїРєСѓ Р°РґРјРёРЅРєРё РґР»СЏ Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂРѕРІ
    if is_admin(message.from_user.id):
        keyboard.append([InlineKeyboardButton(text="рџ”§ РђРґРјРёРЅ-РїР°РЅРµР»СЊ", callback_data="admin_panel")])
    
    kb = InlineKeyboardMarkup(inline_keyboard=keyboard)
    
    await message.answer(welcome_text, parse_mode="HTML", reply_markup=kb)

@router.message(Command("start"))
@rate_limit_check('messages')
async def cmd_start(message: Message, command: CommandObject = None):
    user = message.from_user
    
    # Р’РђР–РќРћ: РЎРЅР°С‡Р°Р»Р° СЂРµРіРёСЃС‚СЂРёСЂСѓРµРј РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ Рё РѕР±СЂР°Р±Р°С‚С‹РІР°РµРј СЂРµС„РµСЂР°Р»СЊРЅС‹Р№ РєРѕРґ
    # Р­С‚Рѕ РЅСѓР¶РЅРѕ РґРµР»Р°С‚СЊ Р”Рћ РїСЂРѕРІРµСЂРєРё РїРѕРґРїРёСЃРєРё, С‡С‚РѕР±С‹ СЂРµС„РµСЂР°Р»СЊРЅР°СЏ СЃРёСЃС‚РµРјР° СЂР°Р±РѕС‚Р°Р»Р°
    # РґР°Р¶Рµ РµСЃР»Рё РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ РµС‰Рµ РЅРµ РїРѕРґРїРёСЃР°РЅ РЅР° РєР°РЅР°Р»
    
    # РЈРІРµРґРѕРјР»СЏРµРј Django Рѕ РЅРѕРІРѕРј РїРѕР»СЊР·РѕРІР°С‚РµР»Рµ
    # Р’РђР–РќРћ: РџРµСЂРµРґР°РµРј РґР°РЅРЅС‹Рµ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ, РґР°Р¶Рµ РµСЃР»Рё РЅРµРєРѕС‚РѕСЂС‹Рµ РїРѕР»СЏ None
    if DJANGO_INTEGRATION:
        user_data = {
            'user_id': user.id,
            'username': user.username if user.username else None,
            'first_name': user.first_name if user.first_name else None,
            'last_name': user.last_name if user.last_name else None
        }
        logging.info(f"DEBUG: РћС‚РїСЂР°РІРєР° РґР°РЅРЅС‹С… РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ РІ Django: user_id={user_data['user_id']}, username={user_data['username']}, first_name={user_data['first_name']}")
        await notify_django_new_user(user_data)
    
    with get_db() as conn:
        conn.execute("""
            INSERT OR IGNORE INTO users (user_id, username, first_name, last_name)
            VALUES (?, ?, ?, ?)
        """, (user.id, user.username, user.first_name, user.last_name))
    
    # РћР±СЂР°Р±Р°С‚С‹РІР°РµРј СЂРµС„РµСЂР°Р»СЊРЅС‹Р№ РєРѕРґ Р”Рћ РїСЂРѕРІРµСЂРєРё РїРѕРґРїРёСЃРєРё
    referral_message = ""
    if command and command.args and DJANGO_INTEGRATION:
        try:
            # РСЃРїРѕР»СЊР·СѓРµРј РіР»РѕР±Р°Р»СЊРЅСѓСЋ СЃРµСЃСЃРёСЋ РґР»СЏ РѕРїС‚РёРјРёР·Р°С†РёРё
            session = get_http_session()
            
            # РћР±СЂР°Р±Р°С‚С‹РІР°РµРј СЂРµС„РµСЂР°Р»
            api_url = 'http://127.0.0.1:8123/bot_management/api/referral/process/'
            async with session.post(api_url, data={
                'referrer_code': command.args,
                'referred_user_id': user.id
            }) as response:
                if response.status == 200:
                        data = await response.json()
                        if data.get('success'):
                            referrer = data.get('referrer', {})
                            referrer_name = referrer.get('username') or referrer.get('first_name', 'РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ')
                            referrer_display = f"@{referrer_name}" if referrer.get('username') else referrer_name
                            referral_message = f"\nрџ‘Ґ <b>Р’С‹ РїСЂРёРіР»Р°С€РµРЅС‹ РїРѕР»СЊР·РѕРІР°С‚РµР»РµРј {referrer_display}</b>\n"
                            logging.info(f"DEBUG: Р РµС„РµСЂР°Р»СЊРЅС‹Р№ РєРѕРґ РѕР±СЂР°Р±РѕС‚Р°РЅ СѓСЃРїРµС€РЅРѕ РґР»СЏ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ {user.id}, СЂРµС„РµСЂРµСЂ: {referrer_name}")
                        else:
                            referral_message = f"\nвљ пёЏ <b>Р РµС„РµСЂР°Р»СЊРЅС‹Р№ РєРѕРґ РЅРµРґРµР№СЃС‚РІРёС‚РµР»РµРЅ</b>\n"
                            logging.warning(f"DEBUG: Р РµС„РµСЂР°Р»СЊРЅС‹Р№ РєРѕРґ РЅРµРґРµР№СЃС‚РІРёС‚РµР»РµРЅ РґР»СЏ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ {user.id}, РєРѕРґ: {command.args}")
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° РѕР±СЂР°Р±РѕС‚РєРё СЂРµС„РµСЂР°Р»СЊРЅРѕРіРѕ РєРѕРґР°: {e}")
            import traceback
            logging.error(traceback.format_exc())
            referral_message = ""
    
    # РџСЂРѕРІРµСЂСЏРµРј РїРѕРґРїРёСЃРєСѓ РЅР° РѕР±СЏР·Р°С‚РµР»СЊРЅС‹Р№ РєР°РЅР°Р»
    subscription_required = False
    try:
        # РСЃРїРѕР»СЊР·СѓРµРј ID РєР°РЅР°Р»Р° (Р±РѕР»РµРµ РЅР°РґРµР¶РЅРѕ)
        channel_member = await bot.get_chat_member(REQUIRED_CHANNEL_ID, user.id)
        
        if channel_member:
            # РџСЂРѕРІРµСЂСЏРµРј, С‡С‚Рѕ РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ РїРѕРґРїРёСЃР°РЅ (member, administrator, creator)
            if channel_member.status not in ['member', 'administrator', 'creator']:
                subscription_required = True
    except Exception as e:
        # Р•СЃР»Рё РѕС€РёР±РєР° РїСЂРѕРІРµСЂРєРё, РїСЂРѕРїСѓСЃРєР°РµРј РїСЂРѕРІРµСЂРєСѓ, РЅРѕ Р»РѕРіРёСЂСѓРµРј
        logging.warning(f"РћС€РёР±РєР° РїСЂРѕРІРµСЂРєРё РїРѕРґРїРёСЃРєРё РЅР° РєР°РЅР°Р» {REQUIRED_CHANNEL_ID}: {e}")
        logging.warning("РџСЂРѕРІРµСЂРєР° РїРѕРґРїРёСЃРєРё РїСЂРѕРїСѓС‰РµРЅР°. РЈР±РµРґРёС‚РµСЃСЊ, С‡С‚Рѕ Р±РѕС‚ СЏРІР»СЏРµС‚СЃСЏ Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂРѕРј РєР°РЅР°Р»Р°.")
    
    # Р•СЃР»Рё С‚СЂРµР±СѓРµС‚СЃСЏ РїРѕРґРїРёСЃРєР°, РїРѕРєР°Р·С‹РІР°РµРј СЃРѕРѕР±С‰РµРЅРёРµ
    if subscription_required:
        channel_username = REQUIRED_CHANNEL.replace('@', '')
        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="рџ“ў РџРѕРґРїРёСЃР°С‚СЊСЃСЏ РЅР° РєР°РЅР°Р»", url=f"https://t.me/{channel_username}")],
            [InlineKeyboardButton(text="рџ”„ РџСЂРѕРІРµСЂРёС‚СЊ РїРѕРґРїРёСЃРєСѓ", callback_data="check_subscription")]
        ])
        
        # Р”РѕР±Р°РІР»СЏРµРј СЂРµС„РµСЂР°Р»СЊРЅРѕРµ СЃРѕРѕР±С‰РµРЅРёРµ, РµСЃР»Рё РµСЃС‚СЊ
        message_text = f"""
рџ”’ <b>РўСЂРµР±СѓРµС‚СЃСЏ РїРѕРґРїРёСЃРєР° РЅР° РєР°РЅР°Р»</b>

рџ“ў <b>Р”Р»СЏ РёСЃРїРѕР»СЊР·РѕРІР°РЅРёСЏ Р±РѕС‚Р° РЅРµРѕР±С…РѕРґРёРјРѕ РїРѕРґРїРёСЃР°С‚СЊСЃСЏ РЅР° РЅР°С€ РєР°РЅР°Р»:</b>
рџ‘‰ {REQUIRED_CHANNEL}

вњ… <b>РџРѕСЃР»Рµ РїРѕРґРїРёСЃРєРё РЅР°Р¶РјРёС‚Рµ РєРЅРѕРїРєСѓ "РџСЂРѕРІРµСЂРёС‚СЊ РїРѕРґРїРёСЃРєСѓ"</b>

<i>Р­С‚Рѕ РЅРµРѕР±С…РѕРґРёРјРѕ РґР»СЏ РїРѕР»СѓС‡РµРЅРёСЏ Р°РєС‚СѓР°Р»СЊРЅС‹С… РЅРѕРІРѕСЃС‚РµР№ Рё РѕР±РЅРѕРІР»РµРЅРёР№</i>
{referral_message}
"""
        await message.answer(message_text, parse_mode="HTML", reply_markup=kb)
        return
    
    # РџСЂРѕРІРµСЂСЏРµРј СЃРїРµС†РёР°Р»СЊРЅС‹Рµ РїР°СЂР°РјРµС‚СЂС‹ РєРѕРјР°РЅРґС‹ start
    if command and command.args:
        if command.args.startswith("payment_success_"):
            # РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ РІРµСЂРЅСѓР»СЃСЏ РїРѕСЃР»Рµ РѕРїР»Р°С‚С‹ (Platega)
            payment_id = command.args.replace("payment_success_", "")
            await message.answer(f"""
вњ… <b>РЎРїР°СЃРёР±Рѕ Р·Р° РѕРїР»Р°С‚Сѓ!</b>

рџ’і <b>Р’Р°С€ РїР»Р°С‚РµР¶ РѕР±СЂР°Р±Р°С‚С‹РІР°РµС‚СЃСЏ</b>
рџ†” <b>ID РїР»Р°С‚РµР¶Р°:</b> {payment_id}

рџ”„ <b>РќР°Р¶РјРёС‚Рµ РєРЅРѕРїРєСѓ "РџСЂРѕРІРµСЂРёС‚СЊ СЃС‚Р°С‚СѓСЃ" РґР»СЏ РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ</b>

<i>РћР±С‹С‡РЅРѕ РїР»Р°С‚РµР¶ РїРѕРґС‚РІРµСЂР¶РґР°РµС‚СЃСЏ РІ С‚РµС‡РµРЅРёРµ РЅРµСЃРєРѕР»СЊРєРёС… РјРёРЅСѓС‚</i>
""", parse_mode="HTML", reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="рџ”„ РџСЂРѕРІРµСЂРёС‚СЊ СЃС‚Р°С‚СѓСЃ", callback_data=f"check_payment_{payment_id}")],
                [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
            ]))
            return
        elif command.args.startswith("payment_failed_"):
            # РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ РІРµСЂРЅСѓР»СЃСЏ РїРѕСЃР»Рµ РЅРµСѓРґР°С‡РЅРѕР№ РѕРїР»Р°С‚С‹ (Platega)
            payment_id = command.args.replace("payment_failed_", "")
            await message.answer(f"""
вќЊ <b>РћРїР»Р°С‚Р° РЅРµ Р·Р°РІРµСЂС€РµРЅР°</b>

рџ’і <b>РџР»Р°С‚РµР¶ РЅРµ Р±С‹Р» РѕР±СЂР°Р±РѕС‚Р°РЅ</b>
рџ†” <b>ID РїР»Р°С‚РµР¶Р°:</b> {payment_id}

рџ”„ <b>РџРѕРїСЂРѕР±СѓР№С‚Рµ СЃРЅРѕРІР° РёР»Рё РїСЂРѕРІРµСЂСЊС‚Рµ СЃС‚Р°С‚СѓСЃ</b>

<i>Р•СЃР»Рё РІС‹ РѕРїР»Р°С‚РёР»Рё, РЅРѕ РІРёРґРёС‚Рµ СЌС‚Рѕ СЃРѕРѕР±С‰РµРЅРёРµ, РЅР°Р¶РјРёС‚Рµ "РџСЂРѕРІРµСЂРёС‚СЊ СЃС‚Р°С‚СѓСЃ"</i>
""", parse_mode="HTML", reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="рџ”„ РџСЂРѕРІРµСЂРёС‚СЊ СЃС‚Р°С‚СѓСЃ", callback_data=f"check_payment_{payment_id}")],
                [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
            ]))
            return
        elif command.args == "payment_success":
            # РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ РІРµСЂРЅСѓР»СЃСЏ РїРѕСЃР»Рµ РѕРїР»Р°С‚С‹ (СЃС‚Р°СЂР°СЏ СЃРёСЃС‚РµРјР°, Р±РµР· ID)
            await message.answer("""
вњ… <b>РЎРїР°СЃРёР±Рѕ Р·Р° РѕРїР»Р°С‚Сѓ!</b>

рџ’і <b>Р’Р°С€ РїР»Р°С‚РµР¶ РѕР±СЂР°Р±Р°С‚С‹РІР°РµС‚СЃСЏ</b>
рџ”„ <b>РќР°Р¶РјРёС‚Рµ РєРЅРѕРїРєСѓ "РџСЂРѕРІРµСЂРёС‚СЊ СЃС‚Р°С‚СѓСЃ" РґР»СЏ РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ</b>

<i>РћР±С‹С‡РЅРѕ РїР»Р°С‚РµР¶ РїРѕРґС‚РІРµСЂР¶РґР°РµС‚СЃСЏ РІ С‚РµС‡РµРЅРёРµ РЅРµСЃРєРѕР»СЊРєРёС… РјРёРЅСѓС‚</i>
""", parse_mode="HTML", reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
            ]))
            return
        elif command.args == "balance_success":
            # РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ РІРµСЂРЅСѓР»СЃСЏ РїРѕСЃР»Рµ РѕРїР»Р°С‚С‹ РїРѕРїРѕР»РЅРµРЅРёСЏ Р±Р°Р»Р°РЅСЃР° (СЃС‚Р°СЂР°СЏ СЃРёСЃС‚РµРјР°)
            await message.answer("""
вњ… <b>РЎРїР°СЃРёР±Рѕ Р·Р° РѕРїР»Р°С‚Сѓ!</b>

рџ’і <b>Р’Р°С€ РїР»Р°С‚РµР¶ РѕР±СЂР°Р±Р°С‚С‹РІР°РµС‚СЃСЏ</b>
рџ”„ <b>РќР°Р¶РјРёС‚Рµ РєРЅРѕРїРєСѓ "РџСЂРѕРІРµСЂРёС‚СЊ СЃС‚Р°С‚СѓСЃ" РґР»СЏ РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ</b>

<i>РћР±С‹С‡РЅРѕ РїР»Р°С‚РµР¶ РїРѕРґС‚РІРµСЂР¶РґР°РµС‚СЃСЏ РІ С‚РµС‡РµРЅРёРµ РЅРµСЃРєРѕР»СЊРєРёС… РјРёРЅСѓС‚</i>
""", parse_mode="HTML", reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")],
                [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
            ]))
            return
    
    # Р РµС„РµСЂР°Р»СЊРЅС‹Р№ РєРѕРґ СѓР¶Рµ РѕР±СЂР°Р±РѕС‚Р°РЅ РІС‹С€Рµ, РїРµСЂРµРґ РїСЂРѕРІРµСЂРєРѕР№ РїРѕРґРїРёСЃРєРё
    # Р•СЃР»Рё РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ Р·Р°С…РѕРґРёС‚ Р±РµР· СЂРµС„РµСЂР°Р»СЊРЅРѕР№ СЃСЃС‹Р»РєРё, СѓСЃС‚Р°РЅР°РІР»РёРІР°РµРј СЃРїРѕСЃРѕР± РІС…РѕРґР° РєР°Рє 'direct'
    if not command or not command.args:
        if DJANGO_INTEGRATION:
            try:
                import aiohttp
                
                # РЈСЃС‚Р°РЅР°РІР»РёРІР°РµРј СЃРїРѕСЃРѕР± РІС…РѕРґР° РєР°Рє 'direct' РґР»СЏ СЃСѓС‰РµСЃС‚РІСѓСЋС‰РёС… РїРѕР»СЊР·РѕРІР°С‚РµР»РµР№
                api_url = 'http://127.0.0.1:8123/bot_management/api/user/set-entry-method/'
                async with aiohttp.ClientSession() as session:
                    async with session.post(api_url, data={
                        'user_id': user.id,
                        'entry_method': 'direct'
                    }) as response:
                        if response.status != 200:
                            print(f"РћС€РёР±РєР° СѓСЃС‚Р°РЅРѕРІРєРё СЃРїРѕСЃРѕР±Р° РІС…РѕРґР°: {response.status}")
            except Exception as e:
                print(f"РћС€РёР±РєР° СѓСЃС‚Р°РЅРѕРІРєРё СЃРїРѕСЃРѕР±Р° РІС…РѕРґР°: {e}")

    # Inline РєР»Р°РІРёР°С‚СѓСЂР°
    keyboard = [
        [InlineKeyboardButton(text="рџ”‘ РџРѕР»СѓС‡РёС‚СЊ РєР»СЋС‡", callback_data="get_key_menu")],
    ]
    
    # РџСЂРѕРІРµСЂСЏРµРј, РІРєР»СЋС‡РµРЅР° Р»Рё С„СѓРЅРєС†РёСЏ "РџРѕР»СѓС‡РёС‚СЊ РєР»СЋС‡ Сѓ РјРµРЅРµРґР¶РµСЂР°"
    manager_key_delivery_enabled = True  # РџРѕ СѓРјРѕР»С‡Р°РЅРёСЋ РІРєР»СЋС‡РµРЅРѕ
    if DJANGO_INTEGRATION:
        try:
            import aiohttp
            api_url = 'http://127.0.0.1:8123/bot_management/api/settings/get/?key=manager_key_delivery_enabled'
            async with aiohttp.ClientSession() as session:
                async with session.get(api_url) as response:
                    if response.status == 200:
                        data = await response.json()
                        if data.get('success'):
                            value = data.get('value')
                            if value is not None:
                                manager_key_delivery_enabled = str(value).lower() == 'true'
        except:
            pass  # РСЃРїРѕР»СЊР·СѓРµРј Р·РЅР°С‡РµРЅРёРµ РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ
    
    # Р”РѕР±Р°РІР»СЏРµРј РєРЅРѕРїРєСѓ "РџРѕР»СѓС‡РёС‚СЊ РєР»СЋС‡ Сѓ РјРµРЅРµРґР¶РµСЂР°" РµСЃР»Рё С„СѓРЅРєС†РёСЏ РІРєР»СЋС‡РµРЅР°
    if manager_key_delivery_enabled:
        keyboard.append([InlineKeyboardButton(text="рџ“ћ РџРѕР»СѓС‡РёС‚СЊ РєР»СЋС‡ Сѓ РјРµРЅРµРґР¶РµСЂР°", url="https://t.me/yamalube61")])
    
    keyboard.extend([
        [InlineKeyboardButton(text="рџ”ђ РњРѕРё РєР»СЋС‡Рё", callback_data="my_keys"), InlineKeyboardButton(text="рџ‘¤ РџСЂРѕС„РёР»СЊ", callback_data="profile")],
        [InlineKeyboardButton(text="рџ‘Ґ Р РµС„РµСЂР°Р»СЊРЅР°СЏ СЃРёСЃС‚РµРјР°", callback_data="referral_info")],
        [InlineKeyboardButton(text="рџ“Њ РџСЂРѕРєСЃРё РґР»СЏ Telegram", callback_data="tg_proxy")],
        [InlineKeyboardButton(text="в­ђ РћС‚Р·С‹РІС‹", url="https://t.me/otzyvywebnetvpn")],
        [InlineKeyboardButton(text="рџ›  РџРѕРґРґРµСЂР¶РєР°", url="https://t.me/yamalube61"), InlineKeyboardButton(text="в„№пёЏ Рћ СЃРµСЂРІРёСЃРµ", callback_data="about")],
    ])
    
    # Р”РѕР±Р°РІР»СЏРµРј РєРЅРѕРїРєСѓ Р°РґРјРёРЅРєРё РґР»СЏ Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂРѕРІ
    if is_admin(user.id):
        keyboard.append([InlineKeyboardButton(text="рџ”§ РђРґРјРёРЅ-РїР°РЅРµР»СЊ", callback_data="admin_panel")])
    
    kb = InlineKeyboardMarkup(inline_keyboard=keyboard)
    
    # РћР±С‹С‡РЅР°СЏ РєР»Р°РІРёР°С‚СѓСЂР°
    reply_kb = ReplyKeyboardMarkup(
        keyboard=[
            [KeyboardButton(text="РњРµРЅСЋ")]
        ],
        resize_keyboard=True,
        one_time_keyboard=False
    )

    welcome_text = f"""
<b>Р“Р»СѓС€Р°С‚ СЃРІСЏР·СЊ?</b>{referral_message}

<b>РњС‹ РїРѕРјРѕРіР°РµРј РѕСЃС‚Р°РІР°С‚СЊСЃСЏ РЅР° СЃРІСЏР·Рё 24/7.</b>

Р“РґРµ Р±С‹ РІС‹ РЅРё Р±С‹Р»Рё вЂ” РІ Р»СЋР±РѕР№ С‚РѕС‡РєРµ РЅР°С€РµР№ СЃС‚СЂР°РЅС‹рџ‡·рџ‡є.

РќРµРІР°Р¶РЅРѕ, С‡С‚Рѕ РІС‹ РёСЃРїРѕР»СЊР·СѓРµС‚Рµ вЂ” Wi-Fi РёР»Рё РјРѕР±РёР»СЊРЅС‹Рµ РґР°РЅРЅС‹Рµ.

рџ”Ґ <b>Р Р°Р±РѕС‚Р°РµС‚ РЅР° РІСЃРµС… РѕРїРµСЂР°С‚РѕСЂР°С….</b>
вњ… <b>Р Р°Р±РѕС‚Р°РµС‚ РІРѕ РІСЃРµС… РіРѕСЂРѕРґР°С….</b>

<i>Р’С‹Р±РµСЂРёС‚Рµ РґРµР№СЃС‚РІРёРµ РёР· РјРµРЅСЋ РЅРёР¶Рµ: в¬‡пёЏ</i>
"""
    
    # Р’РёРґРµРѕ РѕС‚РєР»СЋС‡РµРЅРѕ - РѕС‚РїСЂР°РІР»СЏРµРј С‚РѕР»СЊРєРѕ РѕСЃРЅРѕРІРЅРѕРµ СЃРѕРѕР±С‰РµРЅРёРµ СЃ С„РѕС‚РѕРіСЂР°С„РёРµР№
    await send_welcome_with_photo(message, welcome_text, reply_markup=kb, reply_keyboard=reply_kb)

# РџСЂРѕРІРµСЂРєР° РїРѕРґРїРёСЃРєРё РЅР° РєР°РЅР°Р» (callback)
@router.callback_query(F.data == "check_subscription")
async def check_subscription(callback: CallbackQuery):
    """РџСЂРѕРІРµСЂРєР° РїРѕРґРїРёСЃРєРё РЅР° РєР°РЅР°Р»"""
    user = callback.from_user
    
    # Р’РђР–РќРћ: РЈР±РµР¶РґР°РµРјСЃСЏ, С‡С‚Рѕ РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ Р·Р°СЂРµРіРёСЃС‚СЂРёСЂРѕРІР°РЅ РІ Р‘Р”
    # РґР°Р¶Рµ РµСЃР»Рё РѕРЅ РµС‰Рµ РЅРµ РїРѕРґРїРёСЃР°РЅ (РЅР° СЃР»СѓС‡Р°Р№ РµСЃР»Рё РѕРЅ РЅРµ Р±С‹Р» Р·Р°СЂРµРіРёСЃС‚СЂРёСЂРѕРІР°РЅ СЂР°РЅРµРµ)
    if DJANGO_INTEGRATION:
        user_data = {
            'user_id': user.id,
            'username': user.username if user.username else None,
            'first_name': user.first_name if user.first_name else None,
            'last_name': user.last_name if user.last_name else None
        }
        await notify_django_new_user(user_data)
    
    try:
        # РСЃРїРѕР»СЊР·СѓРµРј ID РєР°РЅР°Р»Р° (Р±РѕР»РµРµ РЅР°РґРµР¶РЅРѕ)
        channel_member = await bot.get_chat_member(REQUIRED_CHANNEL_ID, user.id)
        
        if channel_member.status in ['member', 'administrator', 'creator']:
            # РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ РїРѕРґРїРёСЃР°РЅ - РїРѕРєР°Р·С‹РІР°РµРј РіР»Р°РІРЅРѕРµ РјРµРЅСЋ
            await callback.answer("вњ… РЎРїР°СЃРёР±Рѕ Р·Р° РїРѕРґРїРёСЃРєСѓ!", show_alert=False)
            # Р’С‹Р·С‹РІР°РµРј РіР»Р°РІРЅРѕРµ РјРµРЅСЋ РЅР°РїСЂСЏРјСѓСЋ
            await main_menu(callback)
        else:
            # РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ РІСЃРµ РµС‰Рµ РЅРµ РїРѕРґРїРёСЃР°РЅ
            channel_username = REQUIRED_CHANNEL.replace('@', '')
            kb = InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="рџ“ў РџРѕРґРїРёСЃР°С‚СЊСЃСЏ РЅР° РєР°РЅР°Р»", url=f"https://t.me/{channel_username}")],
                [InlineKeyboardButton(text="рџ”„ РџСЂРѕРІРµСЂРёС‚СЊ РїРѕРґРїРёСЃРєСѓ", callback_data="check_subscription")]
            ])
            await callback.message.edit_text(f"""
рџ”’ <b>РўСЂРµР±СѓРµС‚СЃСЏ РїРѕРґРїРёСЃРєР° РЅР° РєР°РЅР°Р»</b>

рџ“ў <b>Р”Р»СЏ РёСЃРїРѕР»СЊР·РѕРІР°РЅРёСЏ Р±РѕС‚Р° РЅРµРѕР±С…РѕРґРёРјРѕ РїРѕРґРїРёСЃР°С‚СЊСЃСЏ РЅР° РЅР°С€ РєР°РЅР°Р»:</b>
рџ‘‰ {REQUIRED_CHANNEL}

вњ… <b>РџРѕСЃР»Рµ РїРѕРґРїРёСЃРєРё РЅР°Р¶РјРёС‚Рµ РєРЅРѕРїРєСѓ "РџСЂРѕРІРµСЂРёС‚СЊ РїРѕРґРїРёСЃРєСѓ"</b>

<i>Р­С‚Рѕ РЅРµРѕР±С…РѕРґРёРјРѕ РґР»СЏ РїРѕР»СѓС‡РµРЅРёСЏ Р°РєС‚СѓР°Р»СЊРЅС‹С… РЅРѕРІРѕСЃС‚РµР№ Рё РѕР±РЅРѕРІР»РµРЅРёР№</i>
""", parse_mode="HTML", reply_markup=kb)
            await callback.answer("вќЊ Р’С‹ РµС‰Рµ РЅРµ РїРѕРґРїРёСЃР°РЅС‹ РЅР° РєР°РЅР°Р»", show_alert=True)
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РїСЂРѕРІРµСЂРєРё РїРѕРґРїРёСЃРєРё: {e}")
        channel_username = REQUIRED_CHANNEL.replace('@', '')
        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="рџ“ў РџРѕРґРїРёСЃР°С‚СЊСЃСЏ РЅР° РєР°РЅР°Р»", url=f"https://t.me/{channel_username}")],
            [InlineKeyboardButton(text="рџ”„ РџСЂРѕРІРµСЂРёС‚СЊ РїРѕРґРїРёСЃРєСѓ", callback_data="check_subscription")]
        ])
        await callback.message.edit_text(f"""
рџ”’ <b>РћС€РёР±РєР° РїСЂРѕРІРµСЂРєРё РїРѕРґРїРёСЃРєРё</b>

рџ“ў <b>Р”Р»СЏ РёСЃРїРѕР»СЊР·РѕРІР°РЅРёСЏ Р±РѕС‚Р° РЅРµРѕР±С…РѕРґРёРјРѕ РїРѕРґРїРёСЃР°С‚СЊСЃСЏ РЅР° РЅР°С€ РєР°РЅР°Р»:</b>
рџ‘‰ {REQUIRED_CHANNEL}

вњ… <b>РџРѕСЃР»Рµ РїРѕРґРїРёСЃРєРё РЅР°Р¶РјРёС‚Рµ РєРЅРѕРїРєСѓ "РџСЂРѕРІРµСЂРёС‚СЊ РїРѕРґРїРёСЃРєСѓ"</b>

<i>Р­С‚Рѕ РЅРµРѕР±С…РѕРґРёРјРѕ РґР»СЏ РїРѕР»СѓС‡РµРЅРёСЏ Р°РєС‚СѓР°Р»СЊРЅС‹С… РЅРѕРІРѕСЃС‚РµР№ Рё РѕР±РЅРѕРІР»РµРЅРёР№</i>
""", parse_mode="HTML", reply_markup=kb)
        await callback.answer("вќЊ РџРѕР¶Р°Р»СѓР№СЃС‚Р°, РїРѕРґРїРёС€РёС‚РµСЃСЊ РЅР° РєР°РЅР°Р»", show_alert=True)

# Р’С‹Р±РѕСЂ РїРѕРґРїРёСЃРєРё С‡РµСЂРµР· inline РєРЅРѕРїРєРё
@router.callback_query(F.data.in_(["sub_month", "sub_3months", "sub_6months", "sub_year", 
                                    "sub_regular_day", "sub_regular_month", "sub_regular_3months", 
                                    "sub_regular_6months", "sub_regular_year", "sub_regular_2years"]))
async def choose_subscription(callback: CallbackQuery, state: FSMContext):
    """РћР±СЂР°Р±РѕС‚С‡РёРє РІС‹Р±РѕСЂР° РїРѕРґРїРёСЃРєРё РґР»СЏ Night VPN Рё РћР±С‹С‡РЅРѕРіРѕ VPN"""
    # РћРїСЂРµРґРµР»СЏРµРј С‚РёРї РїРѕРґРїРёСЃРєРё Рё VPN
    regular_vpn_types = ["sub_regular_day", "sub_regular_month", "sub_regular_3months", 
                         "sub_regular_6months", "sub_regular_year", "sub_regular_2years"]
    
    is_regular_vpn = callback.data in regular_vpn_types
    vpn_type = "regular" if is_regular_vpn else "night"
    
    # РњР°РїРїРёРЅРі callback_data РЅР° С‚РёРї РїРѕРґРїРёСЃРєРё
    sub_type_map = {
        "sub_month": "month",
        "sub_3months": "3months",
        "sub_6months": "6months",
        "sub_year": "year",
        "sub_regular_day": "day",
        "sub_regular_month": "month",
        "sub_regular_3months": "3months",
        "sub_regular_6months": "6months",
        "sub_regular_year": "year",
        "sub_regular_2years": "2years"
    }
    
    sub_type = sub_type_map.get(callback.data, "month")
    
    # РџРѕР»СѓС‡Р°РµРј С†РµРЅСѓ РІ Р·Р°РІРёСЃРёРјРѕСЃС‚Рё РѕС‚ С‚РёРїР° VPN
    if is_regular_vpn:
        amount = REGULAR_VPN_PRICES.get(sub_type, 0)
    else:
        # Р”Р»СЏ Night VPN РїРѕР»СѓС‡Р°РµРј С†РµРЅСѓ РёР· Р±Р°Р·С‹ РґР°РЅРЅС‹С…
        try:
            import aiohttp
            api_url = 'http://127.0.0.1:8123/bot_management/api/prices/get/'
            async with aiohttp.ClientSession() as session:
                async with session.get(api_url) as response:
                    if response.status == 200:
                        data = await response.json()
                        prices = data.get('prices', {})
                        amount = prices.get(sub_type, PRICES.get(sub_type, 0))
                    else:
                        amount = PRICES.get(sub_type, 0)
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ С†РµРЅС‹: {e}")
            amount = PRICES.get(sub_type, 0)

    # РџСЂРѕРІРµСЂСЏРµРј РїРѕРґРїРёСЃРєСѓ РЅР° РєР°РЅР°Р» РїРµСЂРµРґ РѕРїР»Р°С‚РѕР№
    try:
        # РСЃРїРѕР»СЊР·СѓРµРј ID РєР°РЅР°Р»Р° (Р±РѕР»РµРµ РЅР°РґРµР¶РЅРѕ)
        channel_member = await bot.get_chat_member(REQUIRED_CHANNEL_ID, callback.from_user.id)

        if channel_member.status not in ['member', 'administrator', 'creator']:
            channel_username = REQUIRED_CHANNEL.replace('@', '')
            kb = InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="рџ“ў РџРѕРґРїРёСЃР°С‚СЊСЃСЏ РЅР° РєР°РЅР°Р»", url=f"https://t.me/{channel_username}")],
                [InlineKeyboardButton(text="рџ”„ РџСЂРѕРІРµСЂРёС‚СЊ РїРѕРґРїРёСЃРєСѓ", callback_data="check_subscription")],
                [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
            ])
            await callback.message.answer(f"""
рџ”’ <b>РўСЂРµР±СѓРµС‚СЃСЏ РїРѕРґРїРёСЃРєР° РЅР° РєР°РЅР°Р»</b>

рџ“ў <b>Р”Р»СЏ РїРѕРєСѓРїРєРё РїРѕРґРїРёСЃРєРё РЅРµРѕР±С…РѕРґРёРјРѕ РїРѕРґРїРёСЃР°С‚СЊСЃСЏ РЅР° РЅР°С€ РєР°РЅР°Р»:</b>
рџ‘‰ {REQUIRED_CHANNEL}

вњ… <b>РџРѕСЃР»Рµ РїРѕРґРїРёСЃРєРё РЅР°Р¶РјРёС‚Рµ РєРЅРѕРїРєСѓ "РџСЂРѕРІРµСЂРёС‚СЊ РїРѕРґРїРёСЃРєСѓ"</b>
""", parse_mode="HTML", reply_markup=kb)
            await callback.answer("вќЊ РўСЂРµР±СѓРµС‚СЃСЏ РїРѕРґРїРёСЃРєР° РЅР° РєР°РЅР°Р»", show_alert=True)
            return
    except Exception as e:
        logging.warning(f"РћС€РёР±РєР° РїСЂРѕРІРµСЂРєРё РїРѕРґРїРёСЃРєРё РЅР° РєР°РЅР°Р» {REQUIRED_CHANNEL_ID}: {e}")
        # РџСЂРѕРїСѓСЃРєР°РµРј РїСЂРѕРІРµСЂРєСѓ РїСЂРё РѕС€РёР±РєРµ (Р±РѕС‚ РЅРµ Р°РґРјРёРЅ РёР»Рё РґСЂСѓРіР°СЏ РѕС€РёР±РєР°)
        pass

    # РќР°Р·РІР°РЅРёСЏ РїРѕРґРїРёСЃРѕРє
    sub_names_night = {
        'month': 'РњРµСЃСЏС‡РЅР°СЏ РїРѕРґРїРёСЃРєР°',
        '3months': 'РџРѕРґРїРёСЃРєР° РЅР° 3 РјРµСЃСЏС†Р°',
        '6months': 'РџРѕРґРїРёСЃРєР° РЅР° 6 РјРµСЃСЏС†РµРІ',
        'year': 'Р“РѕРґРѕРІР°СЏ РїРѕРґРїРёСЃРєР°'
    }
    
    sub_names_regular = {
        'day': '1 РґРµРЅСЊ',
        'month': '1 РјРµСЃСЏС†',
        '3months': '3 РјРµСЃСЏС†Р°',
        '6months': '6 РјРµСЃСЏС†РµРІ',
        'year': '1 РіРѕРґ',
        '2years': '2 РіРѕРґР°'
    }
    
    sub_names = sub_names_regular if is_regular_vpn else sub_names_night
    sub_name = sub_names.get(sub_type, 'РџРѕРґРїРёСЃРєР°')
    vpn_label = "рџЊЌ РћР±С‹С‡РЅС‹Р№ VPN" if is_regular_vpn else "рџЊ™ Night VPN"

    payment_text = f"""
рџ’і <b>Р’С‹Р±РѕСЂ СЃРїРѕСЃРѕР±Р° РѕРїР»Р°С‚С‹</b>

{vpn_label}
рџ“… <b>РџРѕРґРїРёСЃРєР°:</b> {sub_name}
рџ’° <b>РЎСѓРјРјР°:</b> {amount} в‚Ѕ

<i>Р’С‹Р±РµСЂРёС‚Рµ СѓРґРѕР±РЅС‹Р№ РґР»СЏ РІР°СЃ СЃРїРѕСЃРѕР± РѕРїР»Р°С‚С‹:</i>
"""

    # РћРїСЂРµРґРµР»СЏРµРј callback_data РґР»СЏ РІРѕР·РІСЂР°С‚Р°
    back_callback = "catalog_regular_vpn" if is_regular_vpn else "catalog_night_vpn"

    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="рџ“± РЎР‘Рџ (QR-РєРѕРґ)", callback_data=f"pay_sbp_{sub_type}_{vpn_type}")],
        [InlineKeyboardButton(text="рџ’і Р‘Р°РЅРєРѕРІСЃРєРѕР№ РєР°СЂС‚РѕР№", callback_data=f"pay_bank_card_{sub_type}_{vpn_type}")],
        [InlineKeyboardButton(text="в‚ї РљСЂРёРїС‚РѕРІР°Р»СЋС‚РѕР№", callback_data=f"pay_crypto_{sub_type}_{vpn_type}")],
        [InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ", callback_data=back_callback)],
    ])

    try:
        await callback.message.edit_text(payment_text, parse_mode="HTML", reply_markup=kb)
    except:
        await callback.message.answer(payment_text, parse_mode="HTML", reply_markup=kb)

    await callback.answer()


# РџСЂРѕРІРµСЂРєР° СЃС‚Р°С‚СѓСЃР° РїР»Р°С‚РµР¶Р°
@router.callback_query(F.data.startswith("check_payment_"))
async def check_payment_status(callback: CallbackQuery):
    """РџСЂРѕРІРµСЂРєР° СЃС‚Р°С‚СѓСЃР° РїР»Р°С‚РµР¶Р° С‡РµСЂРµР· Platega API РїРѕ transaction_id"""
    payment_id = callback.data.split("_")[2]
    
    if DJANGO_INTEGRATION:
        try:
            import aiohttp
            import json
            
            # Р—Р°РїСЂРѕСЃ Рє API РґР»СЏ РїСЂРѕРІРµСЂРєРё СЃС‚Р°С‚СѓСЃР° С‡РµСЂРµР· Platega
            api_url = f'http://127.0.0.1:8123/bot_management/api/payments/{payment_id}/platega-status/'
            
            async with aiohttp.ClientSession() as session:
                async with session.get(api_url) as response:
                    if response.status == 200:
                        data = await response.json()
                        
                        if not data.get('success'):
                            error_message = data.get('message', 'РћС€РёР±РєР° РїСЂРѕРІРµСЂРєРё СЃС‚Р°С‚СѓСЃР°')
                            await callback.answer(f"вќЊ {error_message}", show_alert=True)
                            return
                        
                        platega_status = data.get('platega_status', 'unknown')
                        payment_status = data.get('payment_status', 'unknown')
                        
                        # РќРѕСЂРјР°Р»РёР·СѓРµРј СЃС‚Р°С‚СѓСЃ Platega (СЃРѕРіР»Р°СЃРЅРѕ РґРѕРєСѓРјРµРЅС‚Р°С†РёРё: PENDING, CANCELED, CONFIRMED, CHARGEBACKED)
                        platega_status_normalized = platega_status.upper() if platega_status else 'UNKNOWN'
                        
                        if platega_status_normalized == 'CONFIRMED' and payment_status == 'succeeded':
                            # РџР»Р°С‚РµР¶ СѓСЃРїРµС€РµРЅ, РїРѕР»СѓС‡Р°РµРј РєР»СЋС‡
                            issued_key = data.get('issued_key')
                            
                            if issued_key:
                                # РљР»СЋС‡ СѓР¶Рµ РІС‹РґР°РЅ (СѓРІРµРґРѕРјР»РµРЅРёРµ СѓС€Р»Рѕ РёР· РІРµР±С…СѓРєР°/СЃРµСЂРІРёСЃР°). РќРµ РґСѓР±Р»РёСЂСѓРµРј 2 СЃРѕРѕР±С‰РµРЅРёСЏ вЂ” С‚РѕР»СЊРєРѕ РєРѕСЂРѕС‚РєРѕРµ В«СѓР¶Рµ РѕС‚РїСЂР°РІР»РµРЅРѕВ».
                                chat_id = callback.message.chat.id
                                kb = InlineKeyboardMarkup(inline_keyboard=[
                                    [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
                                ])
                                await bot.send_message(
                                    chat_id,
                                    "вњ… <b>РџР»Р°С‚РµР¶ РїРѕРґС‚РІРµСЂР¶РґРµРЅ!</b>\n\nРљР»СЋС‡ Рё РёРЅСЃС‚СЂСѓРєС†РёРё СѓР¶Рµ РѕС‚РїСЂР°РІР»РµРЅС‹ РІР°Рј РІ С‡Р°С‚ РІС‹С€Рµ.",
                                    parse_mode="HTML",
                                    reply_markup=kb
                                )
                            else:
                                await callback.answer("вЏі РљР»СЋС‡ РµС‰Рµ РЅРµ РІС‹РґР°РЅ. РћР±СЂР°Р±Р°С‚С‹РІР°РµС‚СЃСЏ...", show_alert=True)
                        elif platega_status_normalized == 'CONFIRMED' and payment_status != 'succeeded':
                            # РџР»Р°С‚РµР¶ СѓСЃРїРµС€РµРЅ РІ Platega, РЅРѕ РµС‰Рµ РѕР±СЂР°Р±Р°С‚С‹РІР°РµС‚СЃСЏ Сѓ РЅР°СЃ
                            await callback.answer("вЏі РџР»Р°С‚РµР¶ РїРѕРґС‚РІРµСЂР¶РґРµРЅ, РѕР±СЂР°Р±Р°С‚С‹РІР°РµС‚СЃСЏ...", show_alert=True)
                        elif platega_status_normalized == 'PENDING':
                            await callback.answer("вЏі РџР»Р°С‚РµР¶ РµС‰Рµ РЅРµ РѕРїР»Р°С‡РµРЅ. РџРѕРїСЂРѕР±СѓР№С‚Рµ РїРѕР·Р¶Рµ.", show_alert=True)
                        elif platega_status_normalized == 'CANCELED':
                            await send_or_edit_message_with_photo(callback, """
вќЊ <b>РџР»Р°С‚РµР¶ РѕС‚РјРµРЅРµРЅ</b>

рџ”„ <b>Р§С‚Рѕ РґРµР»Р°С‚СЊ:</b>
вЂў РЎРѕР·РґР°Р№С‚Рµ РЅРѕРІС‹Р№ РїР»Р°С‚РµР¶
вЂў РР»Рё РѕР±СЂР°С‚РёС‚РµСЃСЊ РІ РїРѕРґРґРµСЂР¶РєСѓ

<i>РџРѕРїСЂРѕР±СѓР№С‚Рµ РµС‰Рµ СЂР°Р·! рџљЂ</i>
""", parse_mode="HTML", reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                                [InlineKeyboardButton(text="рџ”„ РЎРѕР·РґР°С‚СЊ РЅРѕРІС‹Р№ РїР»Р°С‚РµР¶", callback_data="catalog")],
                                [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
                            ]))
                        else:
                            await callback.answer(f"вќ“ РЎС‚Р°С‚СѓСЃ РїР»Р°С‚РµР¶Р°: {platega_status}", show_alert=True)
                    elif response.status == 404:
                        await callback.answer("вќЊ РџР»Р°С‚РµР¶ РЅРµ РЅР°Р№РґРµРЅ", show_alert=True)
                    else:
                        error_text = await response.text()
                        await callback.answer("вќЊ РћС€РёР±РєР° РїСЂРѕРІРµСЂРєРё СЃС‚Р°С‚СѓСЃР°", show_alert=True)
                        logging.error(f"РћС€РёР±РєР° РїСЂРѕРІРµСЂРєРё СЃС‚Р°С‚СѓСЃР° РїР»Р°С‚РµР¶Р° {payment_id}: {response.status} - {error_text}")
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° РїСЂРѕРІРµСЂРєРё СЃС‚Р°С‚СѓСЃР° РїР»Р°С‚РµР¶Р°: {e}")
            import traceback
            logging.error(traceback.format_exc())
            await callback.answer("вќЊ РћС€РёР±РєР° РїСЂРѕРІРµСЂРєРё СЃС‚Р°С‚СѓСЃР°", show_alert=True)
    else:
        await callback.answer("вќЊ РРЅС‚РµРіСЂР°С†РёСЏ СЃ РїР»Р°С‚РµР¶Р°РјРё РЅРµРґРѕСЃС‚СѓРїРЅР°", show_alert=True)

# Р’СЃРїРѕРјРѕРіР°С‚РµР»СЊРЅС‹Рµ С„СѓРЅРєС†РёРё РґР»СЏ СЂР°Р±РѕС‚С‹ СЃ Р®Kassa API
async def check_yookassa_payment_status(payment_id: int):
    """РџСЂРѕРІРµСЂСЏРµС‚ СЃС‚Р°С‚СѓСЃ РїР»Р°С‚РµР¶Р° С‡РµСЂРµР· API Р®Kassa"""
    try:
        import aiohttp
        
        # РџРѕР»СѓС‡Р°РµРј yookassa_payment_id РёР· РЅР°С€РµР№ Р±Р°Р·С‹
        api_url = f'http://127.0.0.1:8123/bot_management/api/balance/payment-status/{payment_id}/'
        
        async with aiohttp.ClientSession() as session:
            async with session.get(api_url) as response:
                if response.status == 200:
                    data = await response.json()
                    logging.info(f"DEBUG: РџРѕР»СѓС‡РµРЅС‹ РґР°РЅРЅС‹Рµ РїР»Р°С‚РµР¶Р° {payment_id}: {data}")
                    
                    if data.get('success', False):
                        # РџРѕР»СѓС‡Р°РµРј yookassa_payment_id РёР· Р±Р°Р·С‹ РґР°РЅРЅС‹С…
                        yookassa_payment_id = data.get('yookassa_payment_id')
                        if yookassa_payment_id:
                            logging.info(f"DEBUG: РџСЂРѕРІРµСЂСЏРµРј СЃС‚Р°С‚СѓСЃ С‡РµСЂРµР· Р®Kassa РґР»СЏ ID: {yookassa_payment_id}")
                            
                            # РџСЂРѕРІРµСЂСЏРµРј СЃС‚Р°С‚СѓСЃ С‡РµСЂРµР· Р®Kassa API
                            yookassa_api_url = f'http://127.0.0.1:8123/bot_management/api/payments/{yookassa_payment_id}/yookassa-status/'
                            async with session.post(yookassa_api_url) as yookassa_response:
                                logging.info(f"DEBUG: Р—Р°РїСЂРѕСЃ Рє Р®Kassa API: {yookassa_api_url}, СЃС‚Р°С‚СѓСЃ: {yookassa_response.status}")
                                
                                if yookassa_response.status == 200:
                                    yookassa_data = await yookassa_response.json()
                                    logging.info(f"DEBUG: РћС‚РІРµС‚ РѕС‚ Р®Kassa API: {yookassa_data}")
                                    return yookassa_data
                                else:
                                    logging.error(f"DEBUG: РћС€РёР±РєР° Р®Kassa API: {yookassa_response.status}")
                        else:
                            logging.warning(f"DEBUG: yookassa_payment_id РЅРµ РЅР°Р№РґРµРЅ РґР»СЏ РїР»Р°С‚РµР¶Р° {payment_id}")
                    else:
                        logging.warning(f"DEBUG: API РІРµСЂРЅСѓР» success=False РґР»СЏ РїР»Р°С‚РµР¶Р° {payment_id}")
                else:
                    logging.error(f"DEBUG: РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ РґР°РЅРЅС‹С… РїР»Р°С‚РµР¶Р° {payment_id}: {response.status}")
        return None
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РїСЂРѕРІРµСЂРєРё СЃС‚Р°С‚СѓСЃР° С‡РµСЂРµР· Р®Kassa API: {e}")
        return None

async def confirm_payment_in_system(payment_id: int, user_id: int):
    """РџРѕРґС‚РІРµСЂР¶РґР°РµС‚ РїР»Р°С‚РµР¶ РІ РЅР°С€РµР№ СЃРёСЃС‚РµРјРµ"""
    try:
        import aiohttp
        
        # РџРѕРґС‚РІРµСЂР¶РґР°РµРј РїР»Р°С‚РµР¶ С‡РµСЂРµР· API
        api_url = f'http://127.0.0.1:8123/bot_management/api/balance/payment-confirm/{payment_id}/'
        
        async with aiohttp.ClientSession() as session:
            async with session.post(api_url) as response:
                if response.status == 200:
                    data = await response.json()
                    if data.get('success', False):
                        # РћС‚РїСЂР°РІР»СЏРµРј СѓРІРµРґРѕРјР»РµРЅРёРµ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ
                        success_text = f"""
вњ… <b>РџР»Р°С‚РµР¶ РїРѕРґС‚РІРµСЂР¶РґРµРЅ!</b>

рџ’° <b>РЎСѓРјРјР°:</b> {data.get('amount', 0)} в‚Ѕ

<i>РЎРїР°СЃРёР±Рѕ Р·Р° РѕРїР»Р°С‚Сѓ! рџљЂ</i>
"""
                        
                        kb = InlineKeyboardMarkup(inline_keyboard=[
                            [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")],
                            [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
                        ])
                        
                        await bot.send_message(
                            chat_id=user_id,
                            text=success_text,
                            parse_mode="HTML",
                            reply_markup=kb
                        )
                        
                        logging.info(f"DEBUG: РџР»Р°С‚РµР¶ {payment_id} Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРё РїРѕРґС‚РІРµСЂР¶РґРµРЅ С‡РµСЂРµР· Р®Kassa")
                        return True
        return False
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ РїР»Р°С‚РµР¶Р° {payment_id}: {e}")
        return False

async def handle_canceled_payment(payment_id: int, user_id: int, yookassa_data):
    """РћР±СЂР°Р±Р°С‚С‹РІР°РµС‚ РѕС‚РјРµРЅРµРЅРЅС‹Р№ РїР»Р°С‚РµР¶"""
