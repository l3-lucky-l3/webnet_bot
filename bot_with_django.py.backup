async def check_yookassa_direct(yookassa_payment_id: str):
    """РџСЂСЏРјР°СЏ РїСЂРѕРІРµСЂРєР° СЃС‚Р°С‚СѓСЃР° РїР»Р°С‚РµР¶Р° С‡РµСЂРµР· Р®Kassa API"""
    try:
        import aiohttp
        
        # РСЃРїРѕР»СЊР·СѓРµРј РЅР°С€ API endpoint РґР»СЏ РїСЂРѕРІРµСЂРєРё С‡РµСЂРµР· Р®Kassa
        api_url = f'http://127.0.0.1:8123/bot_management/api/payments/{yookassa_payment_id}/yookassa-status/'
        
        async with aiohttp.ClientSession() as session:
            async with session.post(api_url) as response:
                if response.status == 200:
                    data = await response.json()
                    logging.info(f"DEBUG: РџСЂСЏРјР°СЏ РїСЂРѕРІРµСЂРєР° Р®Kassa РґР»СЏ {yookassa_payment_id}: {data}")
                    return data
                else:
                    logging.error(f"DEBUG: РћС€РёР±РєР° РїСЂСЏРјРѕР№ РїСЂРѕРІРµСЂРєРё Р®Kassa: {response.status}")
                    return None
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РїСЂСЏРјРѕР№ РїСЂРѕРІРµСЂРєРё Р®Kassa: {e}")
        return None

# Р¤СѓРЅРєС†РёСЏ Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРѕР№ РїСЂРѕРІРµСЂРєРё СѓРґР°Р»РµРЅР° - С‚РµРїРµСЂСЊ РїСЂРѕРІРµСЂРєР° С‚РѕР»СЊРєРѕ РїРѕ РєРЅРѕРїРєРµ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ

# РџСЂРѕРІРµСЂРєР° СЃС‚Р°С‚СѓСЃР° РїСЂРѕСЃС‚РѕРіРѕ РїР»Р°С‚РµР¶Р° РїРѕРїРѕР»РЅРµРЅРёСЏ Р±Р°Р»Р°РЅСЃР°
@router.callback_query(F.data.startswith("check_simple_payment_"))
async def check_simple_payment_status(callback: CallbackQuery):
    """РџСЂРѕРІРµСЂРєР° СЃС‚Р°С‚СѓСЃР° РїСЂРѕСЃС‚РѕРіРѕ РїР»Р°С‚РµР¶Р° РїРѕРїРѕР»РЅРµРЅРёСЏ Р±Р°Р»Р°РЅСЃР°"""
    payment_id = callback.data.split("_")[3]  # check_simple_payment_123 -> 123
    user_id = callback.from_user.id
    
    if DJANGO_INTEGRATION:
        try:
            from bot_management.simple_bot_handlers import check_simple_payment_status as check_status, send_payment_success_message, send_payment_pending_message, send_payment_error_message
            
            # РџСЂРѕРІРµСЂСЏРµРј СЃС‚Р°С‚СѓСЃ РїР»Р°С‚РµР¶Р°
            result = await check_status(payment_id, user_id)
            
            if result.get('success'):
                status = result.get('status')
                
                if status == 'succeeded':
                    # РџР»Р°С‚РµР¶ СѓСЃРїРµС€РµРЅ
                    await send_payment_success_message(
                        user_id=user_id,
                        amount=result.get('amount', 0),
                        new_balance=None  # РњРѕР¶РЅРѕ РґРѕР±Р°РІРёС‚СЊ РїРѕР»СѓС‡РµРЅРёРµ Р±Р°Р»Р°РЅСЃР°
                    )
                elif status == 'pending':
                    # РџР»Р°С‚РµР¶ РІ РѕР¶РёРґР°РЅРёРё
                    await send_payment_pending_message(
                        user_id=user_id,
                        payment_id=payment_id,
                        amount=result.get('amount', 0)
                    )
                else:
                    # РџР»Р°С‚РµР¶ РЅРµ РїСЂРѕС€РµР»
                    await send_payment_error_message(
                        user_id=user_id,
                        message=f"РЎС‚Р°С‚СѓСЃ РїР»Р°С‚РµР¶Р°: {status}"
                    )
            else:
                await send_payment_error_message(
                    user_id=user_id,
                    message=result.get('message', 'РћС€РёР±РєР° РїСЂРѕРІРµСЂРєРё СЃС‚Р°С‚СѓСЃР°')
                )
                
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° РїСЂРѕРІРµСЂРєРё СЃС‚Р°С‚СѓСЃР° РїСЂРѕСЃС‚РѕРіРѕ РїР»Р°С‚РµР¶Р°: {e}")
            await callback.answer("вќЊ РћС€РёР±РєР° РїСЂРѕРІРµСЂРєРё СЃС‚Р°С‚СѓСЃР°", show_alert=True)
    else:
        await callback.answer("вќЊ РРЅС‚РµРіСЂР°С†РёСЏ СЃ РїР»Р°С‚РµР¶Р°РјРё РЅРµРґРѕСЃС‚СѓРїРЅР°", show_alert=True)

# РџСЂРѕРІРµСЂРєР° СЃС‚Р°С‚СѓСЃР° РїР»Р°С‚РµР¶Р° РїРѕРїРѕР»РЅРµРЅРёСЏ Р±Р°Р»Р°РЅСЃР° (СЃС‚Р°СЂР°СЏ СЃРёСЃС‚РµРјР°)
# РћР±СЂР°Р±РѕС‚С‡РёРє РїСЂРѕРІРµСЂРєРё СЃС‚Р°С‚СѓСЃР° РїР»Р°С‚РµР¶Р° Р±Р°Р»Р°РЅСЃР° РѕС‚РєР»СЋС‡РµРЅ - РїРѕРєСѓРїРєРё С‚РµРїРµСЂСЊ РЅР°РїСЂСЏРјСѓСЋ
