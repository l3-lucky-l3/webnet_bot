"""
                    
                    kb_buttons = []
                    # РЎРѕР·РґР°РµРј РєРЅРѕРїРєРё РґР»СЏ РєР°Р¶РґРѕРіРѕ РїР»Р°С‚РµР¶Р°
                    for payment in payments[:10]:  # РџРѕРєР°Р·С‹РІР°РµРј РїРµСЂРІС‹Рµ 10
                        payment_id = payment.get('payment_id', 'N/A')
                        amount = payment.get('amount', 0)
                        status = payment.get('status', 'N/A')
                        sub_type = payment.get('subscription_type', 'N/A')
                        
