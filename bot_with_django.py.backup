@router.callback_query(F.data == "catalog_night_vpn")
async def show_night_vpn_catalog(callback: CallbackQuery):
    """РџРѕРєР°Р·Р°С‚СЊ РєР°С‚Р°Р»РѕРі Night VPN"""
    # РџРѕР»СѓС‡Р°РµРј С†РµРЅС‹ РёР· Р±Р°Р·С‹ РґР°РЅРЅС‹С…
    prices = {}
    try:
        import aiohttp
        api_url = 'http://127.0.0.1:8123/bot_management/api/prices/get/'
        async with aiohttp.ClientSession() as session:
            async with session.get(api_url) as response:
                if response.status == 200:
                    data = await response.json()
                    prices = data.get('prices', {})
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ С†РµРЅ РґР»СЏ РєР°С‚Р°Р»РѕРіР°: {e}")
        # Fallback РЅР° config.py
        prices = {
            'month': PRICES.get('month', 390),
            '3months': PRICES.get('3months', 990),
            'year': PRICES.get('year', 3900)
        }

    # Р•СЃР»Рё С†РµРЅС‹ РЅРµ РїРѕР»СѓС‡РµРЅС‹, РёСЃРїРѕР»СЊР·СѓРµРј Р·РЅР°С‡РµРЅРёСЏ РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ
    month_price = prices.get('month', PRICES.get('month', 390))
    three_months_price = prices.get('3months', PRICES.get('3months', 990))
    six_months_price = prices.get('6months', PRICES.get('6months', 1890))
    year_price = prices.get('year', PRICES.get('year', 3900))

    # Р’С‹С‡РёСЃР»СЏРµРј СЌРєРѕРЅРѕРјРёСЋ
    three_months_savings = (month_price * 3) - three_months_price
    six_months_savings = (month_price * 6) - six_months_price
    year_savings = (month_price * 12) - year_price

    catalog_text = f"""
рџЊ™ <b>Night VPN - РљСѓРїРёС‚СЊ РєР»СЋС‡</b>

рџ’Ћ <b>Р’С‹Р±РµСЂРёС‚Рµ РїРѕРґС…РѕРґСЏС‰СѓСЋ РїРѕРґРїРёСЃРєСѓ:</b>

рџ“… <b>1 РјРµСЃСЏС†</b>
вЂў РЎС‚РѕРёРјРѕСЃС‚СЊ: {month_price} в‚Ѕ
вЂў РЎСЂРѕРє РґРµР№СЃС‚РІРёСЏ: 30 РґРЅРµР№

рџ“… <b>3 РјРµСЃСЏС†Р°</b>
вЂў РЎС‚РѕРёРјРѕСЃС‚СЊ: {three_months_price} в‚Ѕ
вЂў РЎСЂРѕРє РґРµР№СЃС‚РІРёСЏ: 90 РґРЅРµР№
{f'вЂў рџ’° <b>Р­РєРѕРЅРѕРјРёСЏ: {three_months_savings} в‚Ѕ</b>' if three_months_savings > 0 else ''}

рџ“… <b>6 РјРµСЃСЏС†РµРІ</b>
вЂў РЎС‚РѕРёРјРѕСЃС‚СЊ: {six_months_price} в‚Ѕ
