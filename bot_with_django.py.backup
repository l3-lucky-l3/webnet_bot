# РЈРЅРёРІРµСЂСЃР°Р»СЊРЅС‹Р№ РґРµРєРѕСЂР°С‚РѕСЂ РґР»СЏ Р·Р°С‰РёС‚С‹ РІСЃРµС… СЃРѕРѕР±С‰РµРЅРёР№
def protect_message(scope='messages'):
    """Р”РµРєРѕСЂР°С‚РѕСЂ РґР»СЏ Р·Р°С‰РёС‚С‹ СЃРѕРѕР±С‰РµРЅРёР№ РѕС‚ СЃРїР°РјР°"""
    def decorator(func):
        @wraps(func)
        async def wrapper(message: Message, *args, **kwargs):
            user_id = message.from_user.id

            # РџСЂРѕРїСѓСЃРєР°РµРј РІСЃРµ РїСЂРѕРІРµСЂРєРё РґР»СЏ Р°РґРјРёРЅРѕРІ
            if is_admin(user_id):
                logging.info(f"рџ‘‘ РђРґРјРёРЅ {user_id} РїСЂРѕРїСѓСЃРєР°РµС‚ Р·Р°С‰РёС‚Сѓ СЃРѕРѕР±С‰РµРЅРёР№ РІ {func.__name__}")
                return await func(message, *args, **kwargs)

            # РџСЂРѕРІРµСЂСЏРµРј, Р·Р°Р±Р»РѕРєРёСЂРѕРІР°РЅ Р»Рё РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ
            if bot_security.is_user_blocked(user_id):
                await message.answer("рџљ« Р’С‹ Р·Р°Р±Р»РѕРєРёСЂРѕРІР°РЅС‹ Р·Р° СЃРїР°Рј РЅР° 1 РјРёРЅСѓС‚Сѓ. РџРѕРґРѕР¶РґРёС‚Рµ.")
                return

            # РџСЂРѕРІРµСЂСЏРµРј Р»РёРјРёС‚ СЃРѕРѕР±С‰РµРЅРёР№ (True = Р·Р°Р±Р»РѕРєРёСЂРѕРІР°РЅ, False = РћРљ)
            is_blocked = bot_security.check_message_rate_limit(user_id)
            if is_blocked:
                await message.answer("рџљ« Р’С‹ Р·Р°Р±Р»РѕРєРёСЂРѕРІР°РЅС‹ Р·Р° СЃРїР°Рј РЅР° 1 РјРёРЅСѓС‚Сѓ. РџРѕРґРѕР¶РґРёС‚Рµ.")
                return

            # РџСЂРѕРІРµСЂСЏРµРј СЃРѕРґРµСЂР¶РёРјРѕРµ РЅР° СЃРїР°Рј
            if message.text:
                is_valid, error = validate_message_content(message.text)
                if not is_valid:
                    logging.warning(f"РЎРѕРѕР±С‰РµРЅРёРµ РѕС‚РєР»РѕРЅРµРЅРѕ: {error}")
                    return

            # Р•СЃР»Рё РІСЃРµ РћРљ, РІС‹РїРѕР»РЅСЏРµРј С„СѓРЅРєС†РёСЋ
            return await func(message, *args, **kwargs)
        return wrapper
    return decorator

# РќР°СЃС‚СЂРѕР№РєР° Django (РґРѕР»Р¶РЅР° Р±С‹С‚СЊ РїРµСЂРµРґ РёРјРїРѕСЂС‚Р°РјРё Django РјРѕРґРµР»РµР№)
