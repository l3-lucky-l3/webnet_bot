    """РџРѕРєР°Р·Р°С‚СЊ РјРµРЅСЋ РїРѕР»СѓС‡РµРЅРёСЏ РєР»СЋС‡Р° (РїСЂРѕР±РЅС‹Р№ РёР»Рё РїР»Р°С‚РЅС‹Р№)"""
    user_id = callback.from_user.id

    # РџСЂРѕРІРµСЂСЏРµРј, РёСЃРїРѕР»СЊР·РѕРІР°Р» Р»Рё РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ РїСЂРѕР±РЅС‹Р№ РєР»СЋС‡
    trial_used = False
    if DJANGO_INTEGRATION:
        try:
            import aiohttp
            api_url = f'http://127.0.0.1:8123/bot_management/api/user/{user_id}/trial_status/'
            async with aiohttp.ClientSession() as session:
                async with session.get(api_url) as response:
