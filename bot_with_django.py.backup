    await main_menu(callback)

# РћР±СЂР°Р±РѕС‚С‡РёРє reply СЃРѕРѕР±С‰РµРЅРёР№ (РїСЂРѕРґРѕР»Р¶РµРЅРёРµ РѕР±С‰РµРЅРёСЏ) - Р”РћР›Р–Р•Рќ Р‘Р«РўР¬ РџР•Р Р’Р«Рњ!
@router.message(F.reply_to_message)
@protect_message('messages')
async def handle_reply_message(message: Message, state: FSMContext):
    """РћР±СЂР°Р±РѕС‚РєР° reply СЃРѕРѕР±С‰РµРЅРёР№ РґР»СЏ РїСЂРѕРґРѕР»Р¶РµРЅРёСЏ РѕР±С‰РµРЅРёСЏ СЃ РїРѕРґРґРµСЂР¶РєРѕР№"""
    # Р•СЃР»Рё РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ РІ СЃРѕСЃС‚РѕСЏРЅРёРё РїРѕРёСЃРєР° СЂРµС„РµСЂРµСЂРѕРІ вЂ” РїРµСЂРµРґР°С‘Рј СЃРѕРѕР±С‰РµРЅРёРµ РІ РѕР±СЂР°Р±РѕС‚С‡РёРє РїРѕРёСЃРєР°
    current_state = await state.get_state()
    if current_state == ReferrersSearchState.waiting_search.state:
        await handle_referrers_search(message, state)
        return

    user_id = message.from_user.id
    reply_to = message.reply_to_message

    logging.info(f"DEBUG: Reply СЃРѕРѕР±С‰РµРЅРёРµ РѕС‚ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ {user_id}")
    logging.info(f"DEBUG: Reply to message: {reply_to.text if reply_to and reply_to.text else 'РќРµС‚ С‚РµРєСЃС‚Р°'}")
    logging.info(f"DEBUG: Reply to user ID: {reply_to.from_user.id if reply_to else 'РќРµС‚ reply_to'}")
    logging.info(f"DEBUG: Bot ID: {bot.id}")
    
    # РџСЂРѕРІРµСЂСЏРµРј, СЏРІР»СЏРµС‚СЃСЏ Р»Рё СЌС‚Рѕ РѕС‚РІРµС‚РѕРј РЅР° СЃРѕРѕР±С‰РµРЅРёРµ РѕС‚ РїРѕРґРґРµСЂР¶РєРё
    if reply_to and reply_to.from_user.id == bot.id:
        logging.info("DEBUG: Р­С‚Рѕ РѕС‚РІРµС‚ РЅР° СЃРѕРѕР±С‰РµРЅРёРµ РѕС‚ Р±РѕС‚Р°")
        
        # РџСЂРѕРІРµСЂСЏРµРј С‚РµРєСЃС‚ СЃРѕРѕР±С‰РµРЅРёСЏ
        reply_text = reply_to.text or ""
        reply_caption = reply_to.caption or ""
        
        logging.info(f"DEBUG: РўРµРєСЃС‚ СЃРѕРѕР±С‰РµРЅРёСЏ: {reply_text}")
        logging.info(f"DEBUG: РџРѕРґРїРёСЃСЊ СЃРѕРѕР±С‰РµРЅРёСЏ: {reply_caption}")
        
        # РџСЂРѕРІРµСЂСЏРµРј, СЃРѕРґРµСЂР¶РёС‚ Р»Рё СЃРѕРѕР±С‰РµРЅРёРµ С‚РµРєСЃС‚ Рѕ РїРѕРґРґРµСЂР¶РєРµ (РІ С‚РµРєСЃС‚Рµ РёР»Рё РїРѕРґРїРёСЃРё)
        is_support_message = (
            ("рџ’¬ РћС‚РІРµС‚ РѕС‚ РїРѕРґРґРµСЂР¶РєРё:" in reply_text) or 
            ("рџ“ё Р¤РѕС‚Рѕ РѕС‚ РїРѕРґРґРµСЂР¶РєРё:" in reply_text) or
            ("рџ’¬ РћС‚РІРµС‚ РѕС‚ РїРѕРґРґРµСЂР¶РєРё:" in reply_caption) or 
            ("рџ“ё Р¤РѕС‚Рѕ РѕС‚ РїРѕРґРґРµСЂР¶РєРё:" in reply_caption) or
            # РђР»СЊС‚РµСЂРЅР°С‚РёРІРЅС‹Рµ СЃРїРѕСЃРѕР±С‹ РѕРїСЂРµРґРµР»РµРЅРёСЏ СЃРѕРѕР±С‰РµРЅРёР№ РїРѕРґРґРµСЂР¶РєРё
            ("РїРѕРґРґРµСЂР¶РєРё:" in reply_text.lower()) or
            ("РїРѕРґРґРµСЂР¶РєРё:" in reply_caption.lower()) or
            ("рџ’¬" in reply_text) or
            ("рџ“ё" in reply_text) or
            ("рџ’¬" in reply_caption) or
            ("рџ“ё" in reply_caption) or
            # Р•СЃР»Рё СЌС‚Рѕ С„РѕС‚Рѕ РѕС‚ Р±РѕС‚Р° СЃ Р»СЋР±РѕР№ РїРѕРґРїРёСЃСЊСЋ - СЃС‡РёС‚Р°РµРј СЃРѕРѕР±С‰РµРЅРёРµРј РїРѕРґРґРµСЂР¶РєРё
            (reply_to.photo and reply_caption) or
            # Р•СЃР»Рё СЌС‚Рѕ С‚РµРєСЃС‚РѕРІРѕРµ СЃРѕРѕР±С‰РµРЅРёРµ РѕС‚ Р±РѕС‚Р° СЃ СЌРјРѕРґР·Рё - СЃС‡РёС‚Р°РµРј СЃРѕРѕР±С‰РµРЅРёРµРј РїРѕРґРґРµСЂР¶РєРё
            (reply_text and ("рџ’¬" in reply_text or "рџ“ё" in reply_text or "рџ› " in reply_text))
        )
        
        if is_support_message:
            logging.info("DEBUG: Р­С‚Рѕ РѕС‚РІРµС‚ РЅР° СЃРѕРѕР±С‰РµРЅРёРµ РїРѕРґРґРµСЂР¶РєРё!")
            logging.info(f"DEBUG: РџСЂРёС‡РёРЅР°: С‚РµРєСЃС‚='{reply_text}', РїРѕРґРїРёСЃСЊ='{reply_caption}'")
            
            # РќР• РѕР±СЂР°Р±Р°С‚С‹РІР°РµРј Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРё - РїСЂРѕСЃРёРј РЅР°Р¶Р°С‚СЊ РєРЅРѕРїРєСѓ
            await message.answer("""
рџ’¬ <b>Р§С‚РѕР±С‹ РѕС‚РІРµС‚РёС‚СЊ РїРѕРґРґРµСЂР¶РєРµ:</b>

рџ” <b>РќР°Р¶РјРёС‚Рµ РєРЅРѕРїРєСѓ "рџ’¬ РћС‚РІРµС‚РёС‚СЊ РїРѕРґРґРµСЂР¶РєРµ"</b> РїРѕРґ СЃРѕРѕР±С‰РµРЅРёРµРј РѕС‚ РїРѕРґРґРµСЂР¶РєРё

рџ“ќ <b>РџРѕСЃР»Рµ РЅР°Р¶Р°С‚РёСЏ РєРЅРѕРїРєРё</b> РІС‹ СЃРјРѕР¶РµС‚Рµ РЅР°РїРёСЃР°С‚СЊ РѕС‚РІРµС‚

<i>Р­С‚Рѕ РЅСѓР¶РЅРѕ РґР»СЏ РїСЂР°РІРёР»СЊРЅРѕР№ РѕР±СЂР°Р±РѕС‚РєРё РІР°С€РµРіРѕ СЃРѕРѕР±С‰РµРЅРёСЏ</i>
""", parse_mode="HTML")
            return
        else:
            logging.info("DEBUG: Р­С‚Рѕ РЅРµ СЃРѕРѕР±С‰РµРЅРёРµ РїРѕРґРґРµСЂР¶РєРё")
            logging.info(f"DEBUG: РџСЂРёС‡РёРЅР°: С‚РµРєСЃС‚='{reply_text}', РїРѕРґРїРёСЃСЊ='{reply_caption}'")
    else:
        logging.info("DEBUG: Р­С‚Рѕ РЅРµ РѕС‚РІРµС‚ РЅР° СЃРѕРѕР±С‰РµРЅРёРµ РѕС‚ Р±РѕС‚Р°")
    
    # РџСЂРѕРІРµСЂРєР° СЃРѕСЃС‚РѕСЏРЅРёСЏ РїРѕРґРґРµСЂР¶РєРё РѕС‚РєР»СЋС‡РµРЅР° - РїРѕРґРґРµСЂР¶РєР° С‚РµРїРµСЂСЊ С‡РµСЂРµР· РїСЂСЏРјСѓСЋ СЃСЃС‹Р»РєСѓ
    # current_state = await state.get_state()
    # if current_state == SupportState.waiting_for_message:
    #     logging.info("DEBUG: РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ СѓР¶Рµ РІ СЃРѕСЃС‚РѕСЏРЅРёРё РїРѕРґРґРµСЂР¶РєРё")
    #     # РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ СѓР¶Рµ РІ С‡Р°С‚Рµ РїРѕРґРґРµСЂР¶РєРё
    #     if message.photo:
    #         await handle_support_photo(message, state)
    #     else:
    #         await handle_support_message(message, state)

# РћР±СЂР°Р±РѕС‚С‡РёРє Р·Р°РіСЂСѓР·РєРё РєР»СЋС‡РµР№ (РґРѕР»Р¶РµРЅ Р±С‹С‚СЊ РџР•Р Р•Р” РѕР±СЂР°Р±РѕС‚С‡РёРєР°РјРё СЃ С„РёР»СЊС‚СЂР°РјРё С‚РµРєСЃС‚Р°)
@router.message(UploadKeysState.waiting_keys)
async def process_upload_keys_early(message: Message, state: FSMContext):
    """РћР±СЂР°Р±РѕС‚РєР° Р·Р°РіСЂСѓР¶РµРЅРЅС‹С… РєР»СЋС‡РµР№ - СЂР°РЅРЅСЏСЏ РІРµСЂСЃРёСЏ РґР»СЏ РїСЂРёРѕСЂРёС‚РµС‚Р°"""
    logging.info(f"DEBUG: РџРѕР»СѓС‡РµРЅРѕ СЃРѕРѕР±С‰РµРЅРёРµ РґР»СЏ Р·Р°РіСЂСѓР·РєРё РєР»СЋС‡РµР№ РѕС‚ {message.from_user.id}")
    user_id = message.from_user.id
    
    if not is_admin(user_id):
        await message.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°")
        await state.clear()
        return
    
    # РџСЂРѕРІРµСЂСЏРµРј РѕС‚РјРµРЅСѓ
    if message.text and message.text.strip() == "/cancel":
        await message.answer("вќЊ Р—Р°РіСЂСѓР·РєР° РѕС‚РјРµРЅРµРЅР°")
        await state.clear()
        return
    
    keys_text = message.text or ""
    
    if not keys_text.strip():
        await message.answer("вќЊ РЎРїРёСЃРѕРє РєР»СЋС‡РµР№ РЅРµ РјРѕР¶РµС‚ Р±С‹С‚СЊ РїСѓСЃС‚С‹Рј. РћС‚РїСЂР°РІСЊС‚Рµ РєР»СЋС‡Рё РёР»Рё /cancel РґР»СЏ РѕС‚РјРµРЅС‹.")
        return
    
    # РџРѕР»СѓС‡Р°РµРј СЃРѕС…СЂР°РЅРµРЅРЅС‹Рµ РґР°РЅРЅС‹Рµ
    data = await state.get_data()
    subscription_type = data.get('subscription_type')
    total_activations = data.get('total_activations', 1)
    
    if not subscription_type:
        await message.answer("вќЊ РћС€РёР±РєР°: С‚РёРї РїРѕРґРїРёСЃРєРё РЅРµ РІС‹Р±СЂР°РЅ. РќР°С‡РЅРёС‚Рµ Р·Р°РЅРѕРІРѕ.")
        await state.clear()
        return
    
    # РћС‚РїСЂР°РІР»СЏРµРј РєР»СЋС‡Рё РЅР° СЃРµСЂРІРµСЂ
    try:
        import aiohttp
        
        api_url = 'http://127.0.0.1:8123/bot_management/api/keys/upload/'
        
        async with aiohttp.ClientSession() as session:
            async with session.post(api_url, json={
                'keys': keys_text,
                'subscription_type': subscription_type,
                'total_activations': total_activations
            }) as response:
                if response.status == 200:
                    result = await response.json()
                    if result.get('success'):
                        created = result.get('created', 0)
                        skipped = result.get('skipped', 0)
                        errors = result.get('errors')
                        
                        result_text = f"""
вњ… <b>РљР»СЋС‡Рё Р·Р°РіСЂСѓР¶РµРЅС‹!</b>

рџ“Љ <b>Р РµР·СѓР»СЊС‚Р°С‚:</b>
вЂў вњ… РЎРѕР·РґР°РЅРѕ: <b>{created}</b>
вЂў вЏ­пёЏ РџСЂРѕРїСѓС‰РµРЅРѕ: <b>{skipped}</b>
"""
                        if errors:
                            result_text += f"\nвќЊ <b>РћС€РёР±РєРё:</b> {len(errors)}\n"
                            for error in errors[:5]:  # РџРѕРєР°Р·С‹РІР°РµРј РїРµСЂРІС‹Рµ 5 РѕС€РёР±РѕРє
                                result_text += f"вЂў {error}\n"
                            if len(errors) > 5:
                                result_text += f"<i>... Рё РµС‰Рµ {len(errors) - 5} РѕС€РёР±РѕРє</i>\n"
                        
                        await message.answer(result_text, parse_mode="HTML")
                    else:
                        await message.answer(f"вќЊ РћС€РёР±РєР°: {result.get('message', 'РќРµРёР·РІРµСЃС‚РЅР°СЏ РѕС€РёР±РєР°')}")
                else:
                    error_text = await response.text()
                    await message.answer(f"вќЊ РћС€РёР±РєР° СЃРµСЂРІРµСЂР°: {error_text}")
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° Р·Р°РіСЂСѓР·РєРё РєР»СЋС‡РµР№: {e}")
        await message.answer(f"вќЊ РћС€РёР±РєР°: {str(e)}")
    
    await state.clear()

# РћР±СЂР°Р±РѕС‚С‡РёРє РІРІРѕРґР° РїСЂРѕРёР·РІРѕР»СЊРЅРѕР№ СЃСѓРјРјС‹
@router.message(F.text.regexp(r'^\d+$'))
@protect_message('messages')
async def handle_custom_deposit_amount(message: Message, state: FSMContext):
    """РћР±СЂР°Р±РѕС‚РєР° РІРІРѕРґР° РїСЂРѕРёР·РІРѕР»СЊРЅРѕР№ СЃСѓРјРјС‹ - С‚РѕР»СЊРєРѕ РґР»СЏ РІС‹РІРѕРґР° СЂРµС„РµСЂР°Р»СЊРЅС‹С… СЃСЂРµРґСЃС‚РІ"""
    # РџСЂРѕРїСѓСЃРєР°РµРј, РµСЃР»Рё РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ РІ СЃРѕСЃС‚РѕСЏРЅРёРё СЂР°СЃСЃС‹Р»РєРё РёР»Рё Р·Р°РіСЂСѓР·РєРё РєР»СЋС‡РµР№
    current_state = await state.get_state()
    logging.info(f"DEBUG handle_custom_deposit_amount: СЃРѕСЃС‚РѕСЏРЅРёРµ = {current_state}, BroadcastState.waiting_message = {BroadcastState.waiting_message}")
    if current_state == BroadcastState.waiting_message or current_state == BroadcastState.waiting_confirmation:
        logging.info(f"DEBUG: РџСЂРѕРїСѓСЃРє РѕР±СЂР°Р±РѕС‚РєРё С‡РёСЃР»Р°, С‚Р°Рє РєР°Рє РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ РІ СЃРѕСЃС‚РѕСЏРЅРёРё СЂР°СЃСЃС‹Р»РєРё")
        return
    
    # РџСЂРѕРїСѓСЃРєР°РµРј, РµСЃР»Рё РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ РІ СЃРѕСЃС‚РѕСЏРЅРёРё Р·Р°РіСЂСѓР·РєРё РєР»СЋС‡РµР№
    if current_state == UploadKeysState.waiting_keys:
        logging.info(f"DEBUG: РџСЂРѕРїСѓСЃРє РѕР±СЂР°Р±РѕС‚РєРё, С‚Р°Рє РєР°Рє РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ РІ СЃРѕСЃС‚РѕСЏРЅРёРё Р·Р°РіСЂСѓР·РєРё РєР»СЋС‡РµР№")
        return
    
    try:
        # РџСЂРѕРІРµСЂСЏРµРј, РЅРµ РЅР°С…РѕРґРёРјСЃСЏ Р»Рё РјС‹ РІ РїСЂРѕС†РµСЃСЃРµ РІС‹РІРѕРґР° СЃСЂРµРґСЃС‚РІ
        current_state = await state.get_state()
        if current_state == WithdrawalState.waiting_amount:
            # Р•СЃР»Рё РјС‹ Р¶РґРµРј СЃСѓРјРјСѓ РґР»СЏ РІС‹РІРѕРґР°, РїРµСЂРµРґР°РµРј СѓРїСЂР°РІР»РµРЅРёРµ СЃРѕРѕС‚РІРµС‚СЃС‚РІСѓСЋС‰РµРјСѓ РѕР±СЂР°Р±РѕС‚С‡РёРєСѓ
            await handle_withdrawal_amount(message, state)
            return
        elif current_state == WithdrawalState.waiting_payment_details:
            # Р•СЃР»Рё РјС‹ Р¶РґРµРј СЂРµРєРІРёР·РёС‚С‹ РґР»СЏ РІС‹РІРѕРґР°, РїРµСЂРµРґР°РµРј СѓРїСЂР°РІР»РµРЅРёРµ СЃРѕРѕС‚РІРµС‚СЃС‚РІСѓСЋС‰РµРјСѓ РѕР±СЂР°Р±РѕС‚С‡РёРєСѓ
            await handle_withdrawal_details(message, state)
            return
        
        # РџРѕРїРѕР»РЅРµРЅРёРµ Р±Р°Р»Р°РЅСЃР° РѕС‚РєР»СЋС‡РµРЅРѕ - РёРіРЅРѕСЂРёСЂСѓРµРј РІРІРѕРґ СЃСѓРјРјС‹
        # await message.answer("рџ’Ў Р”Р»СЏ РїРѕРєСѓРїРєРё РїРѕРґРїРёСЃРєРё РІС‹Р±РµСЂРёС‚Рµ РµС‘ РІ РєР°С‚Р°Р»РѕРіРµ")
        
    except ValueError:
        await message.answer("вќЊ РџРѕР¶Р°Р»СѓР№СЃС‚Р°, РІРІРµРґРёС‚Рµ РєРѕСЂСЂРµРєС‚РЅСѓСЋ СЃСѓРјРјСѓ (С‚РѕР»СЊРєРѕ С†РёС„СЂС‹)")

# РЎС‚Р°СЂС‹Р№ РѕР±СЂР°Р±РѕС‚С‡РёРє FSM СѓРґР°Р»РµРЅ - С‚РµРїРµСЂСЊ РёСЃРїРѕР»СЊР·СѓРµРј РїСЂРѕСЃС‚С‹Рµ РєРЅРѕРїРєРё


# РћР±СЂР°Р±РѕС‚С‡РёРєРё СЂРµС„РµСЂР°Р»РѕРІ
@router.callback_query(F.data == "referral")
async def referral_menu(callback: CallbackQuery):
    """РњРµРЅСЋ СЂРµС„РµСЂР°Р»РѕРІ"""
    user_id = callback.from_user.id
    
    if DJANGO_INTEGRATION:
        try:
            import aiohttp
            
            # РџРѕР»СѓС‡Р°РµРј РёРЅС„РѕСЂРјР°С†РёСЋ Рѕ Р±РѕС‚Рµ
            bot_info = await bot.get_me()
            bot_username = bot_info.username
            
            # РџРѕР»СѓС‡Р°РµРј СЃС‚Р°С‚РёСЃС‚РёРєСѓ СЂРµС„РµСЂР°Р»РѕРІ
            api_url = f'http://127.0.0.1:8123/bot_management/api/referral/stats/{user_id}/'
            
            async with aiohttp.ClientSession() as session:
                async with session.get(api_url) as response:
                    if response.status == 200:
                        data = await response.json()
                        
                        if data.get('success'):
                            referrals_count = data.get('referrals_count', 0)
                            total_purchases = data.get('total_purchases', 0)
                            total_revenue = data.get('total_revenue', 0)
                            total_commission = data.get('total_commission', 0)
                            commission_percent = data.get('commission_percent', 20)
                            referral_code = data.get('referral_code')
                            referral_balance = data.get('referral_balance', 0)
                            
                            if referral_code:
                                text = f"""
рџ‘Ґ <b>Р РµС„РµСЂР°Р»СЊРЅР°СЏ РїСЂРѕРіСЂР°РјРјР°</b>

рџЋЇ <b>Р’Р°С€ СЂРµС„РµСЂР°Р»СЊРЅС‹Р№ РєРѕРґ:</b> {referral_code}

рџ“Љ <b>РЎС‚Р°С‚РёСЃС‚РёРєР°:</b>
вЂў РџСЂРёРіР»Р°С€РµРЅРѕ РґСЂСѓР·РµР№: {referrals_count}
вЂў Р’СЃРµРіРѕ РїРѕРєСѓРїРѕРє: {total_purchases}
вЂў РћР±С‰Р°СЏ РІС‹СЂСѓС‡РєР°: {total_revenue:.2f} в‚Ѕ
вЂў Р’Р°С€Р° РєРѕРјРёСЃСЃРёСЏ ({commission_percent}%): {total_commission:.2f} в‚Ѕ
вЂў Р РµС„РµСЂР°Р»СЊРЅС‹Р№ Р±Р°Р»Р°РЅСЃ: {referral_balance:.2f} в‚Ѕ

рџ’° <b>РљР°Рє Р·Р°СЂР°Р±РѕС‚Р°С‚СЊ:</b>
вЂў РџРѕРґРµР»РёС‚РµСЃСЊ СЃРІРѕРёРј РєРѕРґРѕРј СЃ РґСЂСѓР·СЊСЏРјРё
вЂў РџРѕР»СѓС‡Р°Р№С‚Рµ {commission_percent}% СЃ РєР°Р¶РґРѕР№ РёС… РїРѕРєСѓРїРєРё
вЂў Р”РµРЅСЊРіРё РЅР°С‡РёСЃР»СЏСЋС‚СЃСЏ Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРё

рџ”— <b>РџРѕРґРµР»РёС‚СЊСЃСЏ РєРѕРґРѕРј:</b>
https://t.me/{bot_username}?start={referral_code}

