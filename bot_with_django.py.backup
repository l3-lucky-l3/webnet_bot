async def refund_balance_payment(user_id: int, amount: float, reason: str = "Р’РѕР·РІСЂР°С‚ РїСЂРё РѕС€РёР±РєРµ РїРѕРєСѓРїРєРё"):
    """Р’РѕР·РІСЂР°С‚ СЃСЂРµРґСЃС‚РІ РЅР° Р±Р°Р»Р°РЅСЃ РїСЂРё РѕС€РёР±РєРµ РїРѕРєСѓРїРєРё"""
    if DJANGO_INTEGRATION:
        try:
            import aiohttp
            
            api_url = 'http://127.0.0.1:8123/bot_management/api/balance/refund/'
            
            async with aiohttp.ClientSession() as session:
                async with session.post(api_url, json={
                    'user_id': user_id,
                    'amount': amount,
                    'reason': reason
                }) as response:
