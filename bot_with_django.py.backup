# РЈС‚РёР»РёС‚С‹
def is_admin(user_id: int) -> bool:
    return user_id in ADMIN_IDS

async def schedule_pending_payment_reminder(payment_id: int, user_id: int, subscription_type: str, amount: int):
    """РћС‚Р»РѕР¶РµРЅРЅР°СЏ РѕС‚РїСЂР°РІРєР° РЅР°РїРѕРјРёРЅР°РЅРёСЏ Рѕ РЅРµР·Р°РІРµСЂС€РµРЅРЅРѕРј РїР»Р°С‚РµР¶Рµ С‡РµСЂРµР· 30 РјРёРЅСѓС‚"""
    try:
        # Р–РґРµРј 30 РјРёРЅСѓС‚ (1800 СЃРµРєСѓРЅРґ)
        await asyncio.sleep(1800)

        # РџСЂРѕРІРµСЂСЏРµРј СЃС‚Р°С‚СѓСЃ РїР»Р°С‚РµР¶Р° С‡РµСЂРµР· Django API
        if DJANGO_INTEGRATION:
            import aiohttp
            api_url = f'http://127.0.0.1:8123/bot_management/api/payments/{payment_id}/status/'

            async with aiohttp.ClientSession() as session:
                async with session.get(api_url) as response:
                    if response.status == 200:
                        data = await response.json()
                        if data.get('status') == 'pending':
                            # РџР»Р°С‚РµР¶ РІСЃРµ РµС‰Рµ РЅРµ РѕРїР»Р°С‡РµРЅ, РѕС‚РїСЂР°РІР»СЏРµРј РЅР°РїРѕРјРёРЅР°РЅРёРµ
                            await send_pending_payment_reminder(user_id, subscription_type, amount)
                    else:
                        logging.warning(f"РќРµ СѓРґР°Р»РѕСЃСЊ РїСЂРѕРІРµСЂРёС‚СЊ СЃС‚Р°С‚СѓСЃ РїР»Р°С‚РµР¶Р° {payment_id}")
        else:
            # РџСЂРѕРІРµСЂСЏРµРј С‡РµСЂРµР· SQLite
            with get_db() as conn:
                payment = conn.execute("SELECT status FROM payments WHERE payment_id = ?", (payment_id,)).fetchone()
                if payment and payment['status'] == 'pending':
                    # РџР»Р°С‚РµР¶ РІСЃРµ РµС‰Рµ РЅРµ РѕРїР»Р°С‡РµРЅ, РѕС‚РїСЂР°РІР»СЏРµРј РЅР°РїРѕРјРёРЅР°РЅРёРµ
                    await send_pending_payment_reminder(user_id, subscription_type, amount)

    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РІ РѕС‚Р»РѕР¶РµРЅРЅРѕРј РЅР°РїРѕРјРёРЅР°РЅРёРё РґР»СЏ РїР»Р°С‚РµР¶Р° {payment_id}: {e}")

async def schedule_subscription_expiry_reminders(payment_id: int, user_id: int, subscription_type: str, expires_at):
    """РћС‚Р»РѕР¶РµРЅРЅР°СЏ РѕС‚РїСЂР°РІРєР° РЅР°РїРѕРјРёРЅР°РЅРёР№ РѕР± РёСЃС‚РµС‡РµРЅРёРё РїРѕРґРїРёСЃРєРё"""
    try:
        from datetime import datetime, timezone
        import time

        # РџСЂРµРѕР±СЂР°Р·СѓРµРј expires_at РІ timestamp
        if isinstance(expires_at, str):
            # Р•СЃР»Рё expires_at - СЃС‚СЂРѕРєР°, РїР°СЂСЃРёРј РµС‘
            from dateutil import parser
            expires_at = parser.parse(expires_at)
        elif expires_at.tzinfo is None:
            # Р•СЃР»Рё naive datetime, СЃС‡РёС‚Р°РµРј С‡С‚Рѕ UTC
            expires_at = expires_at.replace(tzinfo=timezone.utc)

        now = datetime.now(timezone.utc)
        expires_timestamp = expires_at.timestamp()
        now_timestamp = now.timestamp()

        # Р•СЃР»Рё РїРѕРґРїРёСЃРєР° СѓР¶Рµ РёСЃС‚РµРєР»Р°, РЅРµ Р·Р°РїСѓСЃРєР°РµРј РЅР°РїРѕРјРёРЅР°РЅРёСЏ
        if expires_timestamp <= now_timestamp:
            return

        # Р’СЂРµРјСЏ РґРѕ РёСЃС‚РµС‡РµРЅРёСЏ РІ СЃРµРєСѓРЅРґР°С…
        time_until_expiry = expires_timestamp - now_timestamp

        # РќР°РїРѕРјРёРЅР°РЅРёРµ Р·Р° 2 РґРЅСЏ (172800 СЃРµРєСѓРЅРґ)
        reminder_2_days = time_until_expiry - 172800
        if reminder_2_days > 0:
            # Р—Р°РїСѓСЃРєР°РµРј РЅР°РїРѕРјРёРЅР°РЅРёРµ Р·Р° 2 РґРЅСЏ
            asyncio.create_task(send_subscription_reminder_later(user_id, subscription_type, reminder_2_days, '2_days_before'))

        # РќР°РїРѕРјРёРЅР°РЅРёРµ РїСЂРё РёСЃС‚РµС‡РµРЅРёРё
        asyncio.create_task(send_subscription_reminder_later(user_id, subscription_type, time_until_expiry, 'expired'))

    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РїР»Р°РЅРёСЂРѕРІР°РЅРёСЏ РЅР°РїРѕРјРёРЅР°РЅРёР№ РѕР± РёСЃС‚РµС‡РµРЅРёРё РїРѕРґРїРёСЃРєРё РґР»СЏ РїР»Р°С‚РµР¶Р° {payment_id}: {e}")

async def send_subscription_reminder_later(user_id: int, subscription_type: str, delay_seconds: float, reminder_type: str):
    """РћС‚РїСЂР°РІР»СЏРµС‚ РЅР°РїРѕРјРёРЅР°РЅРёРµ Рѕ РїРѕРґРїРёСЃРєРµ С‡РµСЂРµР· СѓРєР°Р·Р°РЅРЅРѕРµ РІСЂРµРјСЏ"""
    try:
        # Р–РґРµРј РЅСѓР¶РЅРѕРµ РІСЂРµРјСЏ
        await asyncio.sleep(delay_seconds)

        # РћРїСЂРµРґРµР»СЏРµРј С‚РµРєСЃС‚ РЅР°РїРѕРјРёРЅР°РЅРёСЏ
        sub_names = {
            'month': 'РњРµСЃСЏС‡РЅР°СЏ РїРѕРґРїРёСЃРєР°',
            '3months': 'РџРѕРґРїРёСЃРєР° РЅР° 3 РјРµСЃСЏС†Р°',
            '6months': 'РџРѕРґРїРёСЃРєР° РЅР° 6 РјРµСЃСЏС†РµРІ',
            'year': 'Р“РѕРґРѕРІР°СЏ РїРѕРґРїРёСЃРєР°'
        }
        sub_name = sub_names.get(subscription_type, 'РџРѕРґРїРёСЃРєР°')

        if reminder_type == '2_days_before':
            message = f"""
вЏ° <b>РќР°РїРѕРјРёРЅР°РЅРёРµ Рѕ РїРѕРґРїРёСЃРєРµ</b>

рџ“… <b>Р’Р°С€Р° {sub_name.lower()} Р·Р°РєР°РЅС‡РёРІР°РµС‚СЃСЏ С‡РµСЂРµР· 2 РґРЅСЏ!</b>

рџ’Ў <b>РќРµ Р·Р°Р±СѓРґСЊС‚Рµ РїСЂРѕРґР»РёС‚СЊ РїРѕРґРїРёСЃРєСѓ</b>, С‡С‚РѕР±С‹ РЅРµ РїРѕС‚РµСЂСЏС‚СЊ РґРѕСЃС‚СѓРї Рє СЃРµСЂРІРёСЃСѓ.

рџ”„ <b>РџСЂРѕРґР»РёС‚Рµ РїРѕРґРїРёСЃРєСѓ СЃРµР№С‡Р°СЃ</b> Рё РїСЂРѕРґРѕР»Р¶Р°Р№С‚Рµ РїРѕР»СЊР·РѕРІР°С‚СЊСЃСЏ Р±РµР· РїРµСЂРµСЂС‹РІРѕРІ!
"""
        elif reminder_type == 'expired':
            message = f"""
вќЊ <b>РџРѕРґРїРёСЃРєР° РёСЃС‚РµРєР»Р°</b>

рџ“… <b>Р’Р°С€Р° {sub_name.lower()} Р·Р°РєРѕРЅС‡РёР»Р°СЃСЊ.</b>

рџ”’ <b>Р”РѕСЃС‚СѓРї Рє СЃРµСЂРІРёСЃСѓ РІСЂРµРјРµРЅРЅРѕ РѕРіСЂР°РЅРёС‡РµРЅ.</b>

рџ”„ <b>РџСЂРѕРґР»РёС‚Рµ РїРѕРґРїРёСЃРєСѓ</b>, С‡С‚РѕР±С‹ РІРѕСЃСЃС‚Р°РЅРѕРІРёС‚СЊ РґРѕСЃС‚СѓРї Рё РїСЂРѕРґРѕР»Р¶РёС‚СЊ РїРѕР»СЊР·РѕРІР°С‚СЊСЃСЏ СЃРµСЂРІРёСЃРѕРј Р±РµР· РѕРіСЂР°РЅРёС‡РµРЅРёР№!
"""
        else:
            return

        # РЎРѕР·РґР°РµРј РєР»Р°РІРёР°С‚СѓСЂСѓ СЃ РєРЅРѕРїРєР°РјРё
        keyboard = {
            "inline_keyboard": [
                [{"text": "рџ”„ РџСЂРѕРґР»РёС‚СЊ РїРѕРґРїРёСЃРєСѓ", "callback_data": f"renew_subscription:{subscription_type}"}],
                [{"text": "рџЏ  Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", "callback_data": "main_menu"}]
            ]
        }

        # РћС‚РїСЂР°РІР»СЏРµРј СЃРѕРѕР±С‰РµРЅРёРµ С‡РµСЂРµР· Telegram Bot API
        from config import BOT_TOKEN
        import requests
        import json

        url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"
        data = {
            'chat_id': user_id,
            'text': message,
            'parse_mode': 'HTML',
            'reply_markup': json.dumps(keyboard)
        }

        response = requests.post(url, data=data, timeout=10)

        if response.status_code == 200:
            result = response.json()
            if result.get('ok'):
                logging.info(f'РћС‚РїСЂР°РІР»РµРЅРѕ РЅР°РїРѕРјРёРЅР°РЅРёРµ Рѕ РїРѕРґРїРёСЃРєРµ ({reminder_type}) РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ {user_id}')
            else:
                logging.error(f'РћС€РёР±РєР° Telegram API РїСЂРё РѕС‚РїСЂР°РІРєРµ РЅР°РїРѕРјРёРЅР°РЅРёСЏ: {result.get("description")}')
        else:
            logging.error(f'HTTP РѕС€РёР±РєР° РїСЂРё РѕС‚РїСЂР°РІРєРµ РЅР°РїРѕРјРёРЅР°РЅРёСЏ: {response.status_code} - {response.text}')

    except Exception as e:
        logging.error(f'РћС€РёР±РєР° РѕС‚РїСЂР°РІРєРё РЅР°РїРѕРјРёРЅР°РЅРёСЏ Рѕ РїРѕРґРїРёСЃРєРµ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ {user_id}: {e}')

async def send_pending_payment_reminder(user_id: int, subscription_type: str, amount: int):
    """РћС‚РїСЂР°РІР»СЏРµС‚ РЅР°РїРѕРјРёРЅР°РЅРёРµ Рѕ РЅРµР·Р°РІРµСЂС€РµРЅРЅРѕРј РїР»Р°С‚РµР¶Рµ"""
    try:
        from config import BOT_TOKEN

        import requests
        import json

        # РћРїСЂРµРґРµР»СЏРµРј С‚РµРєСЃС‚ РЅР°РїРѕРјРёРЅР°РЅРёСЏ
        sub_names = {
            'month': 'РњРµСЃСЏС‡РЅР°СЏ РїРѕРґРїРёСЃРєР°',
            '3months': 'РџРѕРґРїРёСЃРєР° РЅР° 3 РјРµСЃСЏС†Р°',
            '6months': 'РџРѕРґРїРёСЃРєР° РЅР° 6 РјРµСЃСЏС†РµРІ',
            'year': 'Р“РѕРґРѕРІР°СЏ РїРѕРґРїРёСЃРєР°'
        }
        sub_name = sub_names.get(subscription_type, 'РџРѕРґРїРёСЃРєР°')

        message = f"""
вЏ° <b>РќР°РїРѕРјРёРЅР°РЅРёРµ Рѕ РЅРµР·Р°РІРµСЂС€РµРЅРЅРѕРј РїР»Р°С‚РµР¶Рµ</b>

рџ’і <b>РЎСѓРјРјР°:</b> {amount} в‚Ѕ
рџ“… <b>РџРѕРґРїРёСЃРєР°:</b> {sub_name}
вЏ±пёЏ <b>РЎРѕР·РґР°РЅ:</b> 30 РјРёРЅСѓС‚ РЅР°Р·Р°Рґ

вќЊ <b>Р’Р°С€ РїР»Р°С‚РµР¶ РІСЃРµ РµС‰Рµ РѕР¶РёРґР°РµС‚ РѕРїР»Р°С‚С‹!</b>

рџ’Ў <b>Р§С‚Рѕ РґРµР»Р°С‚СЊ:</b>
вЂў Р—Р°РІРµСЂС€РёС‚Рµ РѕРїР»Р°С‚Сѓ РїРѕ РёРЅСЃС‚СЂСѓРєС†РёРё РІС‹С€Рµ
вЂў РР»Рё СЃРѕР·РґР°Р№С‚Рµ РЅРѕРІС‹Р№ РїР»Р°С‚РµР¶, РµСЃР»Рё РІРѕР·РЅРёРєР»Рё РїСЂРѕР±Р»РµРјС‹

рџ”„ <b>РҐРѕС‚РёС‚Рµ СЃРѕР·РґР°С‚СЊ РЅРѕРІС‹Р№ РїР»Р°С‚РµР¶?</b>
"""

        # РЎРѕР·РґР°РµРј РєР»Р°РІРёР°С‚СѓСЂСѓ СЃ РєРЅРѕРїРєР°РјРё
        keyboard = {
            "inline_keyboard": [
                [{"text": "рџ”„ РЎРѕР·РґР°С‚СЊ РЅРѕРІС‹Р№ РїР»Р°С‚РµР¶", "callback_data": f"retry_payment:{subscription_type}"}],
                [{"text": "рџЏ  Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", "callback_data": "main_menu"}]
            ]
        }

        # РћС‚РїСЂР°РІР»СЏРµРј СЃРѕРѕР±С‰РµРЅРёРµ С‡РµСЂРµР· Telegram Bot API
        url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"
        data = {
            'chat_id': user_id,
            'text': message,
            'parse_mode': 'HTML',
            'reply_markup': json.dumps(keyboard)
        }

        response = requests.post(url, data=data, timeout=10)

        if response.status_code == 200:
            result = response.json()
            if result.get('ok'):
                logging.info(f'РћС‚РїСЂР°РІР»РµРЅРѕ РЅР°РїРѕРјРёРЅР°РЅРёРµ Рѕ РЅРµР·Р°РІРµСЂС€РµРЅРЅРѕРј РїР»Р°С‚РµР¶Рµ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ {user_id}')
            else:
                logging.error(f'РћС€РёР±РєР° Telegram API РїСЂРё РѕС‚РїСЂР°РІРєРµ РЅР°РїРѕРјРёРЅР°РЅРёСЏ: {result.get("description")}')
        else:
            logging.error(f'HTTP РѕС€РёР±РєР° РїСЂРё РѕС‚РїСЂР°РІРєРµ РЅР°РїРѕРјРёРЅР°РЅРёСЏ: {response.status_code} - {response.text}')

    except Exception as e:
        logging.error(f'РћС€РёР±РєР° РѕС‚РїСЂР°РІРєРё РЅР°РїРѕРјРёРЅР°РЅРёСЏ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ {user_id}: {e}')

def get_next_card():
    with get_db() as conn:
        cursor = conn.cursor()
        # РЎРЅР°С‡Р°Р»Р° РёС‰РµРј РєР°СЂС‚С‹ СЃ РЅР°РёРјРµРЅСЊС€РµР№ Р·Р°РіСЂСѓР·РєРѕР№
        cursor.execute("""
            SELECT * FROM cards 
            WHERE is_active = 1 AND current_received < max_limit
            ORDER BY 
                (current_received * 1.0 / max_limit) ASC,  -- РїРѕ РїСЂРѕС†РµРЅС‚Сѓ Р·Р°РіСЂСѓР·РєРё
                card_id ASC  -- РµСЃР»Рё РїСЂРѕС†РµРЅС‚С‹ СЂР°РІРЅС‹, С‚Рѕ РїРѕ ID
            LIMIT 1
        """)
        return cursor.fetchone()

def get_available_key(sub_type: str):
    with get_db() as conn:
        cursor = conn.cursor()
        cursor.execute("""
            SELECT * FROM keys 
            WHERE subscription_type = ? AND used_activations < total_activations AND is_active = 1
            ORDER BY key_id
            LIMIT 1
        """, (sub_type,))
        key = cursor.fetchone()
        if key:
            cursor.execute("""
                UPDATE keys 
                SET used_activations = used_activations + 1,
                    is_active = CASE WHEN used_activations + 1 >= total_activations THEN 0 ELSE 1 END
                WHERE key_id = ?
            """, (key["key_id"],))
            return key
        return None

def get_or_create_support_chat(user_id: int):
    with get_db() as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT * FROM support_chats WHERE user_id = ? AND status = 'open'", (user_id,))
        chat = cursor.fetchone()
        if not chat:
            cursor.execute("INSERT INTO support_chats (user_id, status, created_at, unread_admin_messages, unread_user_messages) VALUES (?, ?, CURRENT_TIMESTAMP, 0, 0)", (user_id, 'open'))
            chat_id = cursor.lastrowid
            return chat_id
        return chat["chat_id"]

async def send_support_response_to_user(user_id: int, message_text: str, photo_file_id: str = None):
    """РћС‚РїСЂР°РІР»СЏРµС‚ РѕС‚РІРµС‚ РѕС‚ РїРѕРґРґРµСЂР¶РєРё РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ"""
    try:
        logging.info(f"DEBUG: РћС‚РїСЂР°РІР»СЏРµРј РѕС‚РІРµС‚ РїРѕРґРґРµСЂР¶РєРё РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ {user_id}")
        logging.info(f"DEBUG: РўРµРєСЃС‚: {message_text}")
        logging.info(f"DEBUG: Р¤РѕС‚Рѕ: {photo_file_id}")
        
        # РЎРѕР·РґР°РµРј РєР»Р°РІРёР°С‚СѓСЂСѓ СЃ РєРЅРѕРїРєРѕР№ "РћС‚РІРµС‚РёС‚СЊ"
        reply_keyboard = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="рџ’¬ РћС‚РІРµС‚РёС‚СЊ РїРѕРґРґРµСЂР¶РєРµ", callback_data="reply_to_support")]
        ])
        
        if photo_file_id:
            # РћС‚РїСЂР°РІР»СЏРµРј С‚РѕР»СЊРєРѕ С„РѕС‚Рѕ Р±РµР· С‚РµРєСЃС‚Р°
            logging.info(f"DEBUG: РћС‚РїСЂР°РІР»СЏРµРј С„РѕС‚Рѕ Р±РµР· РїРѕРґРїРёСЃРё")
            await bot.send_photo(
                chat_id=user_id,
                photo=photo_file_id,
                reply_markup=reply_keyboard
            )
        else:
            # РћС‚РїСЂР°РІР»СЏРµРј С‚РµРєСЃС‚РѕРІРѕРµ СЃРѕРѕР±С‰РµРЅРёРµ СЃ РёР·РѕР±СЂР°Р¶РµРЅРёРµРј РїРѕРґРґРµСЂР¶РєРё
            text = f"рџ’¬ <b>РћС‚РІРµС‚ РѕС‚ РїРѕРґРґРµСЂР¶РєРё:</b>\n\n{message_text}"
            logging.info(f"DEBUG: РћС‚РїСЂР°РІР»СЏРµРј С‚РµРєСЃС‚: {text}")
            
            # РСЃРїРѕР»СЊР·СѓРµРј send_or_edit_message_with_photo РґР»СЏ РїРѕРєР°Р·Р° РёР·РѕР±СЂР°Р¶РµРЅРёСЏ РїРѕРґРґРµСЂР¶РєРё
            from aiogram.types import CallbackQuery
            fake_callback = type('FakeCallback', (), {
                'message': type('FakeMessage', (), {
                    'chat': type('FakeChat', (), {'id': user_id})(),
                    'message_id': None
                })()
            })()
            
            await send_or_edit_message_with_photo(
                fake_callback, 
                text, 
                reply_markup=reply_keyboard, 
                edit_message=False,
                image_name="support.png"
            )
        
        # РЎРѕС…СЂР°РЅСЏРµРј РѕС‚РІРµС‚ РІ Р±Р°Р·Сѓ (Р‘Р•Р—РћРџРђРЎРќРћ)
        chat_id = get_or_create_support_chat_safe(user_id)
        if chat_id:
            await save_support_message_safe(chat_id, 'admin', message_text, photo_file_id)
        
        logging.info(f"DEBUG: РћС‚РІРµС‚ РїРѕРґРґРµСЂР¶РєРё СѓСЃРїРµС€РЅРѕ РѕС‚РїСЂР°РІР»РµРЅ РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ {user_id}")
        return True
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РѕС‚РїСЂР°РІРєРё РѕС‚РІРµС‚Р° РїРѕРґРґРµСЂР¶РєРё РїРѕР»СЊР·РѕРІР°С‚РµР»СЋ {user_id}: {e}")
        return False

async def get_user_profile(user_id: int):
    """РџРѕР»СѓС‡Р°РµС‚ РїСЂРѕС„РёР»СЊ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ"""
    if DJANGO_INTEGRATION:
        try:
            import aiohttp
            
            api_url = f'http://127.0.0.1:8123/bot_management/api/users/{user_id}/profile/'
            
            # РСЃРїРѕР»СЊР·СѓРµРј РіР»РѕР±Р°Р»СЊРЅСѓСЋ СЃРµСЃСЃРёСЋ РґР»СЏ РѕРїС‚РёРјРёР·Р°С†РёРё
            session = get_http_session()
            async with session.get(api_url) as response:
                    if response.status == 200:
                        data = await response.json()
                        logging.info(f"DEBUG: РџСЂРѕС„РёР»СЊ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ {user_id} СѓСЃРїРµС€РЅРѕ РїРѕР»СѓС‡РµРЅ")
                        return data
                    else:
                        error_text = await response.text()
                        logging.error(f"РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ РїСЂРѕС„РёР»СЏ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ {user_id}: HTTP {response.status} - {error_text}")
                        return None
        except aiohttp.ClientError as e:
            logging.error(f"РћС€РёР±РєР° СЃРµС‚Рё РїСЂРё РїРѕР»СѓС‡РµРЅРёРё РїСЂРѕС„РёР»СЏ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ {user_id}: {e}")
            return None
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ РїСЂРѕС„РёР»СЏ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ {user_id}: {e}")
            import traceback
            logging.error(traceback.format_exc())
            return None
    return None

