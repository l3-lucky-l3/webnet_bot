@router.message(Command("admin"))
@protect_message('messages')
async def cmd_admin(message: Message):
    """РљРѕРјР°РЅРґР° /admin - РїР°РЅРµР»СЊ Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂР°"""
    user_id = message.from_user.id
    
    # РџСЂРѕРІРµСЂСЏРµРј РїСЂР°РІР° Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂР°
    if not is_admin(user_id):
        await message.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР° Рє Р°РґРјРёРЅ-РїР°РЅРµР»Рё")
        return
    
    if DJANGO_INTEGRATION:
        try:
            import aiohttp
            
            # РџРѕР»СѓС‡Р°РµРј СЃС‚Р°С‚РёСЃС‚РёРєСѓ
            api_url = 'http://127.0.0.1:8123/bot_management/api/statistics/'
            
            async with aiohttp.ClientSession() as session:
                async with session.get(api_url) as response:
                    if response.status == 200:
                        data = await response.json()
                        
                        users = data.get('users', {})
                        payments = data.get('payments', {})
                        keys = data.get('keys', {})
                        
                        admin_text = f"""
рџ”§ <b>РџР°РЅРµР»СЊ Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂР°</b>

рџ“Љ <b>РЎС‚Р°С‚РёСЃС‚РёРєР°:</b>

рџ‘Ґ <b>РџРѕР»СЊР·РѕРІР°С‚РµР»Рё:</b>
вЂў Р’СЃРµРіРѕ: {users.get('total', 0)}
вЂў РЎРµРіРѕРґРЅСЏ: {users.get('new_today', 0)}
вЂў Р—Р° РЅРµРґРµР»СЋ: {users.get('new_week', 0)}

рџ’і <b>РџР»Р°С‚РµР¶Рё:</b>
вЂў Р’СЃРµРіРѕ: {payments.get('total', 0)}
вЂў РћР¶РёРґР°СЋС‚: {payments.get('pending', 0)}
вЂў РЈСЃРїРµС€РЅС‹С…: {payments.get('succeeded', 0)}
вЂў Р’С‹СЂСѓС‡РєР°: {payments.get('revenue', 0):.2f} в‚Ѕ
вЂў <b>Р—Р° СЃРµРіРѕРґРЅСЏ:</b> {payments.get('revenue_today', 0):.2f} в‚Ѕ

рџ”‘ <b>РљР»СЋС‡Рё:</b>
вЂў Р’СЃРµРіРѕ: {keys.get('total', 0)}
вЂў Р”РѕСЃС‚СѓРїРЅРѕ: {keys.get('available', 0)}

<i>Р’С‹Р±РµСЂРёС‚Рµ СЂР°Р·РґРµР» РґР»СЏ СѓРїСЂР°РІР»РµРЅРёСЏ в¬‡пёЏ</i>
"""
                    else:
                        admin_text = """
рџ”§ <b>РџР°РЅРµР»СЊ Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂР°</b>

вќЊ <b>РћС€РёР±РєР° Р·Р°РіСЂСѓР·РєРё СЃС‚Р°С‚РёСЃС‚РёРєРё</b>

<i>РџРѕРїСЂРѕР±СѓР№С‚Рµ РїРѕР·Р¶Рµ</i>
"""
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ СЃС‚Р°С‚РёСЃС‚РёРєРё РґР»СЏ Р°РґРјРёРЅРєРё: {e}")
            admin_text = """
рџ”§ <b>РџР°РЅРµР»СЊ Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂР°</b>

вќЊ <b>РћС€РёР±РєР° Р·Р°РіСЂСѓР·РєРё РґР°РЅРЅС‹С…</b>

<i>РџРѕРїСЂРѕР±СѓР№С‚Рµ РїРѕР·Р¶Рµ</i>
"""
    else:
        admin_text = """
рџ”§ <b>РџР°РЅРµР»СЊ Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂР°</b>

вќЊ <b>РЎРёСЃС‚РµРјР° РЅРµРґРѕСЃС‚СѓРїРЅР°</b>

<i>Django РёРЅС‚РµРіСЂР°С†РёСЏ РЅРµ РЅР°СЃС‚СЂРѕРµРЅР°</i>
"""
    
    kb = InlineKeyboardMarkup(inline_keyboard=[
