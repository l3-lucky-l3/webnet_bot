    if not is_admin(user_id):
        await callback.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°", show_alert=True)
        return
    
    await callback.message.answer(
        "рџ”Ќ <b>РџРѕРёСЃРє РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ</b>\n\nР’РІРµРґРёС‚Рµ ID РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ РґР»СЏ РїРѕРёСЃРєР°:",
        parse_mode="HTML"
    )
    
    await state.set_state("admin_waiting_user_id")
    await callback.answer()

@router.callback_query(F.data == "admin_settings")
async def admin_settings_handler(callback: CallbackQuery):
    """РћР±СЂР°Р±РѕС‚С‡РёРє РЅР°СЃС‚СЂРѕРµРє"""
    user_id = callback.from_user.id
    
    if not is_admin(user_id):
        await callback.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°", show_alert=True)
        return
    
    if not DJANGO_INTEGRATION:
        await callback.answer("вќЊ РЎРёСЃС‚РµРјР° РЅРµРґРѕСЃС‚СѓРїРЅР°", show_alert=True)
        return
    
    # РџРѕР»СѓС‡Р°РµРј С‚РµРєСѓС‰РёРµ С†РµРЅС‹
    try:
        import aiohttp
        
        api_url = 'http://127.0.0.1:8123/bot_management/api/prices/get/'
        
        async with aiohttp.ClientSession() as session:
            async with session.get(api_url) as response:
                if response.status == 200:
                    data = await response.json()
                    prices = data.get('prices', {})
                    
                    settings_text = f"""
вљ™пёЏ <b>РќР°СЃС‚СЂРѕР№РєРё</b>

рџ’° <b>РўРµРєСѓС‰РёРµ С†РµРЅС‹:</b>
вЂў РњРµСЃСЏС‡РЅР°СЏ: <b>{prices.get('month', 0)} в‚Ѕ</b>
вЂў 3 РјРµСЃСЏС†Р°: <b>{prices.get('3months', 0)} в‚Ѕ</b>
вЂў 6 РјРµСЃСЏС†РµРІ: <b>{prices.get('6months', 0)} в‚Ѕ</b>
вЂў Р“РѕРґРѕРІР°СЏ: <b>{prices.get('year', 0)} в‚Ѕ</b>

<i>Р’С‹Р±РµСЂРёС‚Рµ РґРµР№СЃС‚РІРёРµ в¬‡пёЏ</i>
"""
                else:
                    settings_text = "вќЊ <b>РћС€РёР±РєР° Р·Р°РіСЂСѓР·РєРё РґР°РЅРЅС‹С…</b>"
    except Exception as e:
        logging.error(f"РћС€РёР±РєР° РїРѕР»СѓС‡РµРЅРёСЏ С†РµРЅ: {e}")
        settings_text = "вќЊ <b>РћС€РёР±РєР° Р·Р°РіСЂСѓР·РєРё РґР°РЅРЅС‹С…</b>"
    
    # РџСЂРѕРІРµСЂСЏРµРј СЃС‚Р°С‚СѓСЃ С„СѓРЅРєС†РёРё "РќР°РїРёСЃР°С‚СЊ РјРµРЅРµРґР¶РµСЂСѓ"
    manager_key_delivery_enabled = True
    try:
        import aiohttp
        api_url = 'http://127.0.0.1:8123/bot_management/api/settings/get/?key=manager_key_delivery_enabled'
        async with aiohttp.ClientSession() as session:
            async with session.get(api_url) as response:
                if response.status == 200:
                    data = await response.json()
                    if data.get('success'):
                        value = data.get('value')
                        if value is not None:
                            manager_key_delivery_enabled = str(value).lower() == 'true'
    except:
        pass
    
    kb_buttons = [
        [InlineKeyboardButton(text="рџ’° РР·РјРµРЅРёС‚СЊ С†РµРЅС‹", callback_data="admin_edit_prices")],
        [InlineKeyboardButton(text="рџ“ќ РР·РјРµРЅРёС‚СЊ РЅР°Р·РІР°РЅРёСЏ", callback_data="admin_edit_names")],
        [InlineKeyboardButton(text="рџ“ћ РџРѕР»СѓС‡РёС‚СЊ РєР»СЋС‡ Сѓ РјРµРЅРµРґР¶РµСЂР°", callback_data="admin_toggle_manager_key_delivery")],
        [InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ РІ Р°РґРјРёРЅРєСѓ", callback_data="admin_panel")]
    ]
    
    # РћР±РЅРѕРІР»СЏРµРј С‚РµРєСЃС‚ РєРЅРѕРїРєРё РІ Р·Р°РІРёСЃРёРјРѕСЃС‚Рё РѕС‚ СЃС‚Р°С‚СѓСЃР°
    manager_status_text = "вњ… Р’РєР»СЋС‡РµРЅРѕ" if manager_key_delivery_enabled else "вќЊ Р’С‹РєР»СЋС‡РµРЅРѕ"
    kb_buttons[2][0] = InlineKeyboardButton(
        text=f"рџ“ћ РџРѕР»СѓС‡РёС‚СЊ РєР»СЋС‡ Сѓ РјРµРЅРµРґР¶РµСЂР° ({manager_status_text})",
        callback_data="admin_toggle_manager_key_delivery"
    )
    
    kb = InlineKeyboardMarkup(inline_keyboard=kb_buttons)
    
    try:
        await callback.message.edit_text(settings_text, parse_mode="HTML", reply_markup=kb)
    except:
        await callback.message.answer(settings_text, parse_mode="HTML", reply_markup=kb)
    
    await callback.answer()

@router.callback_query(F.data == "admin_scheduler")
async def admin_scheduler_handler(callback: CallbackQuery):
    """РћР±СЂР°Р±РѕС‚С‡РёРє СЃС‚Р°С‚СѓСЃР° РїР»Р°РЅРёСЂРѕРІС‰РёРєР° СѓРІРµРґРѕРјР»РµРЅРёР№"""
    user_id = callback.from_user.id

    if not is_admin(user_id):
        await callback.answer("вќЊ РЈ РІР°СЃ РЅРµС‚ РґРѕСЃС‚СѓРїР°", show_alert=True)
        return

    # РџРѕР»СѓС‡Р°РµРј СЃС‚Р°С‚СѓСЃ РїР»Р°РЅРёСЂРѕРІС‰РёРєР°
    status = get_scheduler_status()

    scheduler_text = f"""
рџ”” <b>РЎС‚Р°С‚СѓСЃ РїР»Р°РЅРёСЂРѕРІС‰РёРєР° СѓРІРµРґРѕРјР»РµРЅРёР№</b>

рџ“Љ <b>РћР±С‰РёР№ СЃС‚Р°С‚СѓСЃ:</b> {'рџџў Р—Р°РїСѓС‰РµРЅ' if status.get('status') == 'running' else 'рџ”ґ РћСЃС‚Р°РЅРѕРІР»РµРЅ'}

рџЋЇ <b>РђРєС‚РёРІРЅС‹С… Р·Р°РґР°С‡:</b> {status.get('jobs_count', 0)}

рџ“‹ <b>Р—Р°РїР»Р°РЅРёСЂРѕРІР°РЅРЅС‹Рµ Р·Р°РґР°С‡Рё:</b>
"""

    if status.get('jobs'):
        for job in status['jobs']:
            next_run = job.get('next_run', 'РќРµ Р·Р°РїР»Р°РЅРёСЂРѕРІР°РЅРѕ')
            if next_run != 'РќРµ Р·Р°РїР»Р°РЅРёСЂРѕРІР°РЅРѕ':
                # РџСЂРµРѕР±СЂР°Р·СѓРµРј РІСЂРµРјСЏ РІ С‡РёС‚Р°РµРјС‹Р№ С„РѕСЂРјР°С‚
                from datetime import datetime
                try:
                    dt = datetime.fromisoformat(next_run.replace('Z', '+00:00'))
                    next_run = dt.strftime('%d.%m.%Y %H:%M')
                except:
                    pass

            scheduler_text += f"\nрџ”ё <b>{job['name']}</b>\n   рџ•ђ РЎР»РµРґСѓСЋС‰РёР№ Р·Р°РїСѓСЃРє: {next_run}\n   вЏ° {job['trigger']}\n"
    else:
        scheduler_text += "\nвќЊ Р—Р°РґР°С‡Рё РЅРµ РЅР°Р№РґРµРЅС‹"

    scheduler_text += """

рџ’Ў <b>Р§С‚Рѕ РґРµР»Р°РµС‚ РїР»Р°РЅРёСЂРѕРІС‰РёРє:</b>
вЂў рџ’і РћС‚РїСЂР°РІР»СЏРµС‚ РЅР°РїРѕРјРёРЅР°РЅРёСЏ Рѕ РїР»Р°С‚РµР¶Р°С… (РєР°Р¶РґС‹Рµ 30 РјРёРЅ)
вЂў рџ”‘ РџСЂРѕРІРµСЂСЏРµС‚ РѕСЃС‚Р°С‚РѕРє РєР»СЋС‡РµР№ (РєР°Р¶РґС‹Р№ С‡Р°СЃ)
вЂў рџ“… РќР°РїРѕРјРёРЅР°РµС‚ Рѕ Р·Р°РєР°РЅС‡РёРІР°СЋС‰РёС…СЃСЏ РїРѕРґРїРёСЃРєР°С… (10:00 РµР¶РµРґРЅРµРІРЅРѕ)
"""

    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="в¬…пёЏ РќР°Р·Р°Рґ РІ Р°РґРјРёРЅРєСѓ", callback_data="admin_panel")]
    ])

    try:
        await callback.message.edit_text(scheduler_text, parse_mode="HTML", reply_markup=kb)
    except:
        await callback.message.answer(scheduler_text, parse_mode="HTML", reply_markup=kb)

    await callback.answer()

