            return False
    return False

async def create_deposit_payment(callback: CallbackQuery, amount: float):
    """РЎРѕР·РґР°РЅРёРµ РїР»Р°С‚РµР¶Р° РґР»СЏ РїРѕРїРѕР»РЅРµРЅРёСЏ Р±Р°Р»Р°РЅСЃР° РёР· callback (РЅРѕРІР°СЏ СѓРїСЂРѕС‰РµРЅРЅР°СЏ СЃРёСЃС‚РµРјР°)"""
    user_id = callback.from_user.id
    
    if DJANGO_INTEGRATION:
        try:
            from bot_management.simple_bot_handlers import create_simple_balance_payment
            
            # РЎРѕР·РґР°РµРј РїСЂРѕСЃС‚РѕР№ РїР»Р°С‚РµР¶ РґР»СЏ РїРѕРїРѕР»РЅРµРЅРёСЏ Р±Р°Р»Р°РЅСЃР°
            payment_data = await create_simple_balance_payment(user_id, amount)
            
            if payment_data.get('success'):
                payment_id = payment_data.get('payment_id')
                confirmation_url = payment_data.get('confirmation_url')
                
                success_text = f"""
вњ… <b>РџР»Р°С‚РµР¶ СЃРѕР·РґР°РЅ!</b>

рџ’° <b>РЎСѓРјРјР°:</b> {amount} в‚Ѕ
рџ†” <b>ID РїР»Р°С‚РµР¶Р°:</b> {payment_id}

рџ”— <b>РќР°Р¶РјРёС‚Рµ РєРЅРѕРїРєСѓ "РћРїР»Р°С‚РёС‚СЊ" РґР»СЏ РїРµСЂРµС…РѕРґР° Рє РѕРїР»Р°С‚Рµ</b>

<i>РџРѕСЃР»Рµ РѕРїР»Р°С‚С‹ РїР»Р°С‚РµР¶ Р±СѓРґРµС‚ РѕР±СЂР°Р±РѕС‚Р°РЅ Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРё</i>
"""
                
                kb = InlineKeyboardMarkup(inline_keyboard=[
                    [InlineKeyboardButton(text="рџ’і РћРїР»Р°С‚РёС‚СЊ", url=confirmation_url)],
                    [InlineKeyboardButton(text="рџ”„ РџСЂРѕРІРµСЂРёС‚СЊ СЃС‚Р°С‚СѓСЃ", callback_data=f"check_simple_payment_{payment_id}")],
                    [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
                ])
                
                await send_or_edit_message_with_photo(callback, success_text, reply_markup=kb, edit_message=True, image_name="balance.png")
                
                logging.info(f"РџСЂРѕСЃС‚РѕР№ РїР»Р°С‚РµР¶ {payment_id} СЃРѕР·РґР°РЅ РґР»СЏ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ {user_id}")
            else:
                error_text = f"""
вќЊ <b>РћС€РёР±РєР° СЃРѕР·РґР°РЅРёСЏ РїР»Р°С‚РµР¶Р°</b>

рџ”§ <b>Р§С‚Рѕ РїСЂРѕРёСЃС…РѕРґРёС‚:</b>
вЂў {payment_data.get('message', 'Р’СЂРµРјРµРЅРЅР°СЏ РЅРµРґРѕСЃС‚СѓРїРЅРѕСЃС‚СЊ РїР»Р°С‚РµР¶РЅРѕР№ СЃРёСЃС‚РµРјС‹')}

вЏ° <b>РџРѕРїСЂРѕР±СѓР№С‚Рµ С‡РµСЂРµР· РЅРµСЃРєРѕР»СЊРєРѕ РјРёРЅСѓС‚</b>
"""
                
                kb = InlineKeyboardMarkup(inline_keyboard=[
                    [InlineKeyboardButton(text="рџ”„ РџРѕРїСЂРѕР±РѕРІР°С‚СЊ СЃРЅРѕРІР°", callback_data="deposit_balance")],
                    [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
                ])
                
                await send_or_edit_message_with_photo(callback, error_text, reply_markup=kb, edit_message=True, image_name="balance.png")
                
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° СЃРѕР·РґР°РЅРёСЏ РїСЂРѕСЃС‚РѕРіРѕ РїР»Р°С‚РµР¶Р° РїРѕРїРѕР»РЅРµРЅРёСЏ Р±Р°Р»Р°РЅСЃР°: {e}")
            await send_or_edit_message_with_photo(callback, "вќЊ РџСЂРѕРёР·РѕС€Р»Р° РѕС€РёР±РєР°. РџРѕРїСЂРѕР±СѓР№С‚Рµ РїРѕР·Р¶Рµ.", edit_message=True, image_name="balance.png")
    else:
        await send_or_edit_message_with_photo(callback, "вќЊ РЎРёСЃС‚РµРјР° РЅРµРґРѕСЃС‚СѓРїРЅР°. РџРѕРїСЂРѕР±СѓР№С‚Рµ РїРѕР·Р¶Рµ.", edit_message=True, image_name="balance.png")

async def create_deposit_payment_from_message(message: Message, amount: float):
    """РЎРѕР·РґР°РЅРёРµ РїР»Р°С‚РµР¶Р° РґР»СЏ РїРѕРїРѕР»РЅРµРЅРёСЏ Р±Р°Р»Р°РЅСЃР° РёР· СЃРѕРѕР±С‰РµРЅРёСЏ"""
    user_id = message.from_user.id
    
    if DJANGO_INTEGRATION:
        try:
            # РЎРѕР·РґР°РµРј РїР»Р°С‚РµР¶ РґР»СЏ РїРѕРїРѕР»РЅРµРЅРёСЏ Р±Р°Р»Р°РЅСЃР°
            payment_data = await create_balance_payment(user_id, amount)
            
            if payment_data and payment_data.get('success'):
                payment_id = payment_data.get('payment_id')
                confirmation_url = payment_data.get('confirmation_url')
                
                success_text = f"""
вњ… <b>РџР»Р°С‚РµР¶ СЃРѕР·РґР°РЅ!</b>

рџ’° <b>РЎСѓРјРјР°:</b> {amount} в‚Ѕ
рџ†” <b>ID РїР»Р°С‚РµР¶Р°:</b> {payment_id}

рџ”— <b>РќР°Р¶РјРёС‚Рµ РєРЅРѕРїРєСѓ "РћРїР»Р°С‚РёС‚СЊ" РґР»СЏ РїРµСЂРµС…РѕРґР° Рє РѕРїР»Р°С‚Рµ</b>

<i>РџРѕСЃР»Рµ РѕРїР»Р°С‚С‹ РїР»Р°С‚РµР¶ Р±СѓРґРµС‚ РѕР±СЂР°Р±РѕС‚Р°РЅ Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРё</i>
"""
                
                kb = InlineKeyboardMarkup(inline_keyboard=[
                    [InlineKeyboardButton(text="рџ’і РћРїР»Р°С‚РёС‚СЊ", url=confirmation_url)],
                    [InlineKeyboardButton(text="рџ”„ РџСЂРѕРІРµСЂРёС‚СЊ СЃС‚Р°С‚СѓСЃ", callback_data=f"check_balance_payment_{payment_id}")],
                    [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
                ])
                
                await message.answer(success_text, parse_mode="HTML", reply_markup=kb)
                
                # РђРІС‚РѕРјР°С‚РёС‡РµСЃРєР°СЏ РїСЂРѕРІРµСЂРєР° РѕС‚РєР»СЋС‡РµРЅР° - РїРѕР»СЊР·РѕРІР°С‚РµР»СЊ РґРѕР»Р¶РµРЅ РЅР°Р¶Р°С‚СЊ РєРЅРѕРїРєСѓ "РџСЂРѕРІРµСЂРёС‚СЊ СЃС‚Р°С‚СѓСЃ"
                logging.info(f"РџР»Р°С‚РµР¶ {payment_id} СЃРѕР·РґР°РЅ РґР»СЏ РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ {user_id}, РѕР¶РёРґР°РµС‚СЃСЏ СЂСѓС‡РЅР°СЏ РїСЂРѕРІРµСЂРєР°")
            else:
                error_text = """
вќЊ <b>РћС€РёР±РєР° СЃРѕР·РґР°РЅРёСЏ РїР»Р°С‚РµР¶Р°</b>

рџ”§ <b>Р§С‚Рѕ РїСЂРѕРёСЃС…РѕРґРёС‚:</b>
вЂў Р’СЂРµРјРµРЅРЅР°СЏ РЅРµРґРѕСЃС‚СѓРїРЅРѕСЃС‚СЊ РїР»Р°С‚РµР¶РЅРѕР№ СЃРёСЃС‚РµРјС‹
вЂў РџРѕРїСЂРѕР±СѓР№С‚Рµ РїРѕР·Р¶Рµ

вЏ° <b>РџРѕРїСЂРѕР±СѓР№С‚Рµ С‡РµСЂРµР· РЅРµСЃРєРѕР»СЊРєРѕ РјРёРЅСѓС‚</b>
"""
                
                kb = InlineKeyboardMarkup(inline_keyboard=[
                    [InlineKeyboardButton(text="рџ”„ РџРѕРїСЂРѕР±РѕРІР°С‚СЊ СЃРЅРѕРІР°", callback_data="deposit_balance")],
                    [InlineKeyboardButton(text="в¬…пёЏ Р“Р»Р°РІРЅРѕРµ РјРµРЅСЋ", callback_data="main_menu")]
                ])
                
                await message.answer(error_text, parse_mode="HTML", reply_markup=kb)
                
        except Exception as e:
            logging.error(f"РћС€РёР±РєР° СЃРѕР·РґР°РЅРёСЏ РїР»Р°С‚РµР¶Р° РґР»СЏ РїРѕРїРѕР»РЅРµРЅРёСЏ Р±Р°Р»Р°РЅСЃР°: {e}")
            await message.answer("вќЊ РџСЂРѕРёР·РѕС€Р»Р° РѕС€РёР±РєР°. РџРѕРїСЂРѕР±СѓР№С‚Рµ РїРѕР·Р¶Рµ.")
    else:
        await message.answer("вќЊ РЎРёСЃС‚РµРјР° РЅРµРґРѕСЃС‚СѓРїРЅР°. РџРѕРїСЂРѕР±СѓР№С‚Рµ РїРѕР·Р¶Рµ.")

