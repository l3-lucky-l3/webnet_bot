# Telegram Bot настройки
BOT_TOKEN=your-telegram-bot-token-here
ADMIN_IDS=123456789,987654321

# ЮKassa
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_WEBHOOK_URL=https://your-domain.com/bot_management/webhook/yookassa/

# Remnawave API (Обычный VPN)
REMNAWAVE_BASE_URL=https://api.remnawave.com
REMNAWAVE_API_KEY=your-remnawave-api-key
REMNAWAVE_DEFAULT_SQUAD_UUID=your-squad-uuid

# Remnawave Bypass API (ОБХОД глушилок + VPN)
REMNAWAVE_BYPASS_BASE_URL=https://bypass.remnawave.com
REMNAWAVE_BYPASS_API_KEY=your-bypass-api-key
REMNAWAVE_BYPASS_DEFAULT_SQUAD_UUID=your-bypass-squad-uuid
REMNAWAVE_FAST_VPN_SQUAD_UUID=your-fast-vpn-squad-uuid

# Видео настройки
VIDEO_FILE_ID=your-video-file-id
VIDEO_URL=https://your-domain.com/video/
VIDEO_POST_URL=https://t.me/your-channel/123

# Операторы
OPERATORS=МТС, Билайн, Tele2, Yota

# Django настройки
SECRET_KEY=your-django-secret-key-change-this-in-production
DEBUG=False
